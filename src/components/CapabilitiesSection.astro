---
export interface Props {
  sectionTitle?: string;
  sectionSubtitle?: string;
  capabilities?: Array<{
    label: string;
    title: string;
    features: Array<{ icon: string; title: string; description: string }>;
    media: { type: 'video' | 'image'; src: string; poster?: string; alt?: string };
