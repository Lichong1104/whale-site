      {
        icon: 'https://whale-web.oss-cn-beijing.aliyuncs.com/2026-05-03/182680222.PNG',
        title: 'Space Analytics',
        description: 'SpaceSight tracks footfall, dwell time, queue length, and customer flow heatmaps across your locations.'
      },
      {
