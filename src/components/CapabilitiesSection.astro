];

const capabilities = capabilitiesProp ?? defaultCapabilities;
---

<section class="section" id="capabilities">
  <div class="container">
    <div class="section-head center">
      <h2 set:html={sectionTitle}></h2>
      <p>{sectionSubtitle}</p>
    </div>

    <div class="capabilities-tabs" id="capabilityTabs" role="tablist" aria-label="Product capabilities">
      {capabilities.map((cap, i) => (
        <button
          class={`capability-tab ${i === 0 ? 'active' : ''}`}
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`capability-pane-${i}`}
          data-index={i}
        >
          {cap.label}
        </button>
      ))}
    </div>

    <div class="capabilities-panes" id="capabilityPanes">
      {capabilities.map((cap, i) => (
        <div
          class={`capability-pane ${i === 0 ? 'active' : ''}`}
          id={`capability-pane-${i}`}
          role="tabpanel"
          data-index={i}
          hidden={i !== 0}
        >
          <h3 class="capability-pane-title" set:html={cap.title}></h3>
          <div class={`capability-layout ${cap.features.length === 0 ? 'capability-layout-media-only' : ''}`}>
            <div class="capability-copy">
              {cap.features.length > 0 && (
                <ul class="capability-list">
                  {cap.features.map(feature => (
                    <li class="capability-item">
                      <img class="capability-icon" src={feature.icon} alt="" width="40" height="40" loading="lazy">
                      <div class="capability-text">
                        <h4>{feature.title}</h4>
                        <p>{feature.description}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div class="capability-media">
              {cap.media.type === 'video' ? (
                <video autoplay muted loop playsinline preload="metadata" poster={cap.media.poster}>
                  <source src={cap.media.src} type="video/mp4">
                </video>
              ) : (
                <img src={cap.media.src} alt={cap.media.alt || ''} loading="lazy" decoding="async">
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    'use strict';

    const tabs = document.querySelectorAll('#capabilityTabs .capability-tab');
    const panes = document.querySelectorAll('#capabilityPanes .capability-pane');

    if (!tabs.length) return;

    function switchTab(index) {
      tabs.forEach((tab, i) => {
        const isActive = i === index;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panes.forEach((pane, i) => {
        const isActive = i === index;
        pane.classList.toggle('active', isActive);
        pane.hidden = !isActive;
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const index = parseInt(tab.getAttribute('data-index'), 10);
        switchTab(index);
      });
    });
  })();
</script>
