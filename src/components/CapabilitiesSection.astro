    }
  },
  {
    label: 'Ops Compliance',
    title: 'Fully Automated Ops Compliance <em>Without the Manual Work</em>',
    features: [
      {
        icon: 'https://whale-web.oss-cn-beijing.aliyuncs.com/2026-05-03/180878304.PNG',
