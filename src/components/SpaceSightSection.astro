---
---

<section class="section section-tint" id="products">
  <div class="container">
    <div class="section-head section-head-inline spacesight-section-head">
      <div>
        <div class="section-head-title-row">
          <div class="platform-icon spacesight-head-icon" aria-hidden="true"><img src="/product-logos/spacesight-logo.png" alt="SpaceSight" width="40" height="40" loading="eager"></div>
          <h2>SpaceSight</h2>
        </div>
        <p class="section-tagline">Real-time AI monitoring for every store in your network.</p>
      </div>
      <div class="section-head-icon spacesight-head-camera" aria-hidden="true">
        <img src="/camera.webp" alt="SpaceSight AI camera" class="spacesight-hero-image" width="320" height="240" loading="lazy">
      </div>
    </div>

    <div class="spacesight-features">
      <h3 class="spacesight-feature-title" id="spacesightFeatureTitle">Flags issues before they become losses</h3>
      <div class="spacesight-feature-tabs" role="tablist" aria-label="SpaceSight features">
        <button class="spacesight-feature-tab active" type="button" role="tab" aria-selected="true" data-index="0" data-title="Flags issues before they become losses">Compliance &amp; Inspection</button>
        <button class="spacesight-feature-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-index="1" data-title="Full visibility across every store, 24/7">AI Operations Agent</button>
        <button class="spacesight-feature-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-index="2" data-title="Connects to your existing cameras">Flexible Deployment</button>
      </div>
    </div>

    <div class="spacesight-carousel" role="region" aria-roledescription="carousel" aria-label="SpaceSight capabilities">
      <button class="spacesight-carousel-btn spacesight-carousel-prev" type="button" aria-label="Previous SpaceSight capability" aria-controls="spacesightCarouselTrack">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="spacesight-carousel-btn spacesight-carousel-next" type="button" aria-label="Next SpaceSight capability" aria-controls="spacesightCarouselTrack">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <div class="spacesight-carousel-track-wrapper">
        <div class="spacesight-carousel-track" id="spacesightCarouselTrack">
          <article class="platform-card platform-card-spacesight spacesight-carousel-slide" role="group" aria-roledescription="slide" aria-label="1 of 3">
            <div class="platform-card-body">
              <h3>Compliance &amp; Inspection</h3>
              <p class="platform-card-lead">Stop auditing manually. Start auditing continuously.</p>
              <ul class="feature-list">
                <li>AI monitoring across every zone, every location</li>
                <li>Inspections that took 40 minutes now take 2</li>
                <li>Compliance gaps surface before they become incidents</li>
                <li>Hazard and non-compliance detection: +300%</li>
              </ul>
              <a href="/whale_spacesight/" target="_blank" rel="noopener noreferrer" class="btn btn-light">Learn more</a>
            </div>
            <div class="platform-visual">
              <video class="spacesight-slide-video" src="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-05-06/071150201.mp4" poster="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-06-02/161484576.png" muted loop playsinline preload="metadata" aria-label="Compliance and inspection demo"></video>
            </div>
          </article>

          <article class="platform-card platform-card-spacesight spacesight-carousel-slide" role="group" aria-roledescription="slide" aria-label="2 of 3">
            <div class="platform-card-body">
              <h3>AI Operations Agent</h3>
              <p class="platform-card-lead">One question. Full business loop.</p>
              <ul class="feature-list">
                <li>Ask SpaceClaw natural language questions</li>
                <li>Finds footage, identifies cause, generates work order</li>
                <li>Pushes to the right person automatically</li>
                <li>AI recommendation adoption rate: 70%+</li>
              </ul>
              <a href="/whale_spacesight/" target="_blank" rel="noopener noreferrer" class="btn btn-light">Learn more</a>
            </div>
            <div class="platform-visual">
              <video class="spacesight-slide-video" src="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-05-06/065298529.mp4" poster="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-06-02/161484576.png" muted loop playsinline preload="metadata" aria-label="AI operations agent demo"></video>
            </div>
          </article>

          <article class="platform-card platform-card-spacesight spacesight-carousel-slide" role="group" aria-roledescription="slide" aria-label="3 of 3">
            <div class="platform-card-body">
              <h3>Flexible Deployment</h3>
              <p class="platform-card-lead">Works with what you have. Ready for what you need.</p>
              <ul class="feature-list">
                <li>New installation with AI cameras</li>
                <li>Connect existing cameras via AI Hub</li>
                <li>Plug-and-play Whale Owl edge AI</li>
                <li>Operational in minutes, not months</li>
              </ul>
              <a href="/whale_spacesight/" target="_blank" rel="noopener noreferrer" class="btn btn-light">Learn more</a>
            </div>
            <div class="platform-visual">
              <video class="spacesight-slide-video" src="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-05-06/071150201.mp4" poster="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-06-02/161484576.png" muted loop playsinline preload="metadata" aria-label="Flexible deployment demo"></video>
            </div>
          </article>
        </div>
      </div>

      <div class="spacesight-carousel-dots" id="spacesightCarouselDots" role="tablist" aria-label="SpaceSight slides"></div>
    </div>

    </div>
  </section>

<style>
  .spacesight-features {
    margin-bottom: var(--space-lg);
    text-align: center;
  }
  .spacesight-feature-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 var(--space-md);
    min-height: 1.3em;
  }
  .spacesight-feature-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    background: var(--bg-elevated);
    padding: 0.375rem;
    border-radius: var(--radius);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  .spacesight-feature-tab {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.6rem 1rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .spacesight-feature-tab:hover {
    color: var(--text);
    background: rgba(15, 23, 42, 0.04);
  }
  .spacesight-feature-tab.active {
    color: #fff;
    background: linear-gradient(135deg, #2563EB 0%, #06B6D4 100%);
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
  }
  @media (max-width: 720px) {
    .spacesight-feature-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    .spacesight-feature-tab {
      padding: 0.55rem 0.5rem;
      font-size: 0.85rem;
    }
  }

  .spacesight-section-head {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    max-width: 900px;
    margin-inline: auto;
  }

  /* Head camera image (moved from carousel card) */
  .spacesight-head-camera {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .spacesight-hero-image {
    width: 100%;
    height: auto;
    max-height: 240px;
    object-fit: contain;
    object-position: center;
    border-radius: var(--radius);
    mix-blend-mode: multiply;
  }

  /* Carousel card video / image */
  .spacesight-slide-video,
  .spacesight-slide-image {
    width: 100%;
    height: 100%;
    max-height: 360px;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }
  @media (max-width: 720px) {
    .spacesight-section-head {
      grid-template-columns: 1fr;
    }
    .spacesight-head-camera {
      max-width: 100%;
      margin: 0 auto var(--space-md);
    }
    .spacesight-hero-image {
      max-height: 150px;
    }
    .spacesight-slide-video,
    .spacesight-slide-image {
      max-height: 240px;
    }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    const stage = document.getElementById('spacesightStage');
    const particlesContainer = document.getElementById('spacesightParticles');
    const cameraCard = document.getElementById('spacesightCameraCard');
    const cameraBody = document.getElementById('spacesightCameraBody');
    const cameraImg = document.getElementById('spacesightCameraImg');
    const lensRing = document.getElementById('spacesightLensRing');
    const scanline = document.getElementById('spacesightScanline');

    if (!stage || typeof anime === 'undefined') return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Create floating particles
    const particleCount = 20;
    for (let i = 0; i < particleCount; i++) {
      const p = document.createElement('div');
      p.className = 'cta-particle';
      const size = anime.random(3, 7);
      p.style.width = `${size}px`;
      p.style.height = `${size}px`;
      p.style.left = `${anime.random(0, 100)}%`;
      p.style.top = `${anime.random(0, 100)}%`;
      p.style.background = i % 3 === 0 ? '#7c3aed' : '#06b6d4';
      particlesContainer.appendChild(p);
    }

    // UTC clock
    function updateClock() {
      const now = new Date();
      const h = String(now.getUTCHours()).padStart(2, '0');
      const m = String(now.getUTCMinutes()).padStart(2, '0');
      const s = String(now.getUTCSeconds()).padStart(2, '0');
      const span = document.querySelector('#spacesightMetaValue span');
      if (span) span.textContent = `${h}:${m}:${s}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    function playIntro() {
      const tl = anime.createTimeline({ defaults: { ease: 'outExpo' } });

      tl.add('#spacesightGlow1', {
        opacity: [0, 0.8],
        scale: [0.6, 1],
        duration: 1600
      }, 200);

      tl.add('#spacesightGlow2', {
        opacity: [0, 0.6],
        scale: [0.5, 1.2],
        duration: 1600
      }, 400);

      tl.add('#spacesightCameraCard', {
        opacity: [0, 1],
        rotateX: [35, 0],
        rotateY: [-18, 0],
        translateY: [120, 0],
        scale: [0.82, 1],
        duration: 1400,
        ease: 'spring(1, 80, 12, 0)'
      }, 400);

      tl.add('.cta-corner', {
        opacity: [0, 1],
        scale: [0, 1],
        duration: 600,
        delay: anime.stagger(80, { grid: [2, 2], from: 'center' }),
        ease: 'outBack'
      }, '-=900');

      tl.add('#spacesightStatusDot', {
        opacity: [0, 1],
        scale: [0, 1.4, 1],
        duration: 800,
        ease: 'outElastic(1, .6)'
      }, '-=600');

      tl.add('#spacesightCameraImg', {
        opacity: [0, 1],
        scale: [1.25, 1.05],
        filter: ['blur(16px) brightness(0.6)', 'blur(0px) brightness(0.92)'],
        duration: 1400,
        ease: 'outQuart'
      }, '-=1100');

      tl.add('#spacesightLensRing', {
        opacity: [0, 1],
        scale: [0.2, 1],
        rotate: [-90, 0],
        duration: 1200,
        ease: 'spring(1, 70, 10, 0)'
      }, '-=800');

      tl.add('#spacesightScanline', {
        opacity: [0, 1, 0],
        top: ['0%', '100%'],
        duration: 1400,
        ease: 'inOutExpo'
      }, '-=1000');

      tl.add(['#spacesightMetaLabel', '#spacesightMetaValue'], {
        opacity: [0, 1],
        translateY: [10, 0],
        duration: 800,
        delay: anime.stagger(120),
        ease: 'outQuad'
      }, '-=600');

      tl.add('.cta-floating-tag', {
        opacity: [0, 1],
        translateY: [30, 0],
        translateX: anime.stagger([-12, 12]),
        duration: 900,
        delay: anime.stagger(100, { from: 'center' }),
        ease: 'outBack'
      }, '-=900');

      tl.add('.cta-particle', {
        opacity: [0, anime.random(0.3, 0.7)],
        scale: [0, 1],
        duration: 1200,
        delay: anime.stagger(40),
        ease: 'outQuad'
      }, '-=1200');

      return tl;
    }

    function startAmbient() {
      anime.animate(['#spacesightGlow1', '#spacesightGlow2'], {
        scale: [1, 1.15],
        opacity: [0.6, 0.9],
        duration: 4000,
        loop: true,
        alternate: true,
        ease: 'inOutQuad',
        delay: anime.stagger(600)
      });

      anime.animate('#spacesightStatusDot', {
        scale: [1, 1.5],
        opacity: [1, 0.6],
        duration: 1200,
        loop: true,
        alternate: true,
        ease: 'inOutSine'
      });

      anime.animate('.cta-particle', {
        translateY: anime.stagger([-40, 40]),
        translateX: anime.stagger([-30, 30]),
        opacity: anime.stagger([0.2, 0.8]),
        duration: () => anime.random(6000, 12000),
        loop: true,
        alternate: true,
        ease: 'inOutSine',
        delay: anime.stagger(200)
      });
    }

    function bindParallax() {
      stage.addEventListener('mousemove', (e) => {
        const rect = stage.getBoundingClientRect();
        const cx = rect.width / 2;
        const cy = rect.height / 2;
        const dx = (e.clientX - rect.left - cx) / cx;
        const dy = (e.clientY - rect.top - cy) / cy;

        anime.set(cameraCard, {
          rotateY: dx * 8,
          rotateX: -dy * 6
        });

        anime.set(cameraBody, {
          rotateY: dx * 4,
          rotateX: -dy * 3
        });

        anime.set(cameraImg, {
          translateX: dx * -10,
          translateY: dy * -10
        });

        anime.set(lensRing, {
          translateX: dx * 35,
          translateY: dy * 35,
          rotateX: -dy * 28,
          rotateY: dx * 28,
          rotateZ: dx * 12
        });
      });

      stage.addEventListener('mouseleave', () => {
        anime.animate([cameraCard, cameraBody, cameraImg, lensRing], {
          rotateX: 0,
          rotateY: 0,
          rotateZ: 0,
          translateX: 0,
          translateY: 0,
          duration: 600,
          ease: 'outQuad'
        });
      });
    }

    function bindFlash() {
      cameraBody.addEventListener('click', () => {
        anime.animate(scanline, {
          opacity: [0, 1, 0],
          top: ['0%', '100%'],
          duration: 1000,
          ease: 'inOutExpo'
        });

        anime.animate(lensRing, {
          scale: [1, 1.3, 1],
          borderColor: ['rgba(6,182,212,0.4)', 'rgba(255,255,255,0.9)', 'rgba(6,182,212,0.4)'],
          boxShadow: [
            '0 0 30px rgba(6,182,212,0.3), 0 0 60px rgba(6,182,212,0.15) inset',
            '0 0 80px rgba(255,255,255,0.6), 0 0 120px rgba(255,255,255,0.3) inset',
            '0 0 30px rgba(6,182,212,0.3), 0 0 60px rgba(6,182,212,0.15) inset'
          ],
          duration: 900,
          ease: 'outExpo'
        });
      });
    }

    function init() {
      if (prefersReducedMotion) {
        document.querySelectorAll('.cta-glow, .cta-camera-card, .cta-corner, .cta-status-dot, .cta-lens-ring, .cta-scanline, .cta-meta-label, .cta-meta-value, .cta-floating-tag, .cta-particle').forEach(el => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
        return;
      }

      playIntro().then(startAmbient);
      bindParallax();
      bindFlash();
    }

    // Start animation as soon as the DOM is ready so the stage renders
    // even when captured below the fold or with reduced-motion fallbacks.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
