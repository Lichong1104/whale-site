---
---

<section class="section section-tint how-it-works" id="products">
  <div class="container">
    <div class="section-head center">
      <h2>How it works</h2>
      <p>Data alone doesn't drive decisions. <span class="hl-understanding">Understanding</span> does.</p>
    </div>

    <div class="solution-panels">
      <div class="solution-panel" data-panel="spacesight" tabindex="0" role="button" aria-label="SpaceSight card — activate to watch the demo">
        <div class="solution-flip">
          <div class="solution-face solution-front">
            <span class="solution-chip solution-chip-spacesight">SpaceSight · Sees</span>
            <p class="solution-word"><span class="hl-vision">SpaceSight</span> monitors your operations in <span class="hl-vision">real time</span>.</p>
            <span class="solution-hint">Hover or tap to watch</span>
          </div>
          <div class="solution-face solution-back">
            <video src="/hero/spacesight-sees.mp4" poster="/hero/spacesight-sees-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="SpaceSight monitoring demo"></video>
          </div>
        </div>
      </div>

      <div class="solution-panel" data-panel="echo" tabindex="0" role="button" aria-label="Echo card — activate to watch the demo">
        <div class="solution-flip">
          <div class="solution-face solution-front">
            <span class="solution-chip solution-chip-echo">Echo · Hears</span>
            <p class="solution-word"><span class="hl-voice">Echo</span> captures the <span class="hl-voice">communication</span> around it.</p>
            <span class="solution-hint">Hover or tap to watch</span>
          </div>
          <div class="solution-face solution-back">
            <video src="/hero/echo-hears.mp4" poster="/hero/echo-hears-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="Echo voice capture demo"></video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-it-works .section-head h2 {
    max-width: none;
  }

  .how-it-works .section-head p {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text);
    text-wrap: balance;
  }

  /* Fusion magenta, darkened for light ground — same hue as the merge finale */
  .hl-understanding {
    color: #DB2777;
  }

  .solution-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    max-width: 1100px;
    margin-inline: auto;
  }

  .solution-panel {
    perspective: 1400px;
    border-radius: var(--radius);
    cursor: pointer;
    outline: none;
  }

  .solution-panel:focus-visible {
    outline: 3px solid #00E5FF;
    outline-offset: 3px;
  }

  .solution-flip {
    position: relative;
    aspect-ratio: 16 / 10;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.3, 0.7, 0.25, 1);
  }

  .solution-panel:hover .solution-flip,
  .solution-panel:focus-visible .solution-flip,
  .solution-panel.is-flipped .solution-flip {
    transform: rotateY(180deg);
  }

  .solution-face {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Front: text card on detector ink, product-colored orbital rings */
  .solution-front {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    text-align: center;
    padding: var(--space-md);
    background: var(--bg-dark, #0B1020);
    border: 1px solid rgba(248, 247, 244, 0.08);
  }

  .solution-front::before,
  .solution-front::after {
    content: '';
    position: absolute;
    border-radius: 999px;
    border: 1.5px solid var(--panel-ring);
    pointer-events: none;
  }

  .solution-front::before {
    top: -90px;
    right: -90px;
    width: 220px;
    height: 220px;
  }

  .solution-front::after {
    top: -44px;
    right: -44px;
    width: 128px;
    height: 128px;
    opacity: 0.55;
  }

  [data-panel="spacesight"] .solution-front { --panel-ring: rgba(255, 210, 63, 0.35); }
  [data-panel="echo"] .solution-front { --panel-ring: rgba(0, 229, 255, 0.4); }

  .solution-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F8F7F4;
    background: rgba(248, 247, 244, 0.06);
    border: 1px solid rgba(248, 247, 244, 0.12);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
  }

  .solution-chip::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
  }

  .solution-chip-spacesight::before { background: #FFD23F; }
  .solution-chip-echo::before { background: #00E5FF; }

  .solution-word {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 24ch;
    color: #F8F7F4;
    margin: 0;
  }

  .hl-vision { color: #FFD23F; }
  .hl-voice { color: #00E5FF; }

  .solution-hint {
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.4);
  }

  /* Back: video */
  .solution-back {
    transform: rotateY(180deg);
    background: var(--bg-dark, #0B1020);
  }

  .solution-back video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  [data-panel="spacesight"] .solution-back {
    box-shadow: inset 0 0 0 1px rgba(255, 210, 63, 0.5);
  }

  [data-panel="echo"] .solution-back {
    box-shadow: inset 0 0 0 1px rgba(0, 229, 255, 0.5);
  }

  @media (max-width: 720px) {
    .solution-panels {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-flip {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    /* Touch + keyboard flip (hover/focus handled in CSS) */
    document.querySelectorAll('.solution-panel').forEach((panel) => {
      panel.addEventListener('click', () => {
        panel.classList.toggle('is-flipped');
      });

      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          panel.classList.toggle('is-flipped');
        }
      });
    });
  })();
</script>
