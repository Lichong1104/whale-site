---

<section class="hero" id="hero">
  <canvas id="detector" aria-label="Interactive particle detector showing vision, voice, and sensor tracks"></canvas>
  <div class="hero-overlay">
    <h1 class="hero-shimmer">Whale AI | Physical Intelligence for Enterprise Operations</h1>
    <p class="hero-lead">Cameras, voice, and AI agents that audit compliance, coach teams, and improve every customer interaction across your locations.</p>
    <div class="hero-actions">
      <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="官网立即咨询留资">Request a demo</button>
      <a href="#products" class="btn btn-ghost btn-large">Explore products</a>
    </div>
    <div class="track-legend">
      <button class="track-item" data-track="vision" type="button" aria-pressed="false"><span class="track-dot" style="--track-color: #FFD23F"></span> 95% Data Accuracy</button>
      <button class="track-item" data-track="voice" type="button" aria-pressed="false"><span class="track-dot" style="--track-color: #00E5FF"></span> +30% Audit Efficiency</button>
      <button class="track-item" data-track="sensor" type="button" aria-pressed="false"><span class="track-dot" style="--track-color: #FF4D8D"></span> 1600+ Countries Deployed</button>
    </div>
  </div>
</section>
