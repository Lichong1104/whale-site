<section class="section" id="integrated-platform">
  <div class="container">
    <div class="section-head center">
      <h2>One integrated platform</h2>
      <p>Control your entire physical operations from Whale, the AI layer that connects cameras, voice, and agents into one real-time management platform.</p>
    </div>

    <div class="integrated-platform-visual">
      <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2025-10-15/182699028.gif" alt="Whale integrated platform showing live camera feeds, AI annotations, and operational dashboards" loading="lazy" decoding="async">
    </div>

    <div class="platform-grid integrated-products-grid">
      <a href="https://echo.meetwhale.ai/" target="_blank" rel="noopener noreferrer" class="platform-card product-echo" role="group" aria-label="Echo product">
        <div class="platform-card-header">
          <div class="platform-icon" aria-hidden="true"><img src="/product-logos/echo-logo.png" alt="Echo" width="40" height="40" loading="lazy"></div>
          <h3>Echo</h3>
        </div>
        <p>Voice Intelligence Platform for Enterprise. 100% conversation capture, 30+ languages, Echo wearables, and conversation analytics.</p>
        <div class="tags">
          <span class="tag">ASR</span>
          <span class="tag">30+ Lang</span>
          <span class="tag">Wearables</span>
        </div>
      </a>

      <div class="platform-card product-alivia" role="group" aria-label="Alivia product">
        <div class="platform-card-header">
          <div class="platform-icon" aria-hidden="true"><img src="/product-logos/alivia-logo.png" alt="Alivia" width="40" height="40" loading="lazy"></div>
          <h3>Alivia</h3>
        </div>
        <p>Your AI Assistant Behind Every Workflow. Model and agent orchestration, WhaleClaw architecture, AI training, and workflow studio.</p>
        <div class="tags">
          <span class="tag">Agents</span>
          <span class="tag">Orchestration</span>
          <span class="tag">Workflows</span>
        </div>
      </div>
    </div>
  </div>
</section>
