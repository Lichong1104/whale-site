---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  lastUpdated: string;
  headings: Array<{ id: string; text: string }>;
}

const { title, description, canonical, lastUpdated, headings } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical}>
  <Header />
  <main>
    <section class="section section-tint legal-hero">
      <div class="container legal-hero-container">
        <div class="section-head center legal-hero-head">
          <h1>{title}</h1>
          <p class="legal-last-updated">Last updated: {lastUpdated}</p>
        </div>
      </div>
    </section>

    <section class="section legal-body">
      <div class="container legal-body-container">
        <aside class="legal-toc">
          <nav aria-label="Page sections">
            <h2>Contents</h2>
            <ul>
              {
                headings.map((h) => (
                  <li>
                    <a href={`#${h.id}`}>{h.text}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </aside>

        <article class="legal-article">
          <slot />
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
