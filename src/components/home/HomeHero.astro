---
---

<section class="home-hero" id="home-hero">
  <div class="home-hero-bg" aria-hidden="true">
    <picture>
      <source srcset="/home-assets/hero-bg.webp" type="image/webp">
      <img src="/home-assets/hero-bg.png" alt="" width="1920" height="1080" loading="eager" decoding="async">
    </picture>
  </div>
  <img class="home-hero-decor" src="/home-assets/hero-decor.png" alt="" width="120" height="120" loading="eager" decoding="async" aria-hidden="true">
  <div class="home-hero-grid">
    <div class="home-hero-copy">
      <h1>World Model for Commercial Intelligence.</h1>
      <p class="home-hero-lead">
        AI that sees beyond the lens, turning real-world activity into meaningful insights for better business decisions.
      </p>
      <div class="home-hero-actions">
        <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="官网首页Hero预约演示">Book a demo</button>
        <a href="/products/" class="btn btn-ghost btn-large">Explore products</a>
      </div>
    </div>
    <div class="home-hero-media">
      <img src="/home-assets/hero-collage.webp" alt="Whale AI spatial intelligence dashboard" width="1200" height="660" loading="eager" decoding="async">
    </div>
  </div>
</section>
