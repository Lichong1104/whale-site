---
---

<section class="section" id="hardware">
  <div class="container">
    <div class="section-head center">
      <h2>Hardware</h2>
      <p>Purpose-built AI devices that connect seamlessly to the Whale platform — from cameras and hubs to voice wearables.</p>
    </div>

    <div class="platform-grid hardware-grid">
      <article class="platform-card hardware-card" role="group" aria-label="AI Cameras">
        <div class="platform-card-header">
          <div class="platform-icon" aria-hidden="true">
            <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2025-09-02/144346985.PNG" alt="" width="40" height="40" loading="lazy">
          </div>
          <h3>AI Cameras</h3>
        </div>
        <div class="tags">
          <span class="tag">Plug-and-play</span>
          <span class="tag">Edge AI</span>
          <span class="tag">Multi-scenario</span>
        </div>
        <div class="platform-visual hardware-visual">
          <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-06-03/071445564.png" alt="Whale Owl AI camera" loading="lazy" decoding="async">
        </div>
      </article>

      <article class="platform-card hardware-card" role="group" aria-label="AI Hubs">
        <div class="platform-card-header">
          <div class="platform-icon" aria-hidden="true">
            <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2025-09-02/144848631.png" alt="" width="40" height="40" loading="lazy">
          </div>
          <h3>AI Hubs</h3>
        </div>
        <div class="tags">
          <span class="tag">Preserve infrastructure</span>
          <span class="tag">Edge-cloud</span>
          <span class="tag">Scalable</span>
        </div>
        <div class="platform-visual hardware-visual">
          <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2025-09-18/164938569.png" alt="AI Hub V2" loading="lazy" decoding="async">
        </div>
      </article>

      <article class="platform-card hardware-card" role="group" aria-label="Echo Pins">
        <div class="platform-card-header">
          <div class="platform-icon" aria-hidden="true">
            <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2025-09-19/163472678.png" alt="" width="40" height="40" loading="lazy">
          </div>
          <h3>Echo Pins</h3>
        </div>
        <div class="tags">
          <span class="tag">Voice capture</span>
          <span class="tag">Bluetooth streaming</span>
          <span class="tag">10+ hour battery</span>
        </div>
        <div class="platform-visual hardware-visual">
          <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2025-09-18/145798896.png" alt="Echo Pro voice badge" loading="lazy" decoding="async">
        </div>
      </article>

      <article class="platform-card hardware-card" role="group" aria-label="Echo Pods">
        <div class="platform-card-header">
          <div class="platform-icon" aria-hidden="true">
            <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-07-24/041949696.png" alt="" width="40" height="40" loading="lazy">
          </div>
          <h3>Echo Pods</h3>
        </div>
        <div class="tags">
          <span class="tag">Bluetooth 6.0</span>
          <span class="tag">60H battery</span>
          <span class="tag">AI noise cancellation</span>
        </div>
        <div class="platform-visual hardware-visual">
          <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2026-07-24/041553291.png" alt="Echo Pods earbuds" loading="lazy" decoding="async">
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .hardware-card {
    gap: var(--space-xs);
  }

  .hardware-visual {
    aspect-ratio: 16 / 10;
    background: var(--bg-tint);
    margin-top: var(--space-sm);
  }

  .hardware-visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-sm);
  }

  @media (min-width: 840px) {
    .hardware-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 1100px) and (min-width: 841px) {
    .hardware-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
