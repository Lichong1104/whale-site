---
export interface Props {
  headline?: string;
  lead?: string;
  primaryLabel?: string;
  sourceType?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  headline = 'Never miss what matters,<br>or wonder what it means.',
  lead = 'Find out how space intelligence can power your operations forward.',
  primaryLabel = 'Request a Demo',
  sourceType = '官网立即咨询留资',
  secondaryLabel,
  secondaryHref
} = Astro.props;
---

<section class="section section-dark cta-section" id="contact">
  <div class="container cta-container">
    <div class="cta-layout">
      <div class="cta-copy">
        <h2 set:html={headline}></h2>
        <p class="cta-lead">{lead}</p>
        <div class="cta-actions">
          <button
            type="button"
            class="btn btn-primary btn-large"
            data-open-modal
            data-source-type={sourceType}
          >
            {primaryLabel}
          </button>
          {secondaryLabel && secondaryHref && (
            <a href={secondaryHref} class="btn btn-ghost btn-large">{secondaryLabel}</a>
          )}
        </div>
      </div>
      <div class="cta-visual" aria-label="Smart camera live feed visualization">
        <div class="cta-stage" id="ctaStage">
          <div class="cta-grid" id="ctaGrid"></div>
          <div class="cta-glow" id="ctaGlow1"></div>
          <div class="cta-glow cta-glow-cyan" id="ctaGlow2"></div>

          <div class="cta-camera-card" id="ctaCameraCard">
            <div class="cta-corner cta-corner-tl"></div>
            <div class="cta-corner cta-corner-tr"></div>
            <div class="cta-corner cta-corner-bl"></div>
            <div class="cta-corner cta-corner-br"></div>

            <div class="cta-camera-header">
              <div class="cta-status-dot" id="ctaStatusDot"></div>
            </div>

            <div class="cta-camera-body" id="ctaCameraBody">
              <img class="cta-camera-img" id="ctaCameraImg" src="/camera.webp" alt="Security Camera" loading="lazy" decoding="async">
              <div class="cta-lens-ring" id="ctaLensRing"></div>
              <div class="cta-scanline" id="ctaScanline"></div>
            </div>

            <div class="cta-camera-meta">
              <div class="cta-meta-label" id="ctaMetaLabel">Live Feed</div>
              <div class="cta-meta-value" id="ctaMetaValue"><span>00:00:00</span> UTC</div>
            </div>
          </div>

          <div id="ctaParticles"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    'use strict';

    const stage = document.getElementById('ctaStage');
    const particlesContainer = document.getElementById('ctaParticles');
    const cameraCard = document.getElementById('ctaCameraCard');
    const cameraBody = document.getElementById('ctaCameraBody');
    const cameraImg = document.getElementById('ctaCameraImg');
    const lensRing = document.getElementById('ctaLensRing');
    const scanline = document.getElementById('ctaScanline');

    if (!stage || typeof anime === 'undefined') return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Create floating particles
    const particleCount = 20;
    for (let i = 0; i < particleCount; i++) {
      const p = document.createElement('div');
      p.className = 'cta-particle';
      const size = anime.random(3, 7);
      p.style.width = `${size}px`;
      p.style.height = `${size}px`;
      p.style.left = `${anime.random(0, 100)}%`;
      p.style.top = `${anime.random(0, 100)}%`;
      p.style.background = i % 3 === 0 ? '#7c3aed' : '#06b6d4';
      particlesContainer.appendChild(p);
    }

    // UTC clock
    function updateClock() {
      const now = new Date();
      const h = String(now.getUTCHours()).padStart(2, '0');
      const m = String(now.getUTCMinutes()).padStart(2, '0');
      const s = String(now.getUTCSeconds()).padStart(2, '0');
      const span = document.querySelector('#ctaMetaValue span');
      if (span) span.textContent = `${h}:${m}:${s}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    function playIntro() {
      const tl = anime.createTimeline({ defaults: { ease: 'outExpo' } });

      tl.add('#ctaGrid', {
        opacity: [0, 1],
        scale: [1.15, 1],
        duration: 1800
      }, 0);

      tl.add('#ctaGlow1', {
        opacity: [0, 0.8],
        scale: [0.6, 1],
        duration: 1600
      }, 200);

      tl.add('#ctaGlow2', {
        opacity: [0, 0.6],
        scale: [0.5, 1.2],
        duration: 1600
      }, 400);

      tl.add('#ctaCameraCard', {
        opacity: [0, 1],
        rotateX: [35, 0],
        rotateY: [-18, 0],
        translateY: [120, 0],
        scale: [0.82, 1],
        duration: 1400,
        ease: 'spring(1, 80, 12, 0)'
      }, 400);

      tl.add('.cta-corner', {
        opacity: [0, 1],
        scale: [0, 1],
        duration: 600,
        delay: anime.stagger(80, { grid: [2, 2], from: 'center' }),
        ease: 'outBack'
      }, '-=900');

      tl.add('#ctaStatusDot', {
        opacity: [0, 1],
        scale: [0, 1.4, 1],
        duration: 800,
        ease: 'outElastic(1, .6)'
      }, '-=600');

      tl.add('#ctaCameraImg', {
        opacity: [0, 1],
        scale: [1.25, 1.05],
        filter: ['blur(16px) brightness(0.6)', 'blur(0px) brightness(0.92)'],
        duration: 1400,
        ease: 'outQuart'
      }, '-=1100');

      tl.add('#ctaLensRing', {
        opacity: [0, 1],
        scale: [0.2, 1],
        rotate: [-90, 0],
        duration: 1200,
        ease: 'spring(1, 70, 10, 0)'
      }, '-=800');

      tl.add('#ctaScanline', {
        opacity: [0, 1, 0],
        top: ['0%', '100%'],
        duration: 1400,
        ease: 'inOutExpo'
      }, '-=1000');

      tl.add(['#ctaMetaLabel', '#ctaMetaValue'], {
        opacity: [0, 1],
        translateY: [10, 0],
        duration: 800,
        delay: anime.stagger(120),
        ease: 'outQuad'
      }, '-=600');

      tl.add('.cta-floating-tag', {
        opacity: [0, 1],
        translateY: [30, 0],
        translateX: anime.stagger([-12, 12]),
        duration: 900,
        delay: anime.stagger(100, { from: 'center' }),
        ease: 'outBack'
      }, '-=900');

      tl.add('.cta-particle', {
        opacity: [0, anime.random(0.3, 0.7)],
        scale: [0, 1],
        duration: 1200,
        delay: anime.stagger(40),
        ease: 'outQuad'
      }, '-=1200');

      return tl;
    }

    function startAmbient() {
      anime.animate('#ctaGrid', {
        translateY: [-20, 20],
        rotateX: [58, 62],
        duration: 12000,
        loop: true,
        alternate: true,
        ease: 'inOutSine'
      });

      anime.animate(['#ctaGlow1', '#ctaGlow2'], {
        scale: [1, 1.15],
        opacity: [0.6, 0.9],
        duration: 4000,
        loop: true,
        alternate: true,
        ease: 'inOutQuad',
        delay: anime.stagger(600)
      });

      anime.animate('#ctaStatusDot', {
        scale: [1, 1.5],
        opacity: [1, 0.6],
        duration: 1200,
        loop: true,
        alternate: true,
        ease: 'inOutSine'
      });

      anime.animate('.cta-particle', {
        translateY: anime.stagger([-40, 40]),
        translateX: anime.stagger([-30, 30]),
        opacity: anime.stagger([0.2, 0.8]),
        duration: () => anime.random(6000, 12000),
        loop: true,
        alternate: true,
        ease: 'inOutSine',
        delay: anime.stagger(200)
      });
    }

    function bindParallax() {
      stage.addEventListener('mousemove', (e) => {
        const rect = stage.getBoundingClientRect();
        const cx = rect.width / 2;
        const cy = rect.height / 2;
        const dx = (e.clientX - rect.left - cx) / cx;
        const dy = (e.clientY - rect.top - cy) / cy;

        anime.set(cameraCard, {
          rotateY: dx * 8,
          rotateX: -dy * 6
        });

        anime.set(cameraBody, {
          rotateY: dx * 4,
          rotateX: -dy * 3
        });

        anime.set(cameraImg, {
          translateX: dx * -10,
          translateY: dy * -10
        });

        anime.set(lensRing, {
          translateX: dx * 35,
          translateY: dy * 35,
          rotateX: -dy * 28,
          rotateY: dx * 28,
          rotateZ: dx * 12
        });
      });

      stage.addEventListener('mouseleave', () => {
        anime.animate([cameraCard, cameraBody, cameraImg, lensRing], {
          rotateX: 0,
          rotateY: 0,
          rotateZ: 0,
          translateX: 0,
          translateY: 0,
          duration: 600,
          ease: 'outQuad'
        });
      });
    }

    function bindFlash() {
      cameraBody.addEventListener('click', () => {
        anime.animate(scanline, {
          opacity: [0, 1, 0],
          top: ['0%', '100%'],
          duration: 1000,
          ease: 'inOutExpo'
        });

        anime.animate(lensRing, {
          scale: [1, 1.3, 1],
          borderColor: ['rgba(6,182,212,0.4)', 'rgba(255,255,255,0.9)', 'rgba(6,182,212,0.4)'],
          boxShadow: [
            '0 0 30px rgba(6,182,212,0.3), 0 0 60px rgba(6,182,212,0.15) inset',
            '0 0 80px rgba(255,255,255,0.6), 0 0 120px rgba(255,255,255,0.3) inset',
            '0 0 30px rgba(6,182,212,0.3), 0 0 60px rgba(6,182,212,0.15) inset'
          ],
          duration: 900,
          ease: 'outExpo'
        });
      });
    }

    function init() {
      if (prefersReducedMotion) {
        document.querySelectorAll('.cta-grid, .cta-glow, .cta-camera-card, .cta-corner, .cta-status-dot, .cta-lens-ring, .cta-scanline, .cta-meta-label, .cta-meta-value, .cta-floating-tag, .cta-particle').forEach(el => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
        return;
      }

      playIntro().then(startAmbient);
      bindParallax();
      bindFlash();
    }

    // Start when the CTA section scrolls into view
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          init();
          observer.disconnect();
        }
      });
    }, { threshold: 0.2 });

    observer.observe(stage);
  })();
</script>
