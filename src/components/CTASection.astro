---
export interface Props {
  headline?: string;
  lead?: string;
  primaryLabel?: string;
  sourceType?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  headline = 'Never miss what matters,<br>or wonder what it means.',
  lead = 'Find out how space intelligence can power your operations forward.',
  primaryLabel = 'Request a Demo',
  sourceType = '官网立即咨询留资',
  secondaryLabel,
  secondaryHref
} = Astro.props;
---

<section class="section section-dark cta-section" id="contact">
  <div class="container cta-container">
    <div class="cta-layout">
      <div class="cta-copy">
        <h2 set:html={headline}></h2>
        <p class="cta-lead">{lead}</p>
        <div class="cta-actions">
          <button
            type="button"
            class="btn btn-primary btn-large"
            data-open-modal
            data-source-type={sourceType}
          >
            {primaryLabel}
          </button>
          {secondaryLabel && secondaryHref && (
            <a href={secondaryHref} class="btn btn-ghost btn-large">{secondaryLabel}</a>
          )}
        </div>
      </div>
      <div class="cta-visual" aria-label="SpaceSight product demo">
        <video class="cta-video" src="/products/spacesight_demo.mp4" autoplay muted loop controls preload="metadata" playsinline aria-label="SpaceSight product demo"></video>
      </div>
    </div>
  </div>
</section>
