---
---

<section class="section spacesight-hero" id="spacesight-hero">
  <div class="container spacesight-hero-container">
    <div class="spacesight-hero-inner">
      <div class="spacesight-hero-content">
        <div class="spacesight-hero-title">
          <img src="https://whale-web.oss-cn-beijing.aliyuncs.com/2025-09-26/182897735.png" alt="" width="48" height="48" loading="eager">
          <span>SpaceSight</span>
        </div>
        <h1 class="spacesight-hero-headline">See what's actually happening — before it becomes a problem.</h1>
        <p class="spacesight-hero-lead">SpaceSight turns raw physical-space data into real-time intelligence — built for teams who can't afford blind spots.</p>

        <div class="hero-actions">
          <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="官网 SDP 体验 demo 留资">Book a demo</button>
          <a href="https://www.meetwhale.ai/try_for_free" class="btn btn-ghost btn-large">Watch a Demo</a>
        </div>
      </div>

      <div class="spacesight-hero-media">
        <video autoplay muted loop playsinline preload="metadata" poster="/hero/spacesight-poster.jpg" width="1920" height="1080" aria-label="SpaceSight full product demo">
          <source src="/hero/spacesight-demo.mp4" type="video/mp4">
        </video>
        <span class="viewfinder-corner viewfinder-corner-tl" aria-hidden="true"></span>
        <span class="viewfinder-corner viewfinder-corner-tr" aria-hidden="true"></span>
        <span class="viewfinder-corner viewfinder-corner-bl" aria-hidden="true"></span>
        <span class="viewfinder-corner viewfinder-corner-br" aria-hidden="true"></span>
        <span class="hud-chip hud-chip-live" aria-hidden="true"><span class="hud-live-dot"></span>LIVE</span>
        <span class="hud-chip hud-chip-zone" aria-hidden="true">ZONE 03</span>
        <span class="hud-chip hud-chip-count" aria-hidden="true">34 VISITORS</span>
      </div>
    </div>
  </div>
</section>
