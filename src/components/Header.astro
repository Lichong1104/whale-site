---
---

<header class="site-header">
  <a href="/" class="logo" aria-label="Whale AI home">
    <img src="/whale-logo.png" alt="Whale AI" width="144" height="32">
  </a>
  <nav class="site-nav" aria-label="Primary">
    <div class="nav-dropdown" data-dropdown>
      <button
        class="nav-link nav-dropdown-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="products-menu"
        data-dropdown-toggle
      >
        Products
        <svg class="nav-dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
      <div class="nav-dropdown-menu mega-menu" id="products-menu" aria-label="Products" hidden>
        <div class="mega-menu-inner">
          <ul class="mega-tabs" role="tablist" aria-label="Product categories">
            <li>
              <button class="mega-tab active" type="button" role="tab" aria-selected="true" data-keyid="platform">
                Platform
              </button>
            </li>
            <li>
              <button class="mega-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-keyid="hardware">
                Hardware
              </button>
            </li>
          </ul>
          <div class="mega-panels">
            <div class="mega-panel active" id="mega-panel-platform" role="tabpanel" data-keyid="platform">
              <a href="/whale_spacesight/" class="platform-card">
                <img src="/product-logos/spacesight-logo.png" alt="" width="40" height="40" loading="lazy">
                <div class="platform-card-text">
                  <div class="platform-title">SpaceSight</div>
                  <div class="platform-desc">Space Intelligence Platform</div>
                </div>
              </a>
              <a href="https://echo.meetwhale.ai/" target="_blank" rel="noopener noreferrer" class="platform-card">
                <img src="/product-logos/echo-logo.png" alt="" width="40" height="40" loading="lazy">
                <div class="platform-card-text">
                  <div class="platform-title">Echo</div>
                  <div class="platform-desc">Voice Intelligence Platform</div>
                </div>
              </a>
            </div>
            <div class="mega-panel" id="mega-panel-hardware" role="tabpanel" data-keyid="hardware" hidden>
              <a href="/#hardware" class="hardware-card">
                <div class="hardware-title">AI Cameras</div>
                <div class="hardware-pic">
                  <img src="/hardware/ai-cameras.png" alt="AI Cameras" loading="lazy">
                </div>
              </a>
              <a href="/#hardware" class="hardware-card">
                <div class="hardware-title">AI Hubs</div>
                <div class="hardware-pic">
                  <img src="/hardware/ai-hubs.png" alt="AI Hubs" loading="lazy">
                </div>
              </a>
              <a href="/#hardware" class="hardware-card">
                <div class="hardware-title">Echo Pins</div>
                <div class="hardware-pic">
                  <img src="/hardware/echo-pins.png" alt="Echo Pins" loading="lazy">
                </div>
              </a>
              <a href="/#hardware" class="hardware-card">
                <div class="hardware-title">Echo Pods</div>
                <div class="hardware-pic">
                  <img src="/hardware/echo-pods.png" alt="Echo Pods" loading="lazy">
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <a href="/#integrated-platform" class="nav-link">Solutions</a>
    <a href="/#user-cases" class="nav-link">User Cases</a>

    <div class="nav-dropdown" data-dropdown>
      <button
        class="nav-link nav-dropdown-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="blog-menu"
        data-dropdown-toggle
      >
        Blog
        <svg class="nav-dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
      <div class="nav-dropdown-menu blog-menu" id="blog-menu" aria-label="Blog" hidden>
        <div class="blog-menu-inner">
          <a href="/blog/" class="blog-menu-card">
            <div class="blog-menu-icon" aria-hidden="true">📊</div>
            <div class="blog-menu-text">
              <div class="blog-menu-title">Products &amp; Solutions</div>
              <div class="blog-menu-desc">AI operations for retail, automotive, healthcare, and more.</div>
            </div>
          </a>
          <a href="https://www.whale.sg/blogpost.html" target="_blank" rel="noopener noreferrer" class="blog-menu-card">
            <div class="blog-menu-icon" aria-hidden="true">📰</div>
            <div class="blog-menu-text">
              <div class="blog-menu-title">News &amp; About Us</div>
              <div class="blog-menu-desc">Company updates, events, and the story behind Whale.</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <a href="/#contact" class="nav-link">Contact</a>
  </nav>
  <button type="button" class="btn btn-primary" data-open-modal data-source-type="官网立即咨询留资">Request Demo</button>
</header>

<style>
  .site-nav {
    height: 100%;
  }
  .nav-dropdown {
    display: flex;
    align-items: center;
    height: 100%;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: none;
    font: inherit;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.5rem 0;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .nav-link:hover {
    color: var(--text);
  }
  .nav-dropdown-chevron {
    transition: transform 0.2s ease;
  }
  .nav-dropdown.is-open .nav-dropdown-chevron,
  .nav-dropdown:hover .nav-dropdown-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
  }
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -1.25rem;
    left: 0;
    right: 0;
    height: 1.25rem;
    background: transparent;
  }
  .nav-dropdown.is-open .nav-dropdown-menu,
  .nav-dropdown:hover .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mega-menu-inner {
    width: min(1200px, 92vw);
    margin-inline: auto;
    padding: 1.5rem 0 2rem;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.25rem;
  }

  .mega-tabs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-right: 1px solid #e8ecf1;
  }
  .mega-tab {
    position: relative;
    width: 100%;
    text-align: left;
    padding: 0.55rem 0.85rem;
    padding-right: 1.5rem;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    color: #1e2128;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .mega-tab::after {
    content: '';
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid currentColor;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .mega-tab:hover {
    color: #0074fc;
  }
  .mega-tab.active {
    color: #0074fc;
    font-weight: 600;
  }
  .mega-tab.active::after {
    opacity: 1;
  }

  .mega-panels {
    min-height: 200px;
  }
  .mega-panel {
    display: none;
    gap: 0.75rem;
  }
  .mega-panel[data-keyid="platform"] {
    grid-template-columns: repeat(4, 1fr);
  }
  .mega-panel[data-keyid="hardware"] {
    grid-template-columns: repeat(4, 1fr);
  }
  .mega-panel.active {
    display: grid;
  }

  /* Blog dropdown menu */
  .blog-menu-inner {
    width: min(640px, 92vw);
    margin-inline: auto;
    padding: 1rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .blog-menu-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem;
    background: #f8f9fb;
    border-radius: 8px;
    color: #1e2128;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .blog-menu-card:hover {
    background: #edf2fa;
    transform: translateY(-2px);
  }

  .blog-menu-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: var(--radius-sm);
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .blog-menu-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .blog-menu-title {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .blog-menu-desc {
    font-size: 0.8rem;
    color: #5d626b;
    line-height: 1.25;
  }

  .platform-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem;
    background: #f8f9fb;
    border-radius: 8px;
    color: #1e2128;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .platform-card:hover {
    background: #edf2fa;
    transform: translateY(-2px);
  }
  .platform-card img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex: 0 0 auto;
  }
  .platform-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .platform-title {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .platform-desc {
    font-size: 0.8rem;
    color: #5d626b;
    line-height: 1.25;
  }

  .hardware-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: #f8f9fb;
    border-radius: 8px;
    color: #1e2128;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .hardware-card:hover {
    background: #edf2fa;
    transform: translateY(-2px);
  }
  .hardware-title {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }
  .hardware-pic {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
  }
  .hardware-pic img {
    max-width: 100%;
    max-height: 150px;
    object-fit: contain;
  }

  @media (max-width: 980px) {
    .mega-panel[data-keyid="platform"],
    .mega-panel[data-keyid="hardware"] {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .nav-dropdown-menu {
      position: static;
      transform: none;
      width: 100%;
      box-shadow: none;
      border: none;
      background: transparent;
      padding: 0.75rem 0 0;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      display: none;
    }
    .nav-dropdown.is-open .nav-dropdown-menu {
      display: block;
      transform: none;
    }
    .mega-menu-inner {
      grid-template-columns: 1fr;
      padding: 0;
    }
    .mega-tabs {
      flex-direction: row;
      border-right: none;
      border-bottom: 1px solid #e8ecf1;
      margin-bottom: 0.75rem;
    }
    .mega-tab::after {
      display: none;
    }
    .mega-panel[data-keyid="platform"],
    .mega-panel[data-keyid="hardware"] {
      grid-template-columns: 1fr;
    }
    .hardware-pic img {
      max-height: 120px;
    }
    .blog-menu-inner {
      width: 100%;
      padding: 0;
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    function initDropdown(dropdown) {
      const toggle = dropdown.querySelector('[data-dropdown-toggle]');
      const menu = dropdown.querySelector('.nav-dropdown-menu');
      const tabs = dropdown.querySelectorAll('.mega-tab');
      const panels = dropdown.querySelectorAll('.mega-panel');

      function switchTab(key) {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.keyid === key;
          tab.classList.toggle('active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
        });
        panels.forEach((panel) => {
          const isActive = panel.dataset.keyid === key;
          panel.classList.toggle('active', isActive);
          panel.hidden = !isActive;
        });
      }

      let closeTimer = null;

      function open() {
        clearTimeout(closeTimer);
        menu.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        dropdown.classList.add('is-open');
      }
      function close() {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          menu.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
          dropdown.classList.remove('is-open');
        }, 250);
      }

      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        menu.hidden ? open() : close();
      });

      dropdown.addEventListener('mouseenter', open);
      dropdown.addEventListener('mouseleave', close);

      dropdown.addEventListener('focusin', (e) => {
        if (!dropdown.contains(e.relatedTarget)) open();
      });
      dropdown.addEventListener('focusout', (e) => {
        if (!dropdown.contains(e.relatedTarget)) close();
      });

      if (tabs.length && panels.length) {
        tabs.forEach((tab) => {
          tab.addEventListener('mouseenter', () => switchTab(tab.dataset.keyid));
          tab.addEventListener('click', () => switchTab(tab.dataset.keyid));
        });

        toggle.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            open();
            const firstTab = dropdown.querySelector('.mega-tab');
            firstTab && firstTab.focus();
          } else if (e.key === 'Escape') {
            close();
            toggle.focus();
          }
        });

        menu.addEventListener('keydown', (e) => {
          const items = Array.from(tabs);
          const idx = items.indexOf(document.activeElement);
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const next = items[(idx + 1) % items.length];
            next && next.focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prev = items[(idx - 1 + items.length) % items.length];
            prev && prev.focus();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            close();
            toggle.focus();
          }
        });
      } else {
        toggle.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'Escape') {
            e.preventDefault();
            menu.hidden ? open() : close();
            if (!menu.hidden) {
              const firstLink = menu.querySelector('a');
              firstLink && firstLink.focus();
            } else {
              toggle.focus();
            }
          }
        });

        menu.addEventListener('keydown', (e) => {
          const items = Array.from(menu.querySelectorAll('a'));
          const idx = items.indexOf(document.activeElement);
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const next = items[(idx + 1) % items.length];
            next && next.focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prev = items[(idx - 1 + items.length) % items.length];
            prev && prev.focus();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            close();
            toggle.focus();
          }
        });
      }

      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target)) close();
      });
    }

    document.querySelectorAll('[data-dropdown]').forEach(initDropdown);
  })();
</script>
