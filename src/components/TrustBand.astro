---
---

<section class="section section--tight trust-band" aria-label="Certifications">
  <div class="container">
    <p class="trust-label">Certified &amp; compliant with the standards that protect your operations</p>
    <div class="logo-bar cert-bar">
      <img class="cert-logo" src="/cert-logos/soc2-shield.png" alt="SOC 2 Type II" width="120" height="60" loading="lazy">
      <img class="cert-logo" src="/cert-logos/gdpr-badge.png" alt="GDPR Compliant" width="120" height="60" loading="lazy">
    </div>
  </div>
</section>

<style>
  .cert-bar {
    gap: var(--space-md) var(--space-lg);
  }
  .cert-logo {
    max-height: 60px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    opacity: 0.94;
    transition: opacity 0.2s ease, transform 0.25s ease;
  }
  .cert-logo:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  @media (max-width: 720px) {
    .cert-logo {
      max-height: 48px;
      max-width: 110px;
    }
  }
</style>
