<script>
  (function () {
    const dropdown = document.querySelector('[data-lang-dropdown]');
    if (!dropdown) return;
    const toggle = dropdown.querySelector('.lang-toggle');
    const menu = dropdown.querySelector('.lang-menu');

    function closeMenu() {
      dropdown.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }

    function openMenu() {
      dropdown.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
    }

    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      if (dropdown.classList.contains('open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    document.addEventListener('click', function (e) {
      if (!dropdown.contains(e.target)) closeMenu();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMenu();
    });

    // Set active label based on current host
    const currentHost = window.location.hostname;
    const map = {
      'www.meetwhale.com': 'Chinese (简体中文)',
      'www.whaleai.co.jp': 'Japanese (日本語)',
      'www.whale.sg': 'English (Singapore)'
    };
    const label = map[currentHost] || 'English (Singapore)';
    toggle.querySelector('span').textContent = label;
    menu.querySelectorAll('a').forEach(function (link) {
      link.setAttribute('aria-current', link.textContent === label ? 'true' : 'false');
    });
  })();
</script>
