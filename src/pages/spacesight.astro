---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.whale.sg/spacesight/';
const pageTitle = 'SpaceSight | Physical Operations Intelligence Platform';
const pageDescription = 'SpaceSight turns camera footage into AI audit, customer flow analytics, and loss prevention insights across every store and site — no rip-and-replace.';

const extraSchema = [
  {
    '@type': 'SoftwareApplication',
    name: 'Whale SpaceSight',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Edge, Cloud',
    description: pageDescription,
    url: canonicalUrl
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.whale.sg/products/' },
      { '@type': 'ListItem', position: 3, name: 'SpaceSight', item: canonicalUrl }
    ]
  }
];

const heroProof = [
  { value: '1,600+', label: 'enterprise clients' },
  { value: '45+', label: 'countries' },
  { value: '530,000+', label: 'connected edge devices' },
  { value: '99.999%', label: 'uptime' }
];

const aboutProof = [
  { value: '1,600+', label: 'global enterprise clients' },
  { value: '45+', label: 'countries deployed' },
  { value: '95%+', label: 'data accuracy' },
  { value: '2,000+', label: 'anomalies detected per day' }
];

const units = [
  {
    id: 'UNIT.01',
    name: 'See & Audit',
    sub: 'AI Audit Platform for Automated Compliance Audit',
    body: [
      'SpaceSight continuously audits physical operations across hygiene, planograms, safety signage, shelf execution, merchandising standards, and SOP compliance. Instead of relying only on manual walkthroughs, teams can use an AI Audit Platform to detect issues automatically, around the clock.',
      'The system works across different store layouts and operational scenarios without heavy scene-specific training. A manual inspection that used to take around 40 minutes can be reduced to about two minutes, while real-time alerts and heatmaps show where compliance problems actually happen.'
    ],
    impact: [
      { value: '300%', label: 'more compliance issues detected' },
      { value: '95%+', label: 'SOP accuracy' }
    ]
  },
  {
    id: 'UNIT.02',
    name: 'Understand Your Space',
    sub: 'Retail Video Analytics and Customer Flow Analytics',
    body: [
      'SpaceSight helps enterprises understand how customers move through physical spaces. Using privacy-conscious video analysis, it measures footfall, passerby rate, entry rate, dwell time, conversion, queueing, and traffic patterns across stores and zones.',
      'Unlike facial recognition systems, SpaceSight uses re-identification based on non-biometric signals such as body shape, gait, and clothing. This enables customer flow analytics and retail analysis while supporting privacy and compliance requirements.',
      'These insights help teams improve staffing, layout, campaign evaluation, store optimization, and space optimization with real behavioral data instead of guesswork.'
    ],
    impact: [
      { value: '95%+', label: 'tracking accuracy, privacy-compliant' },
      { value: '90%+', label: 'demographic accuracy' }
    ]
  }
];

const unitWide = {
  id: 'UNIT.03',
  name: 'Act Automatically',
  sub: 'Enterprise AIOS and Agent Orchestration',
  body: [
    'SpaceSight connects analytics with action. Through SpaceClaw, teams can ask operational questions such as why conversion dropped yesterday, which stores had abnormal dwell time, or where compliance issues increased.',
    'The Enterprise AIOS retrieves relevant footage, analyzes the root cause, generates work orders, dispatches tasks, and creates daily, weekly, or monthly reports automatically. Agent orchestration turns scattered video, alerts, and operational data into a closed-loop workflow from detection to action.'
  ],
  impact: [
    { value: '70%+', label: 'AI recommendation adoption rate' },
    { value: '95%', label: 'reduction in operations meeting preparation' }
  ]
};

const devices = [
  { name: 'Existing Cameras', sub: 'CCTV · NVR · VMS', tag: 'Reuse', glyph: 'cctv' },
  { name: 'Video Hub', sub: 'Connects and manages video streams', tag: 'Edge', glyph: 'hub' },
  { name: 'AI Hub', sub: 'Processes video locally at the edge', tag: 'Edge AI', img: '/spacesight/ai-hub.webp', imgAlt: 'Whale AI Hub — edge device that processes video locally to generate analytics, events, and alerts', imgW: 391, imgH: 200 },
  { name: 'Edge AI Camera', sub: 'Including Whale Owl', tag: 'Edge AI', img: '/spacesight/edge-ai-camera.webp', imgAlt: 'Whale Owl Edge AI Camera — AI processing built directly into the camera', imgW: 960, imgH: 960 },
  { name: 'SpaceSight Cloud Platform', sub: 'Dashboards · Alerts · Automated reports · SpaceClaw', tag: 'Space Intelligence layer', glyph: 'cloud' }
];

const steps = [
  { n: '01', title: 'Site survey and requirement confirmation', desc: 'We confirm store layout, camera positions, network conditions, target use cases, and success criteria, such as footfall, dwell time, queueing, loss prevention, or AI inspection.' },
  { n: '02', title: 'Camera and video source preparation', desc: 'Existing cameras are reused where possible, or new cameras are installed if coverage is insufficient. The key requirement is stable video access from cameras, NVR, or VMS systems.' },
  { n: '03', title: 'Edge AI device deployment', desc: 'AI Hub, Video Hub, or Edge AI Cameras are deployed on site based on the solution scope. Video data can be processed locally to reduce bandwidth and improve response speed.' },
  { n: '04', title: 'Video ingestion and channel configuration', desc: 'Camera channels are added into the system, mapped to store areas, and configured for live view, video access, AI analysis, and event tracking.' },
  { n: '05', title: 'AI model and scenario configuration', desc: 'Relevant AI capabilities are configured for the business scenario, such as entrance counting, customer flow analytics, dwell time analysis, queue detection, table-cleaning inspection, or compliance audit.' },
  { n: '06', title: 'ROI and business rule setup', desc: 'Detection zones, virtual lines, regions of interest, and thresholds are configured based on operational rules, such as dwell time limits, queue length, or cleaning response time.' },
  { n: '07', title: 'Cloud platform connection', desc: 'Processed events, metadata, images, trajectories, and analytics are uploaded to the SpaceSight platform for dashboards, reporting, alerts, and enterprise-level review.' },
  { n: '08', title: 'Testing and calibration', desc: 'The system is tested with real site footage to validate camera coverage, model accuracy, network stability, and whether the results match business expectations.' },
  { n: '09', title: 'Go-live and monitoring', desc: 'After validation, the site goes live. Teams monitor device health, stream stability, AI results, and business dashboards during the initial operation period.' },
  { n: '10', title: 'Ongoing optimization', desc: 'Based on customer feedback and real-world data, camera angles, ROI settings, thresholds, and AI configurations can be adjusted to improve accuracy and business usability.' }
];

const compliance = [
  { label: 'No facial recognition:', text: 'People tracking uses re-identification based on non-biometric signals, not facial recognition.' },
  { label: 'Edge AI processing:', text: 'Video can be processed locally on AI Hub or Edge AI Camera. Only metadata, analytics, and anomaly events need to be sent to the cloud, reducing bandwidth usage by up to 80%.' },
  { label: 'Enterprise-grade compliance:', text: 'SOC 2 Type II · GDPR Compliant · ISO 27001 · ISO 9001 · CMMI Level 5' }
];

const scaleBars = [
  { label: 'Store', h: '34%' },
  { label: 'Shopping mall', h: '54%' },
  { label: 'Airport', h: '76%' },
  { label: 'Campus', h: '100%' }
];
---
<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogImage="https://www.whale.sg/og/spacesight.png"
  extraSchema={extraSchema}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&display=swap">
  <Header />
  <main class="ssx">

    <!-- ============ HERO — live operations console ============ -->
    <section class="ssx-hero">
      <div class="container ssx-hero-grid">
        <div class="ssx-hero-copy">
          <p class="ssx-eyebrow">SpaceSight · Space Intelligence</p>
          <h1 class="ssx-h1">
            Physical Operations Intelligence for
            <span class="ssx-tail">Every Store, Site, and Space</span>
          </h1>
          <p class="ssx-sub">SpaceSight turns cameras, sensors, and edge devices into real-time Space Intelligence, helping enterprises audit operations, understand customer flow, and optimize store performance before small issues become business problems.</p>
          <div class="ssx-hero-cta">
            <button type="button" class="btn btn-primary btn-large ssx-btn-yellow" data-open-modal data-source-type="spacesight页-Hero留资">Book a demo</button>
          </div>
        </div>

        <figure class="ssx-console">
          <div class="ssx-console-bar">
            <span class="ssx-rec"><i aria-hidden="true"></i>REC</span>
            <span class="ssx-console-name">SpaceSight // Operations console</span>
            <span class="ssx-console-mode">Real-time</span>
          </div>
          <div class="ssx-console-view">
            <video src="/products/spacesight-demo-eng.mp4" poster="/products/spacesight-demo-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="SpaceSight product demo video"></video>
            <span class="ssx-vc ssx-vc-tl" aria-hidden="true"></span>
            <span class="ssx-vc ssx-vc-tr" aria-hidden="true"></span>
            <span class="ssx-vc ssx-vc-bl" aria-hidden="true"></span>
            <span class="ssx-vc ssx-vc-br" aria-hidden="true"></span>
            <span class="ssx-scanline" aria-hidden="true"></span>
          </div>
          <dl class="ssx-telemetry">
            <div>
              <dt>Detection</dt>
              <dd>Real-time</dd>
            </div>
            <div>
              <dt>Processing</dt>
              <dd>Edge AI + Cloud</dd>
            </div>
            <div>
              <dt>Device types</dt>
              <dd>120+</dd>
            </div>
          </dl>
          <figcaption class="ssx-figcap"><span class="ssx-figcap-id">Fig. 00</span><span class="ssx-figcap-alt">Live product demo — SpaceSight operations console</span></figcaption>
        </figure>
      </div>

      <div class="container ssx-proof" aria-label="Proof points">
        {heroProof.map((p) => (
          <div class="ssx-proof-cell">
            <span class="ssx-proof-value">{p.value}</span>
            <span class="ssx-proof-label">{p.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ SEC.01 — About SpaceSight ============ -->
    <section class="ssx-sec" aria-labelledby="ssx-about">
      <div class="container">
        <header class="ssx-ruler">
          <span class="ssx-ruler-id">SEC.01</span>
          <span class="ssx-ruler-line" aria-hidden="true"></span>
          <h2 class="ssx-ruler-name" id="ssx-about">About SpaceSight</h2>
        </header>

        <p class="ssx-lede">Most monitoring systems capture footage. <span class="ssx-lede-em">SpaceSight captures <span class="ssx-hl">meaning</span>.</span></p>

        <div class="ssx-about-grid">
          <div class="ssx-about-copy">
            <p>Built as a Physical Operations Intelligence platform, SpaceSight transforms video and sensor data from physical spaces into actionable insights for store operations, compliance, loss prevention, and customer experience. It connects with existing CCTV, AI cameras, sensors, and audio devices, then uses edge AI and cloud intelligence to detect what is happening across every location in real time.</p>
            <p>Powered by Whale's Space Intelligence capabilities and IoT infrastructure, SpaceSight supports 120+ device types across 530,000+ edge devices with 99.999% availability. That means enterprises can deploy AI-powered retail video analytics and automated compliance audit workflows on top of the infrastructure they already have, without replacing every camera.</p>
          </div>

          <aside class="ssx-proofband" aria-label="Proof band — deployment scale">
            <div class="ssx-proofband-head"><i aria-hidden="true"></i>Proof — Global deployment</div>
            <div class="ssx-proofband-grid">
              {aboutProof.map((p) => (
                <div class="ssx-proofband-cell">
                  <span class="ssx-proofband-value">{p.value}</span>
                  <span class="ssx-proofband-label">{p.label}</span>
                </div>
              ))}
            </div>
          </aside>
        </div>

        <div class="ssx-dashgrid">
          <figure class="ssx-frame">
            <div class="ssx-frame-bar"><span>Analytics // Demographics</span><i aria-hidden="true"></i></div>
            <img src="/spacesight/analytics-demographics.webp" alt="SpaceSight analytics dashboard — customer demographics breakdown by age and gender" width="1184" height="854" loading="lazy" />
            <figcaption class="ssx-figcap"><span class="ssx-figcap-id">Fig. 01</span><span class="ssx-figcap-alt">Customer demographics dashboard</span></figcaption>
          </figure>
          <figure class="ssx-frame">
            <div class="ssx-frame-bar"><span>Analytics // Entry rate</span><i aria-hidden="true"></i></div>
            <img src="/spacesight/analytics-entry-rate.webp" alt="SpaceSight analytics dashboard — entry rate and customer-flow funnel across stores" width="1186" height="846" loading="lazy" />
            <figcaption class="ssx-figcap"><span class="ssx-figcap-id">Fig. 02</span><span class="ssx-figcap-alt">Entry-rate and traffic funnel dashboard</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ SEC.02 — Core capabilities (dark console band) ============ -->
    <section class="ssx-sec ssx-dark" aria-labelledby="ssx-cap">
      <div class="container">
        <header class="ssx-ruler">
          <span class="ssx-ruler-id">SEC.02</span>
          <span class="ssx-ruler-line" aria-hidden="true"></span>
          <h2 class="ssx-ruler-name" id="ssx-cap">Core capabilities</h2>
        </header>

        <div class="ssx-units">
          {units.map((u) => (
            <article class="ssx-unit">
              <span class="ssx-uc ssx-uc-tl" aria-hidden="true"></span>
              <span class="ssx-uc ssx-uc-tr" aria-hidden="true"></span>
              <span class="ssx-uc ssx-uc-bl" aria-hidden="true"></span>
              <span class="ssx-uc ssx-uc-br" aria-hidden="true"></span>
              <header class="ssx-unit-head">
                <span class="ssx-unit-id">{u.id}</span>
                <h3 class="ssx-unit-name">{u.name}</h3>
                <span class="ssx-unit-status"><i aria-hidden="true"></i>Active</span>
              </header>
              <p class="ssx-unit-sub">{u.sub}</p>
              <div class="ssx-unit-body">
                {u.body.map((para) => <p>{para}</p>)}
              </div>
              <footer class="ssx-unit-foot">
                <p class="ssx-impact-label">Business impact</p>
                <div class="ssx-impact-row">
                  {u.impact.map((m) => (
                    <div class="ssx-metric">
                      <b>{m.value}</b>
                      <span>{m.label}</span>
                    </div>
                  ))}
                </div>
              </footer>
            </article>
          ))}

          <article class="ssx-unit ssx-unit--wide">
            <span class="ssx-uc ssx-uc-tl" aria-hidden="true"></span>
            <span class="ssx-uc ssx-uc-tr" aria-hidden="true"></span>
            <span class="ssx-uc ssx-uc-bl" aria-hidden="true"></span>
            <span class="ssx-uc ssx-uc-br" aria-hidden="true"></span>
            <div class="ssx-unit-inner">
              <div class="ssx-unit-main">
                <header class="ssx-unit-head">
                  <span class="ssx-unit-id">{unitWide.id}</span>
                  <h3 class="ssx-unit-name">{unitWide.name}</h3>
                  <span class="ssx-unit-status"><i aria-hidden="true"></i>Active</span>
                </header>
                <p class="ssx-unit-sub">{unitWide.sub}</p>
                <div class="ssx-unit-body">
                  {unitWide.body.map((para) => <p>{para}</p>)}
                </div>
                <footer class="ssx-unit-foot">
                  <p class="ssx-impact-label">Business impact</p>
                  <div class="ssx-impact-row">
                    {unitWide.impact.map((m) => (
                      <div class="ssx-metric">
                        <b>{m.value}</b>
                        <span>{m.label}</span>
                      </div>
                    ))}
                  </div>
                </footer>
              </div>
              <div class="ssx-claw">
                <div class="ssx-claw-bar"><span>SpaceClaw // Agent session</span><i aria-hidden="true"></i></div>
                <video src="/spacesight/spaceclaw-demo.mp4" poster="/spacesight/spaceclaw-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="SpaceClaw agent conversation demo"></video>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ SEC.03 — Built for Every Scale ============ -->
    <section class="ssx-sec" aria-labelledby="ssx-scale">
      <div class="container">
        <header class="ssx-ruler">
          <span class="ssx-ruler-id">SEC.03</span>
          <span class="ssx-ruler-line" aria-hidden="true"></span>
          <h2 class="ssx-ruler-name" id="ssx-scale">Built for Every Scale of Operation</h2>
        </header>

        <div class="ssx-scale-grid">
          <div class="ssx-scale-copy">
            <p>SpaceSight deploys across any physical space and any existing infrastructure — sized to match how many cameras your operation actually needs.</p>
            <p>For larger or more complex properties — such as shopping malls, airports, and multi-building campuses — hardware sizing, deployment timeline, and AI capabilities should be assessed case by case rather than forced into a fixed tier.</p>
            <p class="ssx-note"><b>NOTE</b><span>final deployment time and hardware configuration depend on camera readiness, network access, video stream availability, and selected AI modules.</span></p>
          </div>

          <aside class="ssx-gauge" aria-label="Deployment scale — sized to camera count">
            <div class="ssx-gauge-head">
              <span>Scale // Sized to camera count</span>
              <span class="ssx-gauge-chip">Case by case</span>
            </div>
            <div class="ssx-bars">
              {scaleBars.map((b) => (
                <div class="ssx-bar">
                  <i style={`--h:${b.h}`} aria-hidden="true"></i>
                  <span>{b.label}</span>
                </div>
              ))}
            </div>
            <dl class="ssx-telemetry ssx-gauge-foot">
              <div>
                <dt>Space</dt>
                <dd>Any physical</dd>
              </div>
              <div>
                <dt>Infrastructure</dt>
                <dd>Any existing</dd>
              </div>
              <div>
                <dt>Sizing</dt>
                <dd>Per camera count</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ SEC.04 — Hardware Options (device rack) ============ -->
    <section class="ssx-sec ssx-sec-tint" aria-labelledby="ssx-hw">
      <div class="container">
        <header class="ssx-ruler">
          <span class="ssx-ruler-id">SEC.04</span>
          <span class="ssx-ruler-line" aria-hidden="true"></span>
          <h2 class="ssx-ruler-name" id="ssx-hw">Hardware Options</h2>
        </header>

        <p class="ssx-rack-intro">SpaceSight works with existing cameras, new Edge AI Cameras, AI Hub, Video Hub, or a mixed deployment model. The same Space Intelligence layer runs across different hardware setups.</p>

        <div class="ssx-rack">
          <div class="ssx-rack-grid">
            {devices.map((d) => (
              <article class="ssx-device">
                <div class="ssx-device-view">
                  {d.img ? (
                    <img src={d.img} alt={d.imgAlt} width={d.imgW} height={d.imgH} loading="lazy" />
                  ) : d.glyph === 'cctv' ? (
                    <svg viewBox="0 0 120 90" role="img" aria-label="Existing CCTV camera line drawing">
                      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="18" y="26" width="62" height="26" rx="6" />
                        <path d="M80 32 l22 -10 v34 l-22 -10" />
                        <path d="M40 52 v16 M32 68 h16" />
                      </g>
                      <circle cx="34" cy="39" r="5" fill="#FFD23F" stroke="none" />
                    </svg>
                  ) : d.glyph === 'hub' ? (
                    <svg viewBox="0 0 120 90" role="img" aria-label="Video Hub line drawing">
                      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="22" y="16" width="76" height="18" rx="5" />
                        <rect x="22" y="40" width="76" height="18" rx="5" />
                        <rect x="22" y="64" width="76" height="14" rx="5" />
                      </g>
                      <circle cx="34" cy="25" r="3.5" fill="#FFD23F" stroke="none" />
                      <circle cx="34" cy="49" r="3.5" fill="#FFD23F" stroke="none" />
                      <circle cx="34" cy="71" r="3.5" fill="currentColor" stroke="none" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 120 90" role="img" aria-label="SpaceSight Cloud Platform line drawing">
                      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M36 66 a14 14 0 0 1 -2 -27.8 a20 20 0 0 1 38.6 -4.4 A16 16 0 0 1 86 66 z" />
                        <path d="M46 52 h10 M62 52 h12 M46 60 h20" />
                      </g>
                      <circle cx="88" cy="30" r="5" fill="#FFD23F" stroke="none" />
                    </svg>
                  )}
                </div>
                <div class="ssx-device-body">
                  <h3 class="ssx-device-name">{d.name}</h3>
                  <p class="ssx-device-sub">{d.sub}</p>
                  <span class="ssx-device-tag">{d.tag}</span>
                </div>
              </article>
            ))}
          </div>
          <div class="ssx-rail" aria-hidden="true"></div>
        </div>

        <div class="ssx-lanes">
          <div class="ssx-lane">
            <p class="ssx-lane-chip">Path A — Existing infrastructure</p>
            <p>For locations with existing CCTV or NVR/VMS systems, Video Hub connects and manages video streams, while AI Hub processes video locally at the edge to generate analytics, events, and alerts in real time.</p>
          </div>
          <div class="ssx-lane">
            <p class="ssx-lane-chip">Path B — New installation</p>
            <p>For new installations, Edge AI Cameras, including Whale Owl, bring AI processing directly into the camera. Results flow into the SpaceSight Cloud Platform, where teams can view dashboards, receive alerts, generate automated reports, and search operational events through SpaceClaw.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SEC.05 — How Deployment Works (SVG pipeline) ============ -->
    <section class="ssx-sec ssx-dark ssx-deploy" aria-labelledby="ssx-deploy">
      <div class="container">
        <header class="ssx-ruler">
          <span class="ssx-ruler-id">SEC.05</span>
          <span class="ssx-ruler-line" aria-hidden="true"></span>
          <h2 class="ssx-ruler-name" id="ssx-deploy">How Deployment Works</h2>
        </header>

        <div class="ssx-pipe-meta">
          <span>Deployment pipeline — Ten stages</span>
          <span class="ssx-pipe-meta-right">Site survey → Ongoing optimization · <a href="/whale_spacesight/" class="ssx-handbook-link">Full technical handbook →</a></span>
        </div>

        <div class="ssx-flow">
          <svg class="ssx-pipes" viewBox="0 0 1000 500" preserveAspectRatio="none" aria-hidden="true">
            <path class="ssx-pipe-base" d="M 92 119 H 908 V 381 H 92" fill="none" vector-effect="non-scaling-stroke" />
            <path class="ssx-pipe-flow" d="M 92 119 H 908 V 381 H 92" fill="none" vector-effect="non-scaling-stroke" />
            <path class="ssx-pipe-flow ssx-pipe-flow2" d="M 92 119 H 908 V 381 H 92" fill="none" vector-effect="non-scaling-stroke" />
          </svg>
          <div class="ssx-nodes">
            {steps.map((s) => (
              <article class="ssx-node">
                <div class="ssx-node-top">
                  <span class="ssx-node-num">STEP {s.n}</span>
                  <span class="ssx-node-sq" aria-hidden="true"></span>
                </div>
                <h3 class="ssx-node-title">{s.title}</h3>
                <p class="ssx-node-desc">{s.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SEC.06 — Data Security and Compliance ============ -->
    <section class="ssx-sec" aria-labelledby="ssx-sec6">
      <div class="container">
        <header class="ssx-ruler">
          <span class="ssx-ruler-id">SEC.06</span>
          <span class="ssx-ruler-line" aria-hidden="true"></span>
          <h2 class="ssx-ruler-name" id="ssx-sec6">Data Security and Compliance</h2>
        </header>

        <div class="ssx-sec6-grid">
          <div class="ssx-result">
            <div class="ssx-result-head"><i aria-hidden="true"></i>Security &amp; compliance — verified</div>
            <ul>
              {compliance.map((row) => (
                <li>
                  <span class="ssx-check" aria-hidden="true">
                    <svg viewBox="0 0 12 12" fill="none"><path d="M2.2 6.3 4.8 8.8 9.8 3.4" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <p><b>{row.label}</b> {row.text}</p>
