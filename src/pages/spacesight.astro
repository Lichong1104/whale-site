---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.whale.sg/spacesight/';
const pageDescription = "SpaceSight turns raw physical-space data into real-time intelligence — automated detection & audit, SpaceClaw ask-and-find, and intelligent reporting. Built for teams who can't afford blind spots.";

const extraSchema = [
  {
    '@type': 'SoftwareApplication',
    name: 'Whale SpaceSight',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Edge, Cloud',
    description: pageDescription,
    url: canonicalUrl
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.whale.sg/products/' },
      { '@type': 'ListItem', position: 3, name: 'SpaceSight', item: canonicalUrl }
    ]
  }
];

/* Content source: spacesight.txt product brief (SpaceSight half) —
   headline/subhead verbatim, three capabilities verbatim, no imagery inside
   capability chapters per the brief ("我不打算再插图呈现"). Value stream
   (Detect → Find → Act → Report) is the through-line the brief implies. */

const streamBeats = [
  {
    n: '01', title: 'Watches continuously', href: '#detect',
    copy: 'Zero-shot AI audits every zone from the moment it’s deployed — no training data, no setup lag.'
  },
  {
    n: '02', title: 'Finds in seconds', href: '#find',
    copy: 'Ask in plain language; SpaceClaw pulls the exact clip. An afternoon of scrubbing, gone.'
  },
  {
    n: '03', title: 'Acts on its own', href: '#find',
    copy: 'When SpaceClaw spots something, it dispatches a task straight to the right person’s phone.'
  },
  {
    n: '04', title: 'Reports before you ask', href: '#report',
    copy: 'Structured reports on schedule, with next-step recommendations that drive action.'
  }
];
---

<Layout
  title="SpaceSight — Real-Time Space Intelligence | Whale AI"
  description={pageDescription}
  canonical={canonicalUrl}
  ogImage="https://www.whale.sg/og/spacesight.png"
  extraSchema={extraSchema}
>
  <Header />
  <main class="spx-page">
    <!--
      DIRECTION CONTRACT — /spacesight/ product page (brief: spacesight.txt)
      THESIS: one page is one monitored frame. The hero is the live feed; the value
        stream is the detector rail under it; each capability is a readout chapter
        carried by typography alone — the brief bans imagery inside capability
        sections, so layout, mono data motifs, and the marker sweep do the work.
      OWN-WORLD: Sensorium particle-detector system. SpaceSight signal = track-vision
        yellow (#FFD23F on ink stages, #A16207 ink on daylight). Mono = data voice.
      STORY: an ops lead lands, sees the demo running inside viewfinder brackets,
        rides the value-stream rail (watch → find → act → report), reads three
        chapters where each slogan locks on with a marker sweep, and books a demo
        at the dark finale where the loop closes.
      MEDIA: hero demo video + poster (/products/), finale sees-loop video (/hero/).
        No imagery inside capability chapters — text motifs only (per brief).
      CONTENT SOURCE: spacesight.txt — headline, subhead, capability copy verbatim.
    -->

    <!-- Hero: the page itself is the monitored frame -->
    <section class="spx-hero" aria-label="SpaceSight overview">
      <div class="container spx-hero-inner">
        <div class="spx-hero-copy">
          <span class="spx-chip">SpaceSight · Sees</span>
          <h1 class="spx-headline">
            <span class="wm"><span class="w" style="--i:0">See</span></span>{' '}
            <span class="wm"><span class="w" style="--i:1">what's</span></span>{' '}
            <span class="wm"><span class="w" style="--i:2">actually</span></span>{' '}
            <span class="wm"><span class="w" style="--i:3">happening</span></span>{' '}
            <span class="wm"><span class="w" style="--i:4">—</span></span>{' '}
            <span class="spx-ready"><span class="wm"><span class="w" style="--i:5">before</span></span>{' '}
            <span class="wm"><span class="w" style="--i:6">it</span></span>{' '}
            <span class="wm"><span class="w" style="--i:7">becomes</span></span>{' '}
            <span class="wm"><span class="w" style="--i:8">a</span></span>{' '}
            <span class="wm"><span class="w" style="--i:9">problem.</span></span></span>
          </h1>
          <p class="spx-subhead">SpaceSight turns raw physical-space data into real-time intelligence — built for teams who can't afford blind spots.</p>
          <div class="spx-hero-actions">
            <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="spacesight页hero Book a demo留资">Book a demo</button>
            <a class="btn btn-ghost btn-large" href="#stream">Ride the value stream</a>
          </div>
        </div>
        <div class="spx-hero-stage">
          <video src="/products/spacesight-demo-eng.mp4" poster="/products/spacesight-demo-poster.jpg" autoplay muted loop preload="metadata" playsinline aria-label="SpaceSight product demo — AI detection over a live retail floor"></video>
          <span class="viewfinder-corner viewfinder-corner-tl" aria-hidden="true" />
          <span class="viewfinder-corner viewfinder-corner-tr" aria-hidden="true" />
          <span class="viewfinder-corner viewfinder-corner-bl" aria-hidden="true" />
          <span class="viewfinder-corner viewfinder-corner-br" aria-hidden="true" />
          <span class="hud-chip hud-chip-live" aria-hidden="true"><span class="hud-live-dot" />LIVE</span>
          <span class="hud-chip hud-chip-zone" aria-hidden="true">ZERO-SHOT AI</span>
          <span class="hud-chip hud-chip-count" aria-hidden="true">24 / 7</span>
        </div>
      </div>
    </section>

    <!-- Value stream rail: the loop the brief implies, made explicit -->
    <section class="section section-tint spx-stream" id="stream" aria-label="The SpaceSight value stream">
      <div class="container">
        <div class="section-head center spx-stream-head">
          <h2>One stream of space intelligence.</h2>
          <p>Every frame becomes a finding, every finding an action — detection, retrieval, dispatch, and reporting on one continuous loop.</p>
        </div>
        <ol class="spx-rail">
          {streamBeats.map((b) => (
            <li class="spx-beat">
              <a class="spx-beat-link" href={b.href}>
                <span class="spx-beat-dot" aria-hidden="true" />
                <span class="spx-beat-n" aria-hidden="true">{b.n}</span>
                <span class="spx-beat-title">{b.title}</span>
                <span class="spx-beat-copy">{b.copy}</span>
                <span class="spx-beat-jump" aria-hidden="true">Read the chapter ↓</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Chapter 01 — Automated Detection & Audit -->
    <section class="section spx-cap" id="detect" aria-label="Automated Detection and Audit">
      <div class="container spx-cap-grid">
        <div class="spx-cap-rail" aria-hidden="true">
          <span class="spx-cap-index">01</span>
          <span class="spx-cap-line" />
          <span class="spx-cap-total">/ 03</span>
        </div>
        <article class="spx-cap-body">
          <span class="spx-cap-label">Automated Detection &amp; Audit</span>
          <h2 class="spx-cap-slogan">
            <span class="wm"><span class="w" style="--i:0">Catch</span></span>{' '}
            <span class="wm"><span class="w" style="--i:1">everything,</span></span>{' '}
            <span class="spx-ready"><span class="wm"><span class="w" style="--i:2">without</span></span>{' '}
            <span class="wm"><span class="w" style="--i:3">watching</span></span>{' '}
            <span class="wm"><span class="w" style="--i:4">everything.</span></span></span>
          </h2>
          <p class="spx-cap-text">SpaceSight audits your space continuously, using zero-shot AI detection that works the moment it's deployed — no training data, no setup lag. Just describe what to check in plain English and let it run.</p>
          <p class="spx-cap-text">The same detection engine that flags a compliance gap also catches loitering, unauthorized access, or checkout anomalies in real time — so whether you're auditing operations or preventing loss, nothing slips through unnoticed.</p>
          <div class="spx-motif">
            <p class="spx-motif-label">Plain-English audit — set once, runs forever</p>
            <p class="spx-motif-cmdline"><span class="spx-motif-prompt">›</span> "check aisle 3 shelves every 90 minutes"<span class="spx-cursor" aria-hidden="true" /></p>
            <ul class="spx-motif-chips">
              <li>Zero-shot detection</li>
              <li>No training data</li>
              <li>No setup lag</li>
            </ul>
          </div>
        </article>
      </div>
      <a class="spx-handoff container" href="#find">
        <span class="spx-handoff-dash" aria-hidden="true" />
        <span class="spx-handoff-text">Detected doesn't mean watched — <em>every flag is one question away.</em></span>
        <span class="spx-handoff-arrow" aria-hidden="true">↓</span>
      </a>
    </section>

    <!-- Chapter 02 — SpaceClaw: Ask & Find -->
    <section class="section spx-cap spx-cap-alt" id="find" aria-label="SpaceClaw Ask and Find">
      <div class="container spx-cap-grid spx-cap-flip">
        <div class="spx-cap-rail" aria-hidden="true">
          <span class="spx-cap-index">02</span>
          <span class="spx-cap-line" />
          <span class="spx-cap-total">/ 03</span>
        </div>
        <article class="spx-cap-body">
          <span class="spx-cap-label">SpaceClaw: Ask &amp; Find</span>
          <h2 class="spx-cap-slogan">
            <span class="wm"><span class="w" style="--i:0">Find</span></span>{' '}
            <span class="wm"><span class="w" style="--i:1">any</span></span>{' '}
            <span class="wm"><span class="w" style="--i:2">moment</span></span>{' '}
            <span class="spx-ready"><span class="wm"><span class="w" style="--i:3">in</span></span>{' '}
            <span class="wm"><span class="w" style="--i:4">seconds,</span></span></span>{' '}
            <span class="wm"><span class="w" style="--i:5">just</span></span>{' '}
            <span class="wm"><span class="w" style="--i:6">by</span></span>{' '}
            <span class="wm"><span class="w" style="--i:7">asking.</span></span>
          </h2>
          <p class="spx-cap-text">Describe what you're looking for in plain language, and SpaceClaw pulls the exact clip — no scrubbing through hours of footage. Investigating an incident, resolving a dispute, or just confirming what happened at a specific time: what used to take an afternoon now takes seconds.</p>
          <p class="spx-cap-text">And SpaceClaw doesn't just search on command — when it spots something on its own, it can dispatch a task straight to the right person's phone.</p>
          <div class="spx-motif">
            <p class="spx-motif-label">SpaceClaw query — ask, get the moment, act</p>
            <p class="spx-motif-cmdline"><span class="spx-motif-prompt">›</span> "show me the register between 2 and 3 pm"</p>
            <p class="spx-motif-result"><span class="spx-motif-dot" aria-hidden="true" />Clip ready · 14:12:08 – 14:12:31</p>
            <p class="spx-motif-result"><span class="spx-motif-dot spx-motif-dot-act" aria-hidden="true" />Task dispatched → floor lead's phone</p>
          </div>
        </article>
      </div>
      <a class="spx-handoff container" href="#report">
        <span class="spx-handoff-dash" aria-hidden="true" />
        <span class="spx-handoff-text">Found doesn't mean finished — <em>SpaceClaw can dispatch the fix itself.</em></span>
        <span class="spx-handoff-arrow" aria-hidden="true">↓</span>
      </a>
    </section>

    <!-- Chapter 03 — Intelligent Reporting -->
    <section class="section spx-cap" id="report" aria-label="Intelligent Reporting">
      <div class="container spx-cap-grid">
        <div class="spx-cap-rail" aria-hidden="true">
          <span class="spx-cap-index">03</span>
          <span class="spx-cap-line" />
          <span class="spx-cap-total">/ 03</span>
        </div>
        <article class="spx-cap-body">
          <span class="spx-cap-label">Intelligent Reporting</span>
          <h2 class="spx-cap-slogan">
            <span class="wm"><span class="w" style="--i:0">Your</span></span>{' '}
            <span class="wm"><span class="w" style="--i:1">daily</span></span>{' '}
            <span class="wm"><span class="w" style="--i:2">report,</span></span>{' '}
            <span class="spx-ready"><span class="wm"><span class="w" style="--i:3">ready</span></span>{' '}
            <span class="wm"><span class="w" style="--i:4">before</span></span>{' '}
            <span class="wm"><span class="w" style="--i:5">you</span></span>{' '}
            <span class="wm"><span class="w" style="--i:6">are.</span></span></span>
          </h2>
          <p class="spx-cap-text">SpaceSight turns what it sees into a clear, structured report — compliance rates, foot traffic, stock levels — delivered automatically, on schedule. No manual compilation, no waiting.</p>
          <p class="spx-cap-text">Beyond the numbers, it recommends what to do next: restock alerts, staffing adjustments, loss-prevention flags — so reports drive action instead of sitting unread in an inbox.</p>
          <div class="spx-motif">
            <p class="spx-motif-label">Daily report · 08:00 · auto-compiled</p>
            <dl class="spx-report">
              <div class="spx-report-row"><dt>Compliance rate</dt><dd>98.2%</dd></div>
              <div class="spx-report-row"><dt>Foot traffic</dt><dd>1,240 <span class="spx-report-delta">▲ 6% WoW</span></dd></div>
              <div class="spx-report-row"><dt>Stock alerts</dt><dd>3</dd></div>
              <div class="spx-report-row spx-report-next"><dt>Recommended</dt><dd>Restock aisle 3 before the 14:00 peak</dd></div>
            </dl>
          </div>
        </article>
      </div>
      <div class="spx-handoff spx-handoff-end container">
        <span class="spx-handoff-dash" aria-hidden="true" />
        <span class="spx-handoff-text">Reported doesn't mean read — <em>every report lands with what to do next.</em></span>
      </div>
    </section>

    <!-- Finale: the loop closes -->
    <section class="spx-finale" aria-label="Close the loop">
      <video class="spx-finale-video" src="/hero/spacesight-sees.mp4" poster="/hero/spacesight-sees-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video>
      <div class="spx-finale-scrim" aria-hidden="true" />
      <div class="container spx-finale-inner">
        <p class="spx-finale-verbs" aria-label="Detect. Find. Act. Report.">
          <span class="wm"><span class="w" style="--i:0">Detect.</span></span>
          <span class="wm"><span class="w" style="--i:1">Find.</span></span>
          <span class="wm"><span class="w" style="--i:2">Act.</span></span>
          <span class="wm"><span class="w" style="--i:3">Report.</span></span>
        </p>
        <p class="spx-finale-copy">One loop, always closing — detections become answers, answers become tasks, tasks become tomorrow's report. Nothing slips through; nothing sits unread.</p>
        <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="spacesight页finale Book a demo留资">Book a demo</button>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  (function () {
    'use strict';

    /* Section entrances: play the scan-in once when a block enters view */
    const liveObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-live');
          liveObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    document.querySelectorAll('.spx-hero-copy, .spx-stream-head, .spx-rail, .spx-cap-body, .spx-finale-inner').forEach((el) => liveObserver.observe(el));

    /* Video governance: honor reduced-motion (pause everything, posters stay),
       and pause decorative loops while offscreen. */
    const videos = Array.from(document.querySelectorAll('video'));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      videos.forEach((v) => {
        v.removeAttribute('autoplay');
        v.pause();
        if (!v.hasAttribute('poster')) {
          v.addEventListener('loadeddata', () => { try { v.currentTime = 0.01; } catch (e) {} }, { once: true });
        }
      });
      return;
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            const p = en.target.play();
            if (p && p.catch) p.catch(() => {});
          } else {
            en.target.pause();
          }
        });
      }, { rootMargin: '80px' });
      videos.forEach((v) => io.observe(v));
    }
  })();
</script>

<style>
  .spx-page {
    background: var(--bg);
  }

  /* ---------- Shared scan-in machinery (products-page pattern) ---------- */
  .wm {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .w {
    display: inline-block;
  }

  .spx-ready {
    color: var(--track-vision-ink, #A16207);
    background-image: linear-gradient(to top, rgba(255, 210, 63, 0.42) 36%, transparent 36%);
    background-repeat: no-repeat;
    background-size: 0% 100%;
  }

  .is-live .w {
    animation: spx-rise 0.65s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--i, 0) * 75ms + 60ms);
  }

  .is-live .spx-ready {
    transition: background-size 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.9s;
    background-size: 100% 100%;
  }

  .is-live .spx-chip,
  .is-live .spx-cap-label {
    animation: spx-word-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  /* Stream head + rail entrances — is-live lands on each element itself */
  .spx-stream-head.is-live h2,
  .spx-stream-head.is-live p {
    animation: spx-word-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .spx-stream-head.is-live p {
    animation-delay: 0.2s;
  }

  .spx-rail.is-live .spx-beat {
    animation: spx-word-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .spx-rail.is-live .spx-beat:nth-child(1) { animation-delay: 0s; }
  .spx-rail.is-live .spx-beat:nth-child(2) { animation-delay: 0.12s; }
  .spx-rail.is-live .spx-beat:nth-child(3) { animation-delay: 0.24s; }
  .spx-rail.is-live .spx-beat:nth-child(4) { animation-delay: 0.36s; }

  .is-live .spx-subhead,
  .is-live .spx-hero-actions,
  .is-live .spx-cap-text {
    animation: spx-word-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.5s backwards;
  }

  .is-live .spx-cap-text + .spx-cap-text {
    animation-delay: 0.62s;
  }

  .is-live .spx-motif {
    animation: spx-word-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.75s backwards;
  }

  @keyframes spx-rise {
    from { transform: translateY(110%); }
  }

  @keyframes spx-word-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-live .w,
    .is-live .spx-chip,
    .is-live .spx-cap-label,
    .is-live .spx-subhead,
    .is-live .spx-hero-actions,
    .is-live .spx-cap-text,
    .is-live .spx-motif,
    .is-live .spx-finale-copy,
    .is-live .spx-finale-verbs,
    .spx-stream-head.is-live h2,
    .spx-stream-head.is-live p,
    .spx-rail.is-live .spx-beat {
      animation: none;
    }

    .is-live .spx-ready {
      transition: none;
      background-size: 100% 100%;
    }
  }

  /* ---------- Hero ---------- */
  .spx-hero {
    padding: calc(var(--space-xl) + var(--header-height)) 0 var(--space-xl);
    background:
      radial-gradient(ellipse 70% 55% at 78% 30%, rgba(255, 210, 63, 0.1) 0%, transparent 60%),
      radial-gradient(circle at 70% 50%, var(--bg-tint) 0%, var(--bg) 60%);
    overflow: hidden;
  }

  .spx-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(var(--space-md), 4vw, var(--space-xl));
    align-items: center;
  }

  .spx-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    margin-bottom: var(--space-sm);
  }

  .spx-chip::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--track-vision);
    box-shadow: 0 0 10px rgba(255, 210, 63, 0.8);
  }

  .spx-headline {
    font-size: clamp(2.1rem, 4.6vw, 3.9rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    max-width: 20ch;
    margin-bottom: var(--space-sm);
  }

  .spx-subhead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 46ch;
    margin-bottom: var(--space-md);
  }

  .spx-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .spx-hero-actions .btn-primary {
    background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.1) inset, 0 6px 24px rgba(124, 58, 237, 0.45);
    animation: cta-pulse 2.4s ease-in-out infinite;
  }

  .spx-hero-actions .btn-primary:hover {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.15) inset, 0 8px 32px rgba(124, 58, 237, 0.6);
  }

  .spx-hero-stage {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-dark);
    aspect-ratio: 16 / 9;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.18);
  }

  .spx-hero-stage video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- Value stream rail ---------- */
  .spx-stream-head h2 {
    margin-inline: auto;
  }

  .spx-rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    counter-reset: beat;
  }

  .spx-beat {
    position: relative;
    padding-top: var(--space-md);
  }

  /* one continuous beam across the rail, broken per-beat at mobile */
  .spx-beat::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(15, 23, 42, 0.16);
  }

  .spx-beat-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
