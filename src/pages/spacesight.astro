<style>
  /* ---------------- Responsive: desktop pipeline serpentine ---------------- */
  @media (min-width: 1081px) {
    .ssx-pipes {
      display: block;
    }

    .ssx-nodes {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-md) var(--space-sm);
    }

    /* serpentine: row 2 runs right-to-left so the pipe flows 05 → 06 */
    .ssx-node:nth-child(6) { grid-column: 5; grid-row: 2; }
    .ssx-node:nth-child(7) { grid-column: 4; grid-row: 2; }
    .ssx-node:nth-child(8) { grid-column: 3; grid-row: 2; }
    .ssx-node:nth-child(9) { grid-column: 2; grid-row: 2; }
    .ssx-node:nth-child(10) { grid-column: 1; grid-row: 2; }

    .ssx-node::before,
    .ssx-node::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--dark);
      border: 2px solid var(--y);
      box-shadow: 0 0 8px rgba(255, 210, 63, 0.7);
      transform: translateY(-50%);
    }

    .ssx-node::before { left: -5px; }
    .ssx-node::after { right: -5px; }
  }

  @media (min-width: 721px) and (max-width: 1080px) {
    .ssx-nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------------- Mid ---------------- */
  @media (max-width: 1024px) {
    .ssx-hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .ssx-console {
      max-width: 760px;
    }

    .ssx-about-grid,
    .ssx-scale-grid,
    .ssx-sec6-grid {
      grid-template-columns: 1fr;
    }

    .ssx-units {
      grid-template-columns: 1fr;
    }

    .ssx-rack-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------------- Mobile ---------------- */
  @media (max-width: 720px) {
    .ssx {
      padding-top: calc(var(--header-height) + 18px);
    }

    .ssx-hero {
      padding: var(--space-md) 0 var(--space-lg);
      background-size: 44px 44px;
    }

    .ssx-h1 {
      font-size: clamp(1.75rem, 8.4vw, 2.3rem);
      max-width: none;
    }

    .ssx-hero-cta .btn {
      flex: 1 1 auto;
      padding-inline: 1rem;
      white-space: nowrap;
    }

    .ssx-proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm) var(--space-md);
    }

    .ssx-console-bar {
      font-size: 0.58rem;
      gap: 0.5rem;
    }

    .ssx-console-name {
      display: none;
    }

    .ssx-vc {
      width: 15px;
      height: 15px;
    }

    .ssx-vc-tl { top: 8px; left: 8px; }
    .ssx-vc-tr { top: 8px; right: 8px; }
    .ssx-vc-bl { bottom: 8px; left: 8px; }
    .ssx-vc-br { bottom: 8px; right: 8px; }

    .ssx-telemetry {
      grid-template-columns: 1fr;
    }

    .ssx-telemetry > div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-sm);
      padding: 0.65rem 0.75rem;
      border-left: none;
      border-top: 1px solid rgba(248, 247, 244, 0.1);
    }

    .ssx-telemetry > div:first-child {
      border-top: none;
    }

    .ssx-telemetry dt {
      margin-bottom: 0;
    }

    .ssx-figcap-alt {
      display: none;
    }

    .ssx-sec {
      padding: var(--space-lg) 0;
    }

    .ssx-ruler {
      gap: 0.6rem;
      margin-bottom: var(--space-md);
    }

    .ssx-ruler-name {
      font-size: 0.85rem;
      letter-spacing: 0.1em;
      /* long names (e.g. SEC.03) overflowed the viewport when nowrap */
      white-space: normal;
      text-align: right;
      text-wrap: balance;
    }

    .ssx-ruler-line {
      flex: 1 0 24px;
    }

