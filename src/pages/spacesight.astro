---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.whale.sg/spacesight/';
const pageDescription = 'SpaceSight turns existing cameras into real-time operational intelligence, helping teams improve compliance, customer flow, and store performance across every location.';

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'SpaceSight', item: canonicalUrl }
    ]
  }
];

const headlineBase = 'Physical Operations Intelligence for'.split(' ');
const headlineTail = 'Better Compliance, Customer Flow, and Store Performance'.split(' ');

const heroProof = [
  { n: '1,600+', label: 'Enterprise clients' },
  { n: '45+', label: 'Countries deployed' },
  { n: '600,000+', label: 'Edge AI nodes globally' }
];

const procedures = [
  {
    id: 'proc-a',
    ref: 'A',
    name: 'Audit Every Site Consistently',
    tags: 'AI Audit Platform · Automated Compliance Audit',
    paras: [
      'Replace manual checks with consistent, visual compliance workflows.'
    ],
    checksIntro: 'Monitor standards such as:',
    checks: ['Queue conditions', 'Cleanliness', 'Display execution', 'Safety procedures', 'Merchandising', 'SOP compliance'],
    checksTail: 'Across every site, every day.'
  },
  {
    id: 'proc-b',
    ref: 'B',
    name: 'Understand Customer Movement',
    tags: 'Retail Video Analytics · Customer Flow Analytics',
    metricsIntro: 'SpaceSight measures:',
    metrics: ['Footfall', 'Passerby rate', 'Entry rate', 'Dwell time', 'Conversion', 'Queueing', 'Traffic patterns'],
    metricsTail: 'By store, zone, or campaign.',
    paras: [
      'Privacy-conscious video analysis uses non-biometric signals such as body shape, gait, and clothing, not facial recognition.'
    ],
    outcomesIntro: 'These insights help teams improve:',
    outcomes: ['Staffing', 'Layouts', 'Campaign evaluation', 'Store optimization', 'Space optimization'],
    outcomesTail: 'With real behavioral data.'
  },
  {
    id: 'proc-c',
    ref: 'C',
    name: 'Turn Insights Into Action',
    tags: 'Enterprise AIOS · Agent Orchestration · SpaceClaw',
    paras: [
      'SpaceClaw connects analytics with action. Teams can ask operational questions such as:'
    ],
    queries: ['Why did conversion drop yesterday?', 'Which stores showed abnormal dwell time?'],
    actionsIntro: 'SpaceSight acts — automatically:',
    actions: ['Retrieves relevant footage', 'Identifies possible root causes', 'Creates work orders', 'Dispatches follow-up tasks', 'Generates operational reports'],
    actionsTail: 'Agent orchestration creates a closed operational loop — from detection to resolution.'
  }
];

const hwIcons = {
  camera: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="12" height="7" rx="1"/><circle cx="9" cy="10.5" r="1.8"/><path d="M15 9.3l5-1.8v6l-5-1.8M7.5 14v3.2M5 17.2h5"/></svg>',
  videoHub: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="10" width="18" height="7" rx="1"/><path d="M6.5 13.5h.01M9.5 13.5h.01M12.5 13.5h.01"/><path d="M16 12.2v2.6M18.6 12.2v2.6"/><path d="M12 10V5.5m0 0L10.4 7.1M12 5.5l1.6 1.6"/></svg>',
  aiHub: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="1.5"/><rect x="10.2" y="10.2" width="3.6" height="3.6" rx="0.5"/><path d="M9.5 7V4m2.5 3V4m2.5 3V4M9.5 20v-3m2.5 3v-3m2.5 3v-3M7 9.5H4m3 2.5H4m3 2.5H4M20 9.5h-3m3 2.5h-3m3 2.5h-3"/></svg>',
  edgeCam: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="12" height="8" rx="1.5"/><circle cx="9" cy="13" r="2.2"/><path d="M15 11.3l5-1.8v7l-5-1.8"/><path d="M18.6 2.8l.55 1.5 1.5.55-1.5.55-.55 1.5-.55-1.5-1.5-.55 1.5-.55z" fill="currentColor" stroke="none"/></svg>',
  hybrid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="10.5" height="10.5" rx="1.5" stroke-dasharray="3.2 2.6"/><rect x="9.5" y="9.5" width="11" height="11" rx="1.5"/></svg>'
};

const hardware = [
  { icon: 'camera', name: 'Existing cameras', desc: 'Reuse current CCTV, NVR, and VMS infrastructure as the signal source.' },
  { icon: 'videoHub', name: 'Video Hub', desc: 'Aggregates and routes video streams where coverage needs to expand.' },
  { icon: 'aiHub', name: 'AI Hub', desc: 'On-premises edge AI processing for video analytics at the site.' },
  { icon: 'edgeCam', name: 'Edge AI Camera', desc: 'Cameras with onboard AI processing for new or upgraded zones.' },
  { icon: 'hybrid', name: 'Hybrid deployment', desc: 'A mix assessed per site — coverage, network, and use cases decide.' }
];

const deploySteps = [
  { n: '1', name: 'Assess', body: 'Review site layout, camera placement, network conditions, priority use cases, and success metrics, from footfall and dwell time to loss prevention and AI inspection.' },
  { n: '2', name: 'Connect', body: 'Reuse existing CCTV, NVR, and VMS infrastructure where possible. Add Edge AI Cameras, AI Hub, or Video Hub where coverage or local processing needs to expand.' },
  { n: '3', name: 'Configure', body: 'Set up camera channels, AI models, zones of interest, thresholds, and business rules for workflows such as customer flow analytics, queue detection, table-cleaning inspection, and compliance audit.' },
  { n: '4', name: 'Optimize', body: 'Validate with real site footage, monitor device and stream health, then fine-tune camera angles, zones, thresholds, and AI configurations as operations evolve.' }
];

const certs = [
  { src: '/cert-logos/soc2.png', alt: 'SOC 2 Type II', label: 'SOC 2 Type II' },
  { src: '/cert-logos/gdpr.png', alt: 'GDPR Compliant', label: 'GDPR Compliant' },
  { src: '/cert-logos/iso27001.jpg', alt: 'ISO 27001', label: 'ISO 27001' },
  { src: '/cert-logos/iso9001.jpg', alt: 'ISO 9001', label: 'ISO 9001' },
  { src: '/cert-logos/cmmi.jpg', alt: 'CMMI Level 5', label: 'CMMI Level 5' }
];

const tabs = [
  { id: 'cover', label: 'COVER' },
  { id: 'proc-a', label: 'A·AUDIT' },
  { id: 'proc-b', label: 'B·FLOW' },
  { id: 'proc-c', label: 'C·ACT' },
  { id: 'visibility', label: 'VISION' },
  { id: 'deployment', label: 'DEPLOY' },
  { id: 'security', label: 'TRUST' },
  { id: 'faq', label: 'FAQ' }
];
---

<Layout
  title="SpaceSight | Physical Operations Intelligence Platform"
  description={pageDescription}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main class="ss2">
    <!--
      DIRECTION CONTRACT — /spacesight2/
      THESIS: the page is SpaceSight's own field manual — the product audits SOP
        compliance and operational procedure, so the surface takes the form of the
        procedure document its buyer lives inside. Refuses the standard
        hero-plus-alternating-features landing grid.
      OWN-WORLD: company blue #2563EB on vacuum white, Poppins display / Manrope
        body / Space Mono for doc-control, figure captions, and spec data. Figure
        plates with mono caption strips, ledger hairlines, stamp-style result
        lines, fore-edge tab rail.
      STORY: an operations leader reads cover (offer + proof) → three procedures
        (audit, flow, act) → why footage is not intelligence → deployment hardware
        → four-step rollout → trust and compliance → FAQ → book a demo.
      FIRST VIEWPORT: doc-control strip across the top (DOC SS-OPS-01 · REV
        2026.09 · FIELD MANUAL), title block left with blue-highlighted key
        phrases, FIG.00 plate right (AI Audit capture), proof ledger below,
        Book a Demo primary + See Use Cases ghost.
      FORM: field manual / spec-sheet — candidate 4 of the grounded list, seed
        key 77fc822f; acetate-tab challenger fused as the fore-edge tab rail.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
        finish review, the verdict, and DESIGN.md.
    -->

    <!-- ================= COVER ================= -->
    <section class="section ss2-cover" id="cover" data-tab="cover">
      <div class="container">
        <div class="ss2-doc" data-reveal>
          <span class="ss2-doc-title"><span class="ss2-doc-mark" aria-hidden="true"></span>SpaceSight <span class="ss2-doc-sep" aria-hidden="true">·</span> Field Manual</span>
          <span>DOC SS-OPS-01 · REV 2026.09</span>
        </div>

        <div class="ss2-cover-grid">
          <div class="ss2-cover-copy">
            <h1 class="ss2-h1" data-ss2-head>
              {headlineBase.map((word, i) => (
                <Fragment><span class="wm"><span class="w" style={`--i:${i}`}>{word}</span></span>{' '}</Fragment>
              ))}
              <span class="ss2-tail">
                {headlineTail.map((word, i) => (
                  <Fragment><span class="wm"><span class="w" style={`--i:${i + 4}`}>{word}</span></span>{' '}</Fragment>
                ))}
              </span>
            </h1>
            <div class="ss2-cover-cta" data-reveal style="--i:9">
              <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="spacesight2页-Hero留资">Book a Demo</button>
              <a href="/user-cases/" class="btn btn-ghost btn-large">See Use Cases</a>
            </div>
          </div>

          <figure class="ss2-plate" data-reveal style="--i:5">
            <div class="ss2-plate-media">
              <picture>
                <source srcset="/products/ss2-ai-audit.webp" type="image/webp" />
                <img src="/products/ss2-ai-audit.png" alt="SpaceSight AI audit interface reviewing store compliance on live camera footage" width="1376" height="768" loading="eager" decoding="async" />
              </picture>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. 00</span><span>AI audit pass — exception flagged, evidence attached</span></figcaption>
          </figure>
        </div>

        <dl class="ss2-proof" data-reveal style="--i:10">
          {heroProof.map((p) => (
            <div class="ss2-proof-cell">
              <dt>{p.label}</dt>
              <dd>{p.n.replace(/\+$/, '')}{p.n.endsWith('+') && <span class="ss2-proof-plus">+</span>}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ================= PART 01 · OPERATING PROCEDURES ================= -->
    <section class="section section-tint ss2-part" aria-labelledby="ss2-part1">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 01 — Operating Procedures</span>
          <h2 class="ss2-h2" id="ss2-part1">One Platform for Insight and Action</h2>
        </header>

        <!-- PROC A -->
        <article class="ss2-proc" id="proc-a" data-tab="proc-a">
          <div class="ss2-proc-copy" data-reveal>
            <header class="ss2-proc-head">
              <h3 class="ss2-h3">{procedures[0].name}</h3>
              <p class="ss2-tags">{procedures[0].tags}</p>
            </header>
            {procedures[0].paras.map((t) => <p class="ss2-body">{t}</p>)}
            <p class="ss2-mon-label">{procedures[0].checksIntro}</p>
            <ul class="ss2-checks">
              {procedures[0].checks.map((c) => <li>{c}</li>)}
            </ul>
            <p class="ss2-mon-tail">{procedures[0].checksTail}</p>
          </div>
          <figure class="ss2-plate ss2-fig" data-reveal>
            <div class="ss2-plate-media ss2-fig-media">
              <picture>
                <source srcset="/products/ss2-audit-vlm.webp" type="image/webp" />
                <img src="/products/ss2-audit-vlm.png" alt="SpaceSight VLM model builder — human fall detector scenario with trial-run test results all matched" width="1600" height="938" loading="lazy" decoding="async" />
              </picture>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. A</span><span>VLM scenario audit — live product view</span></figcaption>
          </figure>
        </article>

        <!-- PROC B -->
        <article class="ss2-proc ss2-proc-flip" id="proc-b" data-tab="proc-b">
          <div class="ss2-proc-copy" data-reveal>
            <header class="ss2-proc-head">
              <h3 class="ss2-h3">{procedures[1].name}</h3>
              <p class="ss2-tags">{procedures[1].tags}</p>
            </header>
            <p class="ss2-mon-label">{procedures[1].metricsIntro}</p>
            <ul class="ss2-chips ss2-chips--measure">
              {procedures[1].metrics.map((m) => <li>{m}</li>)}
            </ul>
            <p class="ss2-mon-tail">{procedures[1].metricsTail}</p>
            {procedures[1].paras.map((t) => <p class="ss2-body">{t}</p>)}
            <p class="ss2-mon-label">{procedures[1].outcomesIntro}</p>
            <ul class="ss2-chips ss2-chips--outcome">
              {procedures[1].outcomes.map((o) => <li>{o}</li>)}
            </ul>
            <p class="ss2-mon-tail">{procedures[1].outcomesTail}</p>
          </div>
          <figure class="ss2-plate ss2-fig" data-reveal>
            <div class="ss2-plate-media ss2-fig-media">
              <picture>
                <source srcset="/products/ss2-flow-heatmap.webp" type="image/webp" />
                <img src="/products/ss2-flow-heatmap.png" alt="SpaceSight heatmap analysis showing dwell time by zone on a store floor plan" width="1600" height="1004" loading="lazy" decoding="async" />
              </picture>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. B</span><span>Heatmap analysis — dwell time by zone, live product view</span></figcaption>
          </figure>
        </article>

        <!-- PROC C -->
        <article class="ss2-proc" id="proc-c" data-tab="proc-c">
          <div class="ss2-proc-copy" data-reveal>
            <header class="ss2-proc-head">
              <h3 class="ss2-h3">{procedures[2].name}</h3>
              <p class="ss2-tags">{procedures[2].tags}</p>
            </header>
            {procedures[2].paras.map((t) => <p class="ss2-body">{t}</p>)}
            <ul class="ss2-queries">
              {procedures[2].queries.map((q) => <li>{q}</li>)}
            </ul>
            <p class="ss2-mon-label">{procedures[2].actionsIntro}</p>
            <ol class="ss2-chain">
              {procedures[2].actions.map((a, i) => <li><span class="ss2-chain-no">{String(i + 1).padStart(2, '0')}</span>{a}</li>)}
            </ol>
            <p class="ss2-mon-tail">{procedures[2].actionsTail}</p>
          </div>
          <figure class="ss2-plate ss2-plate-phone" data-reveal>
            <div class="ss2-plate-media">
              <video src="/products/ss2-spaceclaw-app.mp4" poster="/products/ss2-spaceclaw-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="SpaceSight mobile app — SpaceClaw operational assistant in use" style="aspect-ratio: 720/1558"></video>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. C</span><span>SpaceClaw on mobile — ask, retrieve, dispatch</span></figcaption>
          </figure>
        </article>
      </div>
    </section>

    <!-- ================= PART 02 · VISIBILITY ================= -->
    <section class="section ss2-part" id="visibility" data-tab="visibility" aria-labelledby="ss2-vis-h">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 02 — Visibility</span>
          <h2 class="ss2-h2" id="ss2-vis-h">From Passive Cameras to Actionable Operations</h2>
        </header>

        <div class="ss2-vis-grid">
          <figure class="ss2-plate" data-reveal>
            <div class="ss2-plate-media">
              <video src="/products/ss2-visibility.mp4" poster="/products/ss2-visibility-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="SpaceSight platform demo — natural-language video search across cameras"></video>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. 02</span><span>Video search — ask in plain language, get footage back</span></figcaption>
          </figure>
          <div class="ss2-vis-copy" data-reveal>
            <p class="ss2-lede">Most monitoring systems only record what happened. SpaceSight helps teams understand <strong>what is happening, why it matters, and what to do next.</strong></p>
            <p class="ss2-body">Built for physical operations intelligence, SpaceSight connects with existing CCTV, AI cameras, sensors, and edge AI devices to turn video and sensor data into real-time insights for store operations, loss prevention, compliance, and customer experience.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PART 03 · DEPLOYMENT ================= -->
    <section class="section section-tint ss2-part" id="deployment" data-tab="deployment" aria-labelledby="ss2-dep-h">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 03 — Deployment</span>
          <h2 class="ss2-h2" id="ss2-dep-h">Built for Real-World Deployment</h2>
          <p class="ss2-body ss2-part-lede">SpaceSight works with existing CCTV, NVR/VMS systems, AI Hub, Video Hub, Edge AI Cameras, or hybrid deployments. Our team assesses camera coverage, network readiness, target use cases, and rollout priorities before recommending the right setup.</p>
        </header>

        <div class="ss2-ledger ss2-ledger-hw" data-reveal>
          <p class="ss2-ledger-head"><span>HW</span><span>Option</span><span>Role in deployment</span></p>
          {hardware.map((h) => (
            <div class="ss2-ledger-row">
              <span class="ss2-ledger-ic" set:html={hwIcons[h.icon]} />
              <span class="ss2-ledger-name">{h.name}</span>
              <span class="ss2-ledger-desc">{h.desc}</span>
            </div>
          ))}
        </div>

        <h3 class="ss2-h3 ss2-steps-h" data-reveal>Deployment and Continuous Optimization</h3>
        <ol class="ss2-steps" data-reveal>
          {deploySteps.map((s) => (
            <li class="ss2-step">
              <span class="ss2-step-no">Step {s.n}</span>
              <span class="ss2-step-name">{s.name}</span>
              <p class="ss2-step-body">{s.body}</p>
            </li>
          ))}
        </ol>
        <aside class="ss2-note" data-reveal aria-label="Deployment guidance">
          <span class="ss2-note-tag">Note — Deployment Guidance</span>
          <div class="ss2-note-text">
            <p class="ss2-note-q">Not sure what your site needs?</p>
            <p class="ss2-note-a">Book a demo and we will help assess your deployment path.</p>
          </div>
          <button type="button" class="btn btn-primary ss2-note-btn" data-open-modal data-source-type="spacesight2页-部署咨询留资">Book a demo</button>
        </aside>
      </div>
    </section>

    <!-- ================= PART 04 · TRUST ================= -->
    <section class="section ss2-part" id="security" data-tab="security" aria-labelledby="ss2-sec-h">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 04 — Trust</span>
          <h2 class="ss2-h2" id="ss2-sec-h">Security, Privacy, and Compliance by Design</h2>
        </header>

        <div class="ss2-ledger ss2-ledger-trust" data-reveal>
          <p class="ss2-ledger-head"><span>Provision</span><span>What it means</span></p>
          <div class="ss2-ledger-row">
            <span class="ss2-ledger-name">No Facial Recognition</span>
            <span class="ss2-ledger-desc">People tracking uses non-biometric re-identification signals, not facial recognition.</span>
          </div>
          <div class="ss2-ledger-row">
            <span class="ss2-ledger-name">Edge AI Processing</span>
            <span class="ss2-ledger-desc">Video can be processed locally on AI Hub or Edge AI Camera. Only metadata, analytics, and anomaly events need to be sent to the cloud, reducing bandwidth use by up to 80%.</span>
          </div>
          <div class="ss2-ledger-row">
            <span class="ss2-ledger-name">Enterprise-Grade Standards</span>
            <span class="ss2-ledger-desc">Certified and audited against the standards enterprise IT and legal teams ask for.</span>
          </div>
        </div>

        <ul class="ss2-certs" data-reveal>
          {certs.map((c) => (
            <li class="ss2-cert">
              <img src={c.src} alt={c.alt} width="120" height="60" loading="lazy" decoding="async" />
              <span>{c.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <div data-tab="faq">
      <FAQSection />
    </div>

    <!-- ================= CLOSING ================= -->
    <CTASection
      headline="Physical Operations Intelligence for Better Compliance, Customer Flow, and Store Performance."
      lead="See what your existing cameras can tell you."
      primaryLabel="Book a Demo"
      sourceType="spacesight2页-底部留资"
      secondaryLabel="See Use Cases"
      secondaryHref="/user-cases/"
    />

    <!-- fore-edge tab rail (inside .ss2 for token scope) -->
    <nav class="ss2-tabs" aria-label="Manual sections">
      {tabs.map((t) => (
        <a href={`#${t.id}`} class="ss2-tab" data-tab-link={t.id}>{t.label}</a>
      ))}
    </nav>
  </main>
  <Footer />
</Layout>

<style>
  /* ===== world tokens (company blue on daylight) ===== */
  .ss2 {
    --ss2-blue: #2563EB;
    --ss2-blue-ink: #1D4ED8;
    --ss2-blue-soft: #EFF4FF;
    --ss2-rule: color-mix(in srgb, var(--text) 14%, transparent);
  }

  /* ===== doc-control strip ===== */
  .ss2-doc {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ss2-blue-ink);
    border-bottom: 1px solid var(--ss2-rule);
    padding-bottom: 0.9rem;
    margin-bottom: 3rem;
  }
  /* controlled-document stamp */
  .ss2-doc-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 0.95em;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--ss2-blue-ink);
    border: 1.5px solid var(--ss2-blue);
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.18);
    animation: ss2-stamp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.35s backwards;
  }
  .ss2-doc-mark {
    width: 0.55em;
    height: 0.55em;
    background: var(--ss2-blue);
    flex-shrink: 0;
  }
  .ss2-doc-sep {
    color: var(--ss2-blue);
    margin-inline: -0.2em;
  }
  @keyframes ss2-stamp {
    from {
      opacity: 0;
      transform: scale(1.28) rotate(-1.2deg);
    }
    60% {
      opacity: 1;
      transform: scale(0.97) rotate(0.2deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ===== cover ===== */
  .ss2-cover {
    padding-top: 7rem;
  }

  .ss2-cover-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: stretch;
  }

  /* hero plate stretches: top flush with headline, bottom flush with CTAs */
  .ss2-cover-grid .ss2-plate {
    display: flex;
    flex-direction: column;
  }
  .ss2-cover-grid .ss2-plate-media {
    flex: 1;
    min-height: 0;
  }
  .ss2-cover-grid .ss2-plate-media img {
    height: 100%;
    object-fit: cover;
  }

  .ss2-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 3.8vw, 3.5rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    max-width: 17ch;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }

  /* tail line: blue + blinking block cursor (spacesight v1 convention) */
  .ss2-tail {
    display: block;
    color: var(--ss2-blue-ink);
  }
  .ss2-tail::after {
    content: '';
    display: inline-block;
    width: 0.42em;
    height: 0.82em;
    margin-left: 0.16em;
    transform: translateY(0.09em);
    background: var(--ss2-blue);
    animation: ss2-blink 1.15s steps(1) infinite;
  }
  @keyframes ss2-blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  /* word-mask reveal (company page convention) */
  .ss2-h1 .wm {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding: 0.12em 0.02em 0.1em 0;
    margin: -0.12em -0.02em -0.1em 0;
  }
  .ss2-h1 .w {
    display: inline-block;
    transform: translateY(110%);
    animation: ss2-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i) * 45ms);
  }
  @keyframes ss2-rise {
    to { transform: translateY(0); }
  }

  .ss2-cover-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* ===== figure plates ===== */
  .ss2-plate {
    margin: 0;
    background: var(--bg-elevated);
    border: 1px solid var(--ss2-rule);
    padding: 0.65rem;
    position: relative;
  }
  /* plate corner ticks */
  .ss2-plate::before,
  .ss2-plate::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--ss2-blue);
    border-style: solid;
  }
  .ss2-plate::before {
    top: -1px; left: -1px;
    border-width: 2px 0 0 2px;
  }
  .ss2-plate::after {
    bottom: -1px; right: -1px;
    border-width: 0 2px 2px 0;
  }

  .ss2-plate-media {
    overflow: hidden;
    background: var(--bg-tint);
  }
  .ss2-plate-media img,
  .ss2-plate-media video {
    display: block;
    width: 100%;
    height: auto;
  }

  .ss2-plate-cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .ss2-plate-cap span:first-child {
    color: var(--ss2-blue-ink);
    white-space: nowrap;
  }

  .ss2-plate-phone {
    max-width: 300px;
    margin-left: auto;
  }

  /* ===== proof ledger ===== */
  .ss2-proof {
    margin: 4rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ss2-rule);
    border-bottom: 1px solid var(--ss2-rule);
  }
  .ss2-proof-cell {
    padding: 1.8rem 1.8rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    position: relative;
    transition: background 0.3s ease;
  }
  .ss2-proof-cell::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.8rem;
    width: 2.2rem;
    height: 3px;
    background: var(--ss2-blue);
  }
  .ss2-proof-cell + .ss2-proof-cell {
    border-left: 1px solid var(--ss2-rule);
  }
  .ss2-proof-cell:hover {
    background: var(--ss2-blue-soft);
  }
  .ss2-proof-cell dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    order: 2;
  }
  .ss2-proof-cell dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(2.3rem, 4.6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    order: 1;
    transition: color 0.3s ease;
  }
  .ss2-proof-cell:hover dd {
    color: var(--ss2-blue-ink);
  }
  .ss2-proof-plus {
    color: var(--ss2-blue);
    font-size: 0.62em;
    margin-left: 0.14em;
    vertical-align: 0.34em;
    letter-spacing: 0;
  }

  /* ===== part heads ===== */
  .ss2-part-head {
    margin-bottom: 3.5rem;
    max-width: 52rem;
  }
  .ss2-part-no {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ss2-blue-ink);
    border: 1px solid color-mix(in srgb, var(--ss2-blue) 45%, transparent);
    padding: 0.35rem 0.7rem;
    margin-bottom: 1.25rem;
  }
  .ss2-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 0;
    text-wrap: balance;
  }
  @media (min-width: 900px) {
    #ss2-dep-h {
      white-space: nowrap;
      text-wrap: none;
      max-width: none;
      font-size: clamp(1.5rem, 3vw, 2.5rem);
    }
  }
  .ss2-part-lede {
    margin-top: 1.25rem;
  }

  /* ===== procedures ===== */
  .ss2-proc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 3rem 0;
    border-top: 1px solid var(--ss2-rule);
  }
  .ss2-proc-flip .ss2-proc-copy {
    order: 2;
  }
  .ss2-proc-flip .ss2-plate {
    order: 1;
  }
  .ss2-h3 {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.6rem;
  }
  .ss2-tags {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ss2-blue-ink);
    margin: 0 0 1.5rem;
  }
  .ss2-body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 68ch;
    margin: 0 0 1rem;
  }
  .ss2-mon-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 1.6rem 0 0.7rem;
  }
  .ss2-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    max-width: 34rem;
  }
  .ss2-checks li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.8rem;
    background: var(--bg-elevated, #fff);
    border: 1px solid var(--ss2-rule);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ss2-checks li::before {
    content: '';
    flex-shrink: 0;
    width: 0.72rem;
    height: 0.72rem;
    border: 1.5px solid var(--ss2-blue);
    border-radius: 2px;
    transition: background 0.25s ease;
  }
  .ss2-checks li::after {
    content: '';
    position: absolute;
    left: calc(0.8rem + 0.16rem);
    top: 50%;
    width: 0.4rem;
    height: 0.22rem;
    border-left: 1.5px solid #fff;
    border-bottom: 1.5px solid #fff;
    transform: translateY(-70%) rotate(-45deg) scale(0);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ss2-checks li:hover {
    border-color: var(--ss2-blue);
    transform: translateY(-1px);
  }
  .ss2-checks li:hover::before {
    background: var(--ss2-blue);
  }
  .ss2-checks li:hover::after {
    transform: translateY(-70%) rotate(-45deg) scale(1);
  }
  .ss2-mon-tail {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin: 0.7rem 0 1rem;
  }
  .ss2-mon-tail::before {
    content: '— ';
    color: var(--ss2-blue);
  }
  /* signal/outcome chips (proc B): same ledger-cell family as checks, different markers */
  .ss2-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ss2-chips li {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.8rem;
    background: var(--bg-elevated, #fff);
    border: 1px solid var(--ss2-rule);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ss2-chips li:hover {
    border-color: var(--ss2-blue);
    transform: translateY(-1px);
  }
  .ss2-chips--measure li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--ss2-blue);
    flex-shrink: 0;
  }
  .ss2-chips--outcome li::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border-top: 2px solid var(--ss2-blue);
    border-right: 2px solid var(--ss2-blue);
    transform: rotate(45deg);
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ss2-chips--outcome li:hover::before {
    transform: rotate(45deg) translate(1px, -1px);
  }
  @media (max-width: 640px) {
    .ss2-checks { grid-template-columns: 1fr; max-width: none; }
    .ss2-chips { gap: 0.4rem; }
  }
  /* proc C: example queries as quote cards */
  .ss2-queries {
    list-style: none;
    margin: 0.4rem 0 1.4rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 34rem;
  }
  .ss2-queries li {
    position: relative;
    padding: 0.7rem 1rem 0.7rem 2.6rem;
    background: var(--bg-elevated, #fff);
    border: 1px solid var(--ss2-rule);
    border-radius: 6px;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--text);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .ss2-queries li::before {
    content: '\201C';
    position: absolute;
    left: 0.9rem;
    top: 0.28rem;
    font-family: var(--font-mono);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ss2-blue);
  }
  .ss2-queries li:hover {
    border-color: var(--ss2-blue);
    transform: translateY(-1px);
  }
  /* proc C: action chain */
  .ss2-chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    max-width: 34rem;
    border-top: 1px solid var(--ss2-rule);
  }
  .ss2-chain li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.6rem 0.25rem;
    border-bottom: 1px solid var(--ss2-rule);
    font-size: 0.98rem;
    color: var(--text);
  }
  .ss2-chain-no {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ss2-blue-ink);
    flex-shrink: 0;
    min-width: 1.6em;
  }
  .ss2-lede {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.5;
    color: var(--text);
    margin: 0 0 1.25rem;
    text-wrap: pretty;
  }
  .ss2-lede strong {
    color: var(--ss2-blue-ink);
    font-weight: 600;
  }

  /* figure plates: padded matte around screenshots */
  .ss2-fig-media {
    padding: 1rem;
  }

  /* ===== visibility ===== */
  .ss2-vis-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: stretch;
  }
  /* video plate fills the copy column's height; video crops to fit */
  .ss2-vis-grid .ss2-plate {
    display: flex;
    flex-direction: column;
  }
  .ss2-vis-grid .ss2-plate-media {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  .ss2-vis-grid .ss2-plate-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ===== ledgers ===== */
  .ss2-ledger {
    border-top: 1px solid var(--ss2-rule);
    margin-bottom: 3.5rem;
  }
  .ss2-ledger-head,
  .ss2-ledger-row {
    display: grid;
    grid-template-columns: 5.5rem 14rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--ss2-rule);
    margin: 0;
  }
  .ss2-ledger-head {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .ss2-ledger-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ss2-blue-ink);
    border: 1px solid var(--ss2-rule);
    border-radius: 8px;
    background: var(--bg);
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .ss2-ledger-ic svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .ss2-ledger-row:hover .ss2-ledger-ic {
    border-color: var(--ss2-blue);
    background: var(--ss2-blue-soft);
  }
  /* trust ledger: two columns, no ref column */
  .ss2-ledger-trust .ss2-ledger-head,
  .ss2-ledger-trust .ss2-ledger-row {
    grid-template-columns: 14rem 1fr;
  }
  /* hardware rows: icon column + name + role, vertically centered */
  .ss2-ledger-hw .ss2-ledger-row {
    align-items: center;
  }
  .ss2-ledger-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
  }
  .ss2-ledger-desc {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  /* ===== deployment steps ===== */
  .ss2-steps-h {
    margin-bottom: 1.75rem;
  }
  .ss2-steps {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    border-top: 1px solid var(--ss2-rule);
    counter-reset: ss2step;
  }
  .ss2-step {
    display: grid;
    grid-template-columns: 6rem 11rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0.25rem;
    border-bottom: 1px solid var(--ss2-rule);
    align-items: baseline;
  }
  .ss2-step-no {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ss2-blue-ink);
  }
  .ss2-step-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .ss2-step-body {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.98rem;
    max-width: 68ch;
  }
  /* deployment guidance note — manual "NOTE" panel */
  .ss2-note {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 1.75rem 2rem;
    background: var(--ss2-blue-soft);
    border: 1px solid color-mix(in srgb, var(--ss2-blue) 22%, transparent);
    transition: border-color 0.25s ease;
  }
  .ss2-note:hover {
    border-color: color-mix(in srgb, var(--ss2-blue) 45%, transparent);
  }
  .ss2-note-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--ss2-blue);
    padding: 0.35rem 0.7rem;
    white-space: nowrap;
  }
  .ss2-note-q {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 0.25rem;
  }
  .ss2-note-a {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .ss2-note-btn {
    white-space: nowrap;
  }

  /* ===== certs ===== */
  .ss2-certs {
    list-style: none;
    margin: 0;
    padding: 2.25rem 0 0;
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 4rem;
    align-items: center;
  }
  .ss2-cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    flex: 0 1 auto;
  }
  .ss2-cert img {
    height: 84px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.85;
    transition: filter 0.25s ease, opacity 0.25s ease;
  }
  .ss2-cert:hover img {
    filter: none;
    opacity: 1;
  }
  .ss2-cert span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  /* ===== fore-edge tab rail ===== */
  .ss2-tabs {
    position: fixed;
    right: 0;
    top: calc(50% + var(--header-height, 60px) / 2);
    transform: translateY(-50%);
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ss2-tab {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--ss2-rule);
    border-right: none;
    padding: 0.8rem 0.35rem;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .ss2-tab:hover {
    color: var(--ss2-blue-ink);
    background: var(--ss2-blue-soft);
  }
  .ss2-tab.is-active {
    background: var(--ss2-blue);
    color: #fff;
    border-color: var(--ss2-blue);
  }
  @media (max-width: 1279px) {
    .ss2-tabs { display: none; }
  }

  /* ===== reveal ===== */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 70ms);
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  /* ===== responsive ===== */
  @media (max-width: 960px) {
    .ss2-cover { padding-top: 5.5rem; }
    .ss2-cover-grid,
    .ss2-proc,
    .ss2-vis-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .ss2-cover-grid .ss2-plate-media img {
      height: auto;
      object-fit: initial;
    }
    .ss2-vis-grid .ss2-plate-media video {
      position: static;
      height: auto;
      aspect-ratio: 1920/1324;
      object-fit: initial;
    }
    .ss2-proc-flip .ss2-proc-copy { order: 1; }
    .ss2-proc-flip .ss2-plate { order: 2; }
    .ss2-plate-phone { margin-left: 0; }
    .ss2-ledger-head { display: none; }
    .ss2-ledger-row {
      grid-template-columns: 4.5rem 1fr;
      grid-template-areas: 'no name' 'no desc';
      row-gap: 0.35rem;
    }
    .ss2-ledger-ic { grid-area: no; }
    .ss2-ledger-name { grid-area: name; }
    .ss2-ledger-desc { grid-area: desc; }
    .ss2-ledger-trust .ss2-ledger-row {
      grid-template-columns: 1fr;
      grid-template-areas: 'name' 'desc';
    }
    .ss2-step {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .ss2-note {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      padding: 1.5rem 1.25rem;
    }
    .ss2-note-tag { justify-self: start; }
    .ss2-note-btn { justify-self: start; }
    .ss2-proof { grid-template-columns: 1fr; }
    .ss2-proof-cell + .ss2-proof-cell {
      border-left: none;
      border-top: 1px solid var(--ss2-rule);
    }
    .ss2-doc { flex-direction: column; gap: 0.3rem; margin-bottom: 2rem; }
    .ss2-certs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem; }
    .ss2-cert img { height: 40px; }
    .ss2-cert span { font-size: 0.56rem; text-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss2-h1 .w { animation: none; transform: none; }
    .ss2-tail::after { animation: none; }
    .ss2-doc-title { animation: none; }
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // reveal on scroll
  const revealEls = document.querySelectorAll('.ss2 [data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-in'));
  }

  // fore-edge tab scroll-spy
  const tabLinks = document.querySelectorAll('.ss2-tab');
  const tabTargets = document.querySelectorAll('[data-tab]');
  if (tabLinks.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = e.target.getAttribute('data-tab');
        tabLinks.forEach((l) => l.classList.toggle('is-active', l.getAttribute('data-tab-link') === id));
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    tabTargets.forEach((t) => spy.observe(t));
  }

  // respect reduced motion: pause ambient looping videos, offer click to play
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const ss2Videos = document.querySelectorAll('.ss2 video[autoplay]');
  function applyMotionPref() {
    ss2Videos.forEach((v) => {
      if (reduceMotion.matches) {
        v.pause();
        v.removeAttribute('autoplay');
        v.setAttribute('controls', '');
        v.dataset.pausedByPref = '1';
      } else if (v.dataset.pausedByPref) {
        v.removeAttribute('controls');
        v.play().catch(() => {});
        delete v.dataset.pausedByPref;
      }
    });
  }
  applyMotionPref();
  reduceMotion.addEventListener('change', applyMotionPref);
</script>
