---
import '../styles/home.css';
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeHero from '../components/home/HomeHero.astro';
import StatsBand from '../components/home/StatsBand.astro';
import LogoCarousel from '../components/home/LogoCarousel.astro';
import ProductEcosystem from '../components/home/ProductEcosystem.astro';
import PlugAndPlaySection from '../components/home/PlugAndPlaySection.astro';
import VideoDemoSection from '../components/home/VideoDemoSection.astro';
import IndustryAccordion from '../components/home/IndustryAccordion.astro';
import HomeFAQSection from '../components/home/HomeFAQSection.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
---

<Layout
  title="Whale AI | World Model for Commercial Intelligence"
  description="Whale AI converts camera footage, voice, and floor activity into real-time intelligence for retail, automotive, healthcare, and more. Book a demo."
  canonical="https://www.whale.sg/"
>
  <HomeHeader />
  <main class="home-page">
    <HomeHero />
    <StatsBand />
    <LogoCarousel id="clients-1" />
    <ProductEcosystem />
    <PlugAndPlaySection />
    <VideoDemoSection />
    <IndustryAccordion />
    <LogoCarousel id="clients-2" />
    <HomeFAQSection />
  </main>
  <HomeFooter />
</Layout>
