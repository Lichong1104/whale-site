  <script is:inline>
    (function () {
      'use strict';
      const viewport = document.getElementById('pc-viewport');
      const stage = document.getElementById('pc-stage');
      const DESIGN_WIDTH = 1920;
      const DESIGN_HEIGHT = 9262;
      const MAX_SCALE = 1;

      function getScale() {
        return Math.min(MAX_SCALE, window.innerWidth / DESIGN_WIDTH);
      }

      function fitStage() {
        const scale = getScale();
        stage.style.transform = 'scale(' + scale + ')';
        viewport.style.width = (DESIGN_WIDTH * scale) + 'px';
        viewport.style.height = (DESIGN_HEIGHT * scale) + 'px';
      }

      window.addEventListener('resize', fitStage);
      window.addEventListener('load', fitStage);
      fitStage();

      const nav = document.querySelector('.pc-nav');
      let ticking = false;
      function stickyNav() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          const scale = getScale();
          const designScroll = window.scrollY / scale;
          const sticky = designScroll >= 70;
          nav.classList.toggle('sticky', sticky);
          nav.style.top = Math.max(70, designScroll) + 'px';
          ticking = false;
        });
      }
      window.addEventListener('scroll', stickyNav, { passive: true });
      stickyNav();

      document.querySelectorAll('.accordion-item').forEach(function (item) {
        item.querySelector('.accordion-head').addEventListener('click', function () {
          const parent = item.closest('.accordion');
          parent.querySelectorAll('.accordion-item').forEach(function (sibling) {
            sibling.classList.toggle('active', sibling === item);
          });
        });
      });

      document.querySelectorAll('.faq-item').forEach(function (item) {
        item.querySelector('.faq-head').addEventListener('click', function () {
          const wasActive = item.classList.contains('active');
          document.querySelectorAll('.faq-item').forEach(function (i) { i.classList.remove('active'); });
          if (!wasActive) item.classList.add('active');
        });
      });

      const heroDots = document.querySelectorAll('.hero-dots .hero-dot');
      const heroSlides = document.querySelectorAll('.hero-slide');
      heroDots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          const idx = Number(dot.dataset.slide);
          heroDots.forEach(function (d) { d.classList.toggle('active', d === dot); });
          heroSlides.forEach(function (s, i) { s.classList.toggle('active', i === idx); });
        });
      });
    })();
  </script>
</Layout>
