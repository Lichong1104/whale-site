  <script is:inline>
    (function () {
      'use strict';
      const viewport = document.getElementById('pc-viewport');
      const stage = document.getElementById('pc-stage');
      const DESIGN_WIDTH = 1920;
      const DESIGN_HEIGHT = 9262;
      const MAX_SCALE = 1;

      function getScale() {
        return Math.min(MAX_SCALE, window.innerWidth / DESIGN_WIDTH);
      }

      function fitStage() {
        const scale = getScale();
        stage.style.transform = 'scale(' + scale + ')';
        viewport.style.width = (DESIGN_WIDTH * scale) + 'px';
        viewport.style.height = (DESIGN_HEIGHT * scale) + 'px';
      }

      window.addEventListener('resize', fitStage);
      window.addEventListener('load', fitStage);
      fitStage();

      const nav = document.querySelector('.pc-nav');
      let ticking = false;
      function stickyNav() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          const scale = getScale();
          const stageRect = stage.getBoundingClientRect();
          const designTop = -stageRect.top / scale;
          const sticky = designTop >= 70;
          nav.classList.toggle('sticky', sticky);
          nav.style.top = Math.max(70, designTop) + 'px';
          ticking = false;
        });
      }
      window.addEventListener('scroll', stickyNav, { passive: true });
      stickyNav();

      document.querySelectorAll('.accordion-item').forEach(function (item) {
        item.querySelector('.accordion-head').addEventListener('click', function () {
          const parent = item.closest('.accordion');
          parent.querySelectorAll('.accordion-item').forEach(function (sibling) {
            sibling.classList.toggle('active', sibling === item);
          });
        });
      });

      document.querySelectorAll('.faq-item').forEach(function (item) {
        item.querySelector('.faq-head').addEventListener('click', function () {
          const wasActive = item.classList.contains('active');
          document.querySelectorAll('.faq-item').forEach(function (i) { i.classList.remove('active'); });
          if (!wasActive) item.classList.add('active');
        });
      });

      const faqMoreBtn = document.querySelector('[data-faq-more]');
      const faqList = document.querySelector('.faq-list');
      if (faqMoreBtn && faqList) {
        faqMoreBtn.addEventListener('click', function () {
          const expanded = faqList.classList.toggle('is-expanded');
          faqMoreBtn.textContent = expanded ? 'Show less' : 'Show 4 more';
        });
      }

      const heroDots = document.querySelectorAll('.hero-dots .hero-dot');
      const heroSlides = document.querySelectorAll('.hero-slide');
      heroDots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          const idx = Number(dot.dataset.slide);
          heroDots.forEach(function (d) { d.classList.toggle('active', d === dot); });
          heroSlides.forEach(function (s, i) { s.classList.toggle('active', i === idx); });
        });
      });
    })();

    (function () {
      'use strict';
      const switchEl = document.querySelector('[data-lang-switch]');
      if (!switchEl) return;
      const toggle = switchEl.querySelector('.lang-switch-toggle');
      const menu = switchEl.querySelector('.lang-switch-menu');

      function closeMenu() {
        switchEl.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }

      function openMenu() {
        switchEl.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
      }

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        if (switchEl.classList.contains('open')) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      document.addEventListener('click', function (e) {
        if (!switchEl.contains(e.target)) closeMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeMenu();
      });

      const currentHost = window.location.hostname;
      const map = {
        'www.meetwhale.com': 'Chinese (简体中文)',
        'www.whaleai.co.jp': 'Japanese (日本語)',
        'www.whale.sg': 'English (Singapore)'
      };
      const label = map[currentHost] || 'English (US)';
      toggle.querySelector('span').textContent = label;
      menu.querySelectorAll('a').forEach(function (link) {
        const host = new URL(link.href).hostname;
        link.setAttribute('aria-current', map[host] === label ? 'true' : 'false');
      });
    })();

    (function () {
      'use strict';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduceMotion.matches) return;

      const rows = document.querySelectorAll('.features-panel .feature-row');
      const cards = document.querySelectorAll('.features-panel .feature-card');
      if (!rows.length) return;

      rows.forEach(function (row) { row.classList.add('animate-on-scroll'); });
      cards.forEach(function (card) { card.classList.add('animate-on-scroll'); });

      function reveal(el) {
        el.classList.add('is-revealed');
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function (entries, obs) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              const el = entry.target;
              const delay = Number(el.dataset.revealDelay) || 0;
              window.setTimeout(function () { reveal(el); }, delay);
              obs.unobserve(el);
            }
          });
        }, { threshold: 0.25, rootMargin: '0px 0px -10% 0px' });

        rows.forEach(function (row, i) {
          row.dataset.revealDelay = String(i * 150);
          observer.observe(row);
        });
        cards.forEach(function (card, i) {
          card.dataset.revealDelay = String(450 + i * 100);
          observer.observe(card);
        });
      } else {
        rows.forEach(reveal);
        cards.forEach(reveal);
      }
    })();

  </script>
</Layout>
