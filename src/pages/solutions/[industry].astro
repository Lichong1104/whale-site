---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const industries = [
    {
      id: 'automotive',
      short: 'Automotive',
      name: 'Automotive',
      headline: 'Every conversation. Every showroom standard. Finally visible.',
      lines: ['Every conversation.', 'Every showroom standard.', 'Finally visible.'],
      challenge: "On a dealership floor, the only record of what actually happened is whatever the salesperson typed into the CRM afterward — if they typed anything at all. Top performers carry their playbook in their heads, and when they leave, it leaves with them. Meanwhile, showroom compliance and service bay SOPs only get checked when a manager happens to walk by, which isn't nearly often enough across a busy floor with high-value transactions on the line.",
      log: [
        { metric: 'CRM', label: 'The only record of what happened — if they typed anything at all', flag: 'Gap', level: 'red' },
        { metric: 'Walk-by', label: 'How showroom & service-bay SOPs get checked today', flag: 'Manual', level: 'amber' },
        { metric: '1×/wk', label: 'A compliance snapshot once a week — then nothing until the next one', flag: 'Sparse', level: 'amber' }
      ],
      see: "SpaceSight keeps a continuous eye on the floor — vehicle placement, pricing accuracy, safety protocols in the service bay — so nothing waits for the next manual walkthrough to get caught. Instead of a compliance snapshot once a week, you get one all day, every day.",
      hear: "Echo records and scores every sales conversation — greeting, needs discovery, objection handling, closing — across every associate and every shift. And it doesn't just look back afterward: Echo can surface real-time coaching cues to managers during a live customer interaction, before a deal is lost rather than after. What used to live only in your best performer's head becomes something the whole team can learn from.",
      seeMode: 'Mode · Continuous — all day, every day',
      hearMode: 'Mode · Real-time — every conversation, every shift',
      outcomeRows: [
        'Every customer interaction captured and scored.',
        'Top performer technique made trainable across the network.',
        'Showroom and service compliance enforced without another manual checklist.'
      ],
      scope: ['Showroom', 'Service bay', 'Sales floor'],
      camLabel: 'Showroom floor · Regional flow',
      time: 'All day / Every day',
      img: '/solutions/automotive.png',
      imgAlt: 'SpaceSight view of an automotive showroom — camera coverage zones and regional passenger-flow filtering over the exhibition floor',
      hover: '#0E7490',
      track: '#22D3EE'
    },
    {
      id: 'luxury-retail',
      short: 'Luxury',
      name: 'Luxury & Fashion Retail',
      headline: 'Brand standards, enforced at every location, every day.',
      lines: ['Brand standards,', 'enforced at every location,', 'every day.'],
      challenge: 'Multi-location luxury and fashion brands live and die by consistency — but manual store visits typically reach only about 10% of locations per quarter, leaving the rest unmonitored between audits. Compliance erodes quietly at the store level. Top-performer sales habits stay local instead of spreading. And customer experience is measured anecdotally ("it felt slow in the fitting room") instead of with real data.',
      log: [
        { metric: '~10%', label: 'Of stores reached by manual audits each quarter — the rest run unchecked', flag: 'Sparse', level: 'amber' },
        { metric: 'Anecdote', label: '"It felt slow in the fitting room" stands in for customer-experience data', flag: 'Gap', level: 'red' },
        { metric: 'Local', label: 'Top-performer sales habits stay in one store instead of spreading', flag: 'Siloed', level: 'amber' }
      ],
      see: "SpaceSight runs continuous AI audits across every location — planogram compliance, display standards, staff presence, fitting room activity — and routes violations automatically to the right manager the moment they're detected, including a live check on whether in-store signage and displays still match approved brand assets.",
      hear: 'Echo captures and scores every customer interaction on the sales floor, identifying what your top performers do differently and turning those patterns into something trainable across the full team — not just tribal knowledge that lives with a handful of associates.',
      seeMode: 'Mode · Continuous — every location, every day',
      hearMode: 'Mode · Sales floor — every interaction scored',
      outcomeRows: [
        'Brand standards enforced across every location, every day.',
        'Best-practice sales behavior scaled to every associate.',
        'Customer experience made measurable instead of anecdotal.'
      ],
      scope: ['Sales floor', 'Fitting rooms', 'Displays'],
      camLabel: 'Boutique floor · Flow heat map',
      time: 'Every location / Every day',
      img: '/solutions/luxury-retail.png',
      imgAlt: 'SpaceSight retail analytics — in-store customer-flow heat map and journey chart over a boutique camera view',
      hover: '#DB2777',
      track: '#FF4D8D'
    },
    {
      id: 'food-beverage',
      short: 'F&B',
      name: 'Food & Beverage',
      headline: 'Food safety, monitored continuously — not sampled.',
      lines: ['Food safety,', 'monitored continuously —', 'not sampled.'],
      challenge: "Food safety compliance — FDA standards, state health codes — across hundreds of locations is structurally impossible to manage by manual walkthrough. Kitchen behavior (gloves, sanitizing, prep protocol) is largely invisible to HQ. High staff turnover means training rarely sticks, so a new hire's third shift often looks nothing like what corporate SOPs prescribe. And loss prevention at the register tends to be reactive — you find out about a problem only after it's already a pattern.",
      log: [
        { metric: 'Invisible', label: 'Kitchen behavior — gloves, sanitizing, prep protocol — to HQ', flag: 'Gap', level: 'red' },
        { metric: 'Turnover', label: "A new hire's third shift often looks nothing like corporate SOPs", flag: 'Churn', level: 'amber' },
        { metric: 'Reactive', label: "Register loss prevention found only after it's already a pattern", flag: 'Late', level: 'red' }
      ],
      see: 'SpaceSight monitors kitchen operations in real time — hygiene compliance, PPE adherence, food safety protocol deviations — with violations triggering immediate alerts to the store manager. The same continuous coverage extends to the register, catching loss-prevention issues as they happen rather than after the fact.',
      hear: 'Echo captures customer-facing interactions and scores service quality across every shift — not just the ones a supervisor happened to observe — surfacing the patterns that actually correlate with higher satisfaction and repeat visits.',
      seeMode: 'Mode · Real-time — kitchen to register',
      hearMode: 'Mode · Every shift — service quality scored',
      outcomeRows: [
        'Food safety incidents caught before they become health code violations.',
        'Compliance documentation generated automatically, not compiled by hand.',
        'A consistent customer experience regardless of location or shift.'
      ],
      scope: ['Kitchen', 'Prep line', 'Register'],
      camLabel: 'Kitchen line · PPE detection',
      time: 'Real-time / Every shift',
      img: '/solutions/food-beverage.png',
      imgAlt: 'SpaceSight kitchen monitoring — PPE detection flags a cook not wearing a mask, with review timeline over the camera feed',
      hover: '#B45309',
      track: '#F59E0B'
    },
    {
      id: 'healthcare',
      short: 'Healthcare',
      name: 'Healthcare',
      headline: 'Patient safety, monitored around the clock.',
      lines: ['Patient safety,', 'monitored around the clock.'],
      challenge: 'Hand hygiene, PPE adherence, restricted-zone access, fall prevention — these are exactly the standards CMS and The Joint Commission expect continuous oversight for, and exactly the ones no shift supervisor can physically watch every minute of. Incidents are typically discovered after they happen, not prevented in real time. Compliance documentation, meanwhile, is largely manual — pulling clinical staff away from patient care to produce it.',
      log: [
        { metric: 'After', label: 'Incidents typically discovered after they happen, not prevented in real time', flag: 'Late', level: 'red' },
        { metric: 'Manual', label: 'Compliance documentation pulls clinical staff away from patient care', flag: 'Manual', level: 'amber' },
        { metric: 'CMS · TJC', label: 'Standards that expect continuous oversight of hygiene, PPE, restricted zones', flag: 'Expected', level: 'ind' }
      ],
      see: 'SpaceSight provides continuous AI monitoring of high-risk zones — ICUs, pharmacies, isolation rooms — flagging PPE and hand-hygiene violations, restricted-area access, and fall-risk behavior in real time, and compiling audit-ready compliance documentation automatically instead of by hand.',
      hear: 'Echo captures patient-facing interactions and scores communication quality, flagging service breakdowns before they show up in HCAHPS survey data — giving you a chance to fix a problem before it affects reimbursement.',
      seeMode: 'Mode · Continuous — high-risk zones, around the clock',
      hearMode: 'Mode · Real-time — before survey scores move',
      outcomeRows: [
        'Patient safety incidents flagged before they escalate.',
        'Regulatory audit documentation generated automatically.',
        'Staff compliance measurable and continuously improving.'
      ],
      scope: ['ICU', 'Pharmacy', 'Isolation rooms'],
      camLabel: 'Ward · Personnel analysis',
      time: 'Around the clock',
      img: '/solutions/healthcare.png',
      imgAlt: 'SpaceSight hospital console — ward camera feed with AI personnel analysis and playback timeline, plus mobile ward list',
      hover: '#15803D',
      track: '#34D399'
    },
    {
      id: 'museums',
      short: 'Museums',
      name: 'Museums & Cultural Institutions',
      headline: 'See how visitors actually experience your museum.',
      lines: ['See how visitors actually', 'experience your museum.'],
      challenge: "Curators typically rearrange exhibits based on instinct, not on data showing where guests actually stop, linger, and disengage. Security and artifact protection rely on staff patrols that can't achieve continuous coverage across large, multi-gallery facilities. Staff scheduling is built on historical patterns rather than real-time visitor density, leading to understaffed galleries during surges. And grant applications or donor reports often need visitor-engagement data most institutions still collect through manual counters and periodic surveys.",
      log: [
        { metric: 'Instinct', label: 'How exhibits get rearranged — no data on where guests actually linger', flag: 'No data', level: 'red' },
        { metric: 'Patrols', label: "Security coverage that can't watch every gallery at once", flag: 'Sparse', level: 'amber' },
        { metric: 'Counters', label: 'Manual counts and periodic surveys feed grant and donor reports', flag: 'Manual', level: 'amber' }
      ],
      see: 'SpaceSight maps real-time visitor flow across every gallery — dwell time by exhibit, traffic patterns, crowd density — giving curators real data to guide layout and exhibit placement, while continuously flagging unauthorized access near your collection or unusual behavior near an exhibit.',
      hear: 'Echo captures interaction quality at information desks, guided tours, and interactive stations, scoring staff engagement and identifying exactly where the visitor experience tends to break down.',
      seeMode: 'Mode · Continuous — every gallery mapped',
      hearMode: 'Mode · Real-time — desks, tours, stations',
      outcomeRows: [
        'Exhibit layout guided by actual visitor behavior.',
        'Collection security strengthened without added headcount.',
        'Visitor engagement data ready whenever a grant application or donor update needs it.'
      ],
      scope: ['Galleries', 'Info desks', 'Guided tours'],
      camLabel: 'Gallery · Visitor flow',
      time: 'Real-time / Every gallery',
      img: '/solutions/museums.png',
      imgAlt: 'SpaceSight museum gallery analytics — visitors tracked with pose overlays and dwell-time labels, visitor path traced across the exhibition floor',
      hover: '#1D4ED8',
      track: '#60A5FA'
    }
  ];

  return industries.map((ind) => ({ params: { industry: ind.id }, props: { ind } }));
}

const { ind } = Astro.props;

const canonicalUrl = `https://www.whale.sg/solutions/${ind.id}/`;
const pageDescription = `${ind.name} solution: ${ind.headline} SpaceSight and Echo bring real-time visibility and conversation intelligence to ${ind.name.toLowerCase()} operations.`;

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.whale.sg/solutions/' },
      { '@type': 'ListItem', position: 3, name: ind.name, item: canonicalUrl }
    ]
  }
];
---

<Layout
  title={`${ind.name} Solution | Whale AI`}
  description={pageDescription}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main class="hud" style={`--ind: ${ind.hover}; --ind-track: ${ind.track}`}>

    <!-- Hero: brief left, monitored frame right -->
    <section class="ind-hero">
      <div class="container ind-hero-grid">
        <div class="ind-hero-copy">
          <a class="back" href="/solutions/"><span aria-hidden="true">←</span> All industries</a>
          <p class="eyebrow">Industry Solution · {ind.short}</p>
          <h1 class="headline">
            {ind.lines.map((line, i) => (
              <span class={`line${i === ind.lines.length - 1 ? ' tail' : ''}`}>{line}</span>
            ))}
          </h1>
          <ul class="scope" aria-label="Products and coverage">
            <li class="capsule capsule-see"><i aria-hidden="true"></i>SpaceSight · Sees</li>
            <li class="capsule capsule-hear"><i aria-hidden="true"></i>Echo · Hears</li>
            {ind.scope.map((zone) => <li class="zone">{zone}</li>)}
          </ul>
        </div>

        <div class="frame-wrap">
          <figure class="console">
            <div class="console-bar">
              <span class="rec"><i aria-hidden="true"></i>REC</span>
              <span class="console-cam">{ind.camLabel}</span>
              <span class="console-time">{ind.time}</span>
            </div>
            <div class="console-view">
              <img src={ind.img} alt={ind.imgAlt} loading="eager" />
              <span class="vc vc-tl" aria-hidden="true"></span>
              <span class="vc vc-tr" aria-hidden="true"></span>
              <span class="vc vc-bl" aria-hidden="true"></span>
              <span class="vc vc-br" aria-hidden="true"></span>
              <span class="scanline" aria-hidden="true"></span>
            </div>
            <dl class="telemetry">
              <div>
                <dt>Coverage</dt>
                <dd>{ind.time}</dd>
              </div>
              <div>
                <dt>Compliance</dt>
                <dd>Continuous</dd>
              </div>
              <div>
                <dt>Zones</dt>
                <dd>{ind.scope.join(' · ')}</dd>
              </div>
            </dl>
          </figure>
          <p class="figcap"><span class="figcap-id">Fig. 01</span><span class="figcap-alt">{ind.imgAlt}</span></p>
        </div>
      </div>
    </section>

    <!-- SEC.01 — The challenge -->
    <section class="sec" aria-labelledby="sec-challenge">
      <div class="container">
        <header class="ruler">
          <span class="ruler-id">SEC.01</span>
          <span class="ruler-line" aria-hidden="true"></span>
          <h2 class="ruler-name" id="sec-challenge">The challenge</h2>
        </header>
        <div class="challenge-grid">
          <p class="challenge-body">{ind.challenge}</p>
          <aside class="log" aria-label="Field log — status quo">
            <div class="log-head"><i aria-hidden="true"></i>Field log — status quo</div>
            <ul>
              {ind.log.map((row) => (
                <li>
                  <span class="log-metric">{row.metric}</span>
                  <span class="log-label">{row.label}</span>
                  <span class={`log-flag flag-${row.level}`}>{row.flag}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <!-- SEC.02 — Whale's solutions (ink stage band) -->
    <section class="sec sec-units" aria-labelledby="sec-solutions">
      <div class="container">
        <header class="ruler">
          <span class="ruler-id">SEC.02</span>
          <span class="ruler-line" aria-hidden="true"></span>
          <h2 class="ruler-name" id="sec-solutions">Whale's solutions</h2>
        </header>
        <div class="units">
          <article class="unit unit-see">
            <span class="uc uc-tl" aria-hidden="true"></span>
            <span class="uc uc-tr" aria-hidden="true"></span>
            <span class="uc uc-bl" aria-hidden="true"></span>
            <span class="uc uc-br" aria-hidden="true"></span>
            <header class="unit-head">
              <span class="unit-id">Unit.01</span>
              <h3 class="unit-name">SpaceSight</h3>
              <span class="unit-tag">Sees</span>
              <span class="unit-status"><i aria-hidden="true"></i>Active</span>
            </header>
            <p class="unit-body">{ind.see}</p>
            <footer class="unit-foot">{ind.seeMode} · <a href="/spacesight/" class="unit-link">Explore SpaceSight →</a></footer>
          </article>
          <article class="unit unit-hear">
            <span class="uc uc-tl" aria-hidden="true"></span>
            <span class="uc uc-tr" aria-hidden="true"></span>
            <span class="uc uc-bl" aria-hidden="true"></span>
            <span class="uc uc-br" aria-hidden="true"></span>
            <header class="unit-head">
              <span class="unit-id">Unit.02</span>
              <h3 class="unit-name">Echo</h3>
              <span class="unit-tag">Hears</span>
              <span class="unit-status"><i aria-hidden="true"></i>Active</span>
            </header>
            <p class="unit-body">{ind.hear}</p>
            <footer class="unit-foot">{ind.hearMode}</footer>
          </article>
        </div>
      </div>
    </section>

    <!-- SEC.03 — The outcome -->
    <section class="sec sec-outcome" aria-labelledby="sec-outcome">
      <div class="container">
        <header class="ruler">
          <span class="ruler-id">SEC.03</span>
          <span class="ruler-line" aria-hidden="true"></span>
          <h2 class="ruler-name" id="sec-outcome">The outcome</h2>
        </header>
        <div class="outcome-grid">
          <div class="result">
            <div class="result-head"><i aria-hidden="true"></i>Results — all systems go</div>
            <ul>
              {ind.outcomeRows.map((row) => (
                <li>
                  <span class="check" aria-hidden="true">
                    <svg viewBox="0 0 12 12" fill="none"><path d="M2.2 6.3 4.8 8.8 9.8 3.4" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <p>{row}</p>
                  <span class="pass">Pass</span>
                </li>
              ))}
            </ul>
          </div>
          <aside class="scoreboard" aria-label="Outcome checks summary" data-rail="Event · Captured">
            <span class="score-label">Outcome checks</span>
            <span class="score-value">{ind.outcomeRows.length}<span class="score-total">/{ind.outcomeRows.length}</span></span>
            <span class="score-state"><i aria-hidden="true"></i>All green</span>
            <span class="score-bars" aria-hidden="true">{ind.outcomeRows.map(() => <b></b>)}</span>
          </aside>
        </div>
        <a class="others" href="/solutions/">
          See how it works for other industries <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <CTASection
      headline={`See it. Hear it. Fix it —<br>for ${ind.name}.`}
      lead="Book a demo and we'll walk through your floor, your shifts, and your standards — and show you what continuous visibility looks like."
      primaryLabel="Book a Demo"
    />
  </main>
  <Footer />
</Layout>

<style>
  .hud {
    --ok: #16A34A;
    --warn: #B45309;
    --alert: #B91C1C;
    --hairline: rgba(15, 23, 42, 0.14);
    --hairline-soft: rgba(15, 23, 42, 0.08);
    /* fixed header measures ~81px here (the 60px token is stale site-wide) */
    padding-top: calc(var(--header-height) + 22px);
  }

  .hud .ruler-name,
  .hud .unit-name {
    font-family: var(--font-display);
  }

  /* ---------------- Hero ---------------- */
  .ind-hero {
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .ind-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    gap: clamp(var(--space-md), 4vw, var(--space-xl));
    align-items: center;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--ind);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ind);
    border: 1px solid color-mix(in srgb, var(--ind) 40%, transparent);
    background: color-mix(in srgb, var(--ind-track) 9%, transparent);
    border-radius: 3px;
    padding: 0.4rem 0.7rem;
    margin-bottom: var(--space-md);
  }

  /* 45° signal diamond — the kicker marker from the landing page system */
  .eyebrow::before {
    content: '';
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--ind);
    box-shadow: 0 0 8px color-mix(in srgb, var(--ind-track) 80%, transparent);
  }

  .headline {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    max-width: none;
    margin-bottom: var(--space-md);
    text-wrap: balance;
  }

  .headline .line {
    display: block;
  }

  .headline .tail {
    color: var(--ind);
  }

  .headline .tail::after {
    content: '';
    display: inline-block;
    width: 0.42em;
    height: 0.82em;
    margin-left: 0.16em;
    transform: translateY(0.09em);
    background: var(--ind-track);
    animation: hud-blink 1.15s steps(1) infinite;
  }

  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scope li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 3px;
    padding: 0.35rem 0.65rem;
  }

  .capsule {
    color: var(--text);
    border: 1px solid var(--hairline);
    background: var(--bg-elevated);
  }

  .capsule i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .capsule-see i {
    background: #FFD23F;
    box-shadow: 0 0 8px rgba(255, 210, 63, 0.9);
  }

  .capsule-hear i {
    background: #00E5FF;
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.9);
  }

  .zone {
    color: var(--text-secondary);
    border: 1px dashed var(--hairline);
  }

  /* ---------------- Monitored frame (hero console) ---------------- */
  .frame-wrap {
    margin: 0;
  }

  .console {
    margin: 0;
    background: var(--bg-dark);
    border: 1px solid rgba(11, 16, 32, 0.7);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 32px 72px rgba(11, 16, 32, 0.3);
  }

  .console-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.62);
  }

  .rec {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #FF7070;
    white-space: nowrap;
  }

  .rec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FF4B4B;
    box-shadow: 0 0 10px rgba(255, 75, 75, 0.9);
    animation: hud-pulse 1.6s ease-in-out infinite;
  }

  .console-time {
    color: var(--ind-track);
    white-space: nowrap;
  }

  .console-view {
    position: relative;
    overflow: hidden;
  }

  .console-view img {
    display: block;
    width: 100%;
    height: auto;
  }

  .vc {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid var(--ind-track);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--ind-track) 60%, transparent));
    pointer-events: none;
  }

  .vc-tl { top: 12px; left: 12px; border-right: none; border-bottom: none; }
  .vc-tr { top: 12px; right: 12px; border-left: none; border-bottom: none; }
  .vc-bl { bottom: 12px; left: 12px; border-right: none; border-top: none; }
  .vc-br { bottom: 12px; right: 12px; border-left: none; border-top: none; }

  .scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: -18%;
    height: 18%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--ind-track) 10%, transparent) 42%,
      color-mix(in srgb, var(--ind-track) 40%, transparent) 50%,
      color-mix(in srgb, var(--ind-track) 10%, transparent) 58%,
