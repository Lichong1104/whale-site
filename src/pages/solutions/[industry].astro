---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';

const RING = `<circle cx="100" cy="112" r="88" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.22" stroke-dasharray="2 8"/><circle cx="100" cy="112" r="64" fill="none" stroke="currentColor" stroke-width="1" opacity="0.12"/><circle cx="100" cy="24" r="4" fill="currentColor" stroke="none"/>`;

const toParas = (text) => text.split('\n\n').map((p) => `<p>${p}</p>`).join('');
const bulletParts = (b) => {
  const i = b.indexOf(':');
  if (i < 0) return b;
  return `<strong>${b.slice(0, i)}:</strong>${b.slice(i + 1)}`;
};

export function getStaticPaths() {
  const industries = [
    {
      id: 'fashion-footwear-offprice',
      short: 'Fashion',
      name: 'Fashion, Footwear, Off-price',
      lines: ['The line at the exit registers:', 'wait, walk-aways and registers staffed, by hour'],
      problem: "For off-price retailers, checkout is the final step—and one last opportunity to lose a purchase. A growing line can leave shoppers waiting, frustrate store teams, and lead customers to walk away.\n\nYet a visible queue tells only part of the story. How long did shoppers wait? How many registers were staffed? Did moving more employees to checkout help? Daily sales alone cannot answer those questions.",
      whyNow: "Retailers face pressure to speed up checkout while keeping stores organized and labor costs under control. Investments in staffing and self-checkout raise a practical question: Are those changes actually reducing customer wait times?\n\nMeasuring queues helps teams understand where support is needed and whether their changes are working.",
      how: "SpaceSight measures how many shoppers are in line, how long they wait, and how many leave before reaching a register. It supports shared checkout lines, separate register queues, and dedicated self-checkout areas.\n\nBy tracking presence at cashier positions, SpaceSight also helps teams understand register coverage throughout the day—without relying on uniform recognition.",
      bullets: [
        'Respond to growing lines: Get near-real-time alerts when queues exceed a defined threshold.',
        'Review checkout performance: Access hourly wait-time and walk-away reports the next morning.',
        'Connect staffing with results: Compare queue performance, register coverage, and POS transactions by store and hour to assess whether staffing changes improve checkout flow.'
      ],
      scope: ['Checkout', 'Registers', 'Queue zones'],
      camLabel: 'Checkout line · Queue metrics',
      time: 'By hour / Every day',
      hover: '#1D4ED8',
      track: '#2563EB',
      scene: `<path d="M70 80 h60 v80 h-60 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M85 80 v-20 a15 15 0 0 1 30 0 v20" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="100" cy="125" r="8" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M55 160 h90" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>`,
      imgAlt: 'SpaceSight view of a fashion checkout area — queue length and register coverage tracked over the camera feed'
    },
    {
      id: 'beauty-personal-care',
      short: 'Beauty',
      name: 'Beauty & Personal Care',
      lines: ['See which brands', 'and displays draw shoppers in'],
      problem: "Brand placement matters—from a prominent fragrance wall to an individual shelf bay. But sales alone cannot tell merchants whether a location attracts shopper attention or reflects existing demand for the brand.\n\nWithout visibility into how shoppers engage, teams have limited evidence to guide placement discussions, assess displays, or decide what to change.",
      whyNow: "Beauty retailers want the same depth of understanding on the store floor that they seek online: which areas shoppers pass, where they stop, and which displays they face.\n\nAs brands compete for visibility, a practical question follows: Are priority brands and displays attracting the engagement retailers expect?",
      how: "SpaceSight shows how shoppers interact with each brand area or display—from passing by to stopping and facing it. By measuring traffic, time spent, and front-facing engagement, it gives merchants evidence to inform placement and display decisions.",
      bullets: [
        'Compare brand areas: See which bays attract passing traffic and encourage shoppers to stop.',
        'Understand time spent: Measure how long shoppers stay near each display and whether they face it.',
        'Evaluate placement changes: Compare engagement before and after layout or display updates to understand what changed.'
      ],
      funnel: 'Passed by → Stopped → Faced the display',
      scope: ['Brand areas', 'Displays', 'Shopper traffic'],
      camLabel: 'Beauty floor · Display engagement',
      time: 'Continuous / Every day',
      hover: '#1D4ED8',
      track: '#2563EB',
      scene: `<rect x="78" y="70" width="44" height="70" rx="8" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="100" cy="92" r="10" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M88 70 v-12 h24 v12" fill="none" stroke="currentColor" stroke-width="3"/>`,
      imgAlt: 'SpaceSight beauty analytics — shopper attention measured at fragrance and skincare displays'
    },
    {
      id: 'grocery-pharmacy',
      short: 'Grocery',
      name: 'Grocery & Pharmacy',
      lines: ['Make pharmacy waits visible', 'while protecting customer privacy'],
      problem: "Prescription systems track the time from drop-off to ready. But they can miss another part of the customer experience: people lining up at the counter or waiting in the seating area.\n\nWhen staffing decisions rely mainly on prescription volume, busy walk-up periods can go unseen in planning. Teams need a clearer view of customer demand—with privacy built into how it is measured.",
      whyNow: "Pharmacies face growing pressure to align staffing with the full demands of customer service. Virginia’s pharmacy working-conditions rule, for example, requires staffing decisions to consider responsibilities beyond prescription volume.\n\nThat raises a practical question: Does staffing reflect when customers need help at the counter?\n\nMeasuring queues and waiting-area activity gives teams another source of evidence to inform those decisions.",
      how: "SpaceSight measures activity in designated pickup and drop-off queues, with a separate zone for the waiting area. Queue zones focus on customer areas and exclude staff positions, helping teams understand when lines build and how many people are affected.",
      bullets: [
        'Respond to growing lines: Receive platform alerts when a queue exceeds an agreed headcount.',
        'Review demand by hour: Access queue-time reports, threshold breaches, and the number of people affected the next morning.',
        'Protect customer privacy: With face blurring enabled and verified for each pharmacy camera, high-clarity faces are blurred on the in-store device before traffic images leave.'
      ],
      note: 'Video stays in the store, and SpaceSight does not connect this analysis to pharmacy systems, prescription records, or loyalty data.',
      scope: ['Pharmacy counter', 'Waiting area', 'Pickup & drop-off'],
      camLabel: 'Pharmacy counter · Queue & wait area',
      time: 'By hour / Every day',
      hover: '#1D4ED8',
      track: '#2563EB',
      scene: `<rect x="60" y="90" width="80" height="60" rx="6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M90 105 h20 v15 h15 v20 h-15 v15 h-20 v-15 h-15 v-20 h15 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>`,
      imgAlt: 'SpaceSight pharmacy view — pickup queue and waiting-area activity measured without identifying individuals'
    },
    {
      id: 'restaurants-cafes',
      short: 'Restaurants',
      name: 'Restaurants & Cafés',
      lines: ['Keep kitchen standards', 'in view across every location'],
      problem: "Running several restaurants means trusting each team to maintain standards throughout the day. But experienced kitchen managers can be difficult to hire and retain, and everyday issues can go unnoticed: a spill on the floor, an open trash bin beside the prep line, or a back door left propped open.\n\nPeriodic inspections provide only a snapshot. Owners need a more consistent view of what happens between visits, so managers can address issues before they become recurring problems.",
      whyNow: "Maintaining kitchen standards takes regular attention across shifts and locations. Health inspections are periodic, while cleanliness and operating conditions can change throughout the day.\n\nThat raises a practical question: How can owners spot issues across every kitchen when they cannot be there themselves?\n\nScheduled visual checks give managers another way to identify conditions that need attention and follow up with their teams.",
      how: "SpaceSight checks still images from your existing kitchen cameras on a set schedule—for example, hourly during opening hours. Each check evaluates a specific, agreed condition and returns a pass or a flag, with a short explanation and the image reviewed.\n\nFlagged results go to the restaurant manager and the owner’s dashboard after each check, helping teams see what needs attention and where.",
      bullets: [
        'Check everyday kitchen conditions: Identify visible floor spills or objects, unclean prep counters, open trash bin lids, and back doors left open.',
        'Review staff-area phone use: Flag visible phone use in designated staff-only areas.',
        'Maintain visibility across locations: Review scheduled results in one dashboard to focus follow-up and support consistent routines.'
      ],
      note: 'Hair-covering checks require training on images from your restaurant. Mask-wearing observations are available for information only; handwashing checks require custom development. These visual checks support daily oversight but do not establish food safety or replace inspections.',
      scope: ['Kitchen', 'Prep line', 'Back door'],
      camLabel: 'Kitchen · Scheduled visual checks',
      time: 'Scheduled / Every shift',
      hover: '#1D4ED8',
      track: '#2563EB',
      scene: `<path d="M70 110 c0-20 60-20 60 0 v40 h-60 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M75 110 c0-15 50-15 50 0" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="115" cy="135" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/>`,
      imgAlt: 'SpaceSight kitchen monitoring — scheduled visual checks flag spills, open bins, and propped doors'
    },
    {
      id: 'telecom-consumer-electronics',
      short: 'Telecom',
      name: 'Telecom & Consumer Electronics',
      lines: ['Understand which device', 'displays draw shoppers in'],
      problem: "A device in a prime table position may sell well — but how much comes from product demand, and how much from placement?\n\nSell-through alone cannot separate the two. Carriers, device brands, and retail teams need visibility into shopper engagement to make more informed decisions about which products get the most prominent space.",
      whyNow: "Physical stores give shoppers a chance to explore devices before buying. As retailers and brands invest in interactive experiences, dedicated displays, and in-store support, they need evidence of how shoppers engage.\n\nThat raises a practical question: Are priority devices and display locations attracting the interest retailers expect?\n\nMeasuring engagement adds context to sales performance and helps teams assess how valuable floor space is being used.",
      how: "SpaceSight measures how many shoppers approach each device table and how long they stay. Where camera placement and display layout allow, it also measures front-facing attention.",
      bullets: [
        'Compare device tables: See which display areas attract shoppers and encourage them to spend time.',
        'Count shoppers more accurately: Deduplicate repeat approaches so one person returning to a table does not inflate the shopper count.',
        'Inform merchandising decisions: Compare engagement across locations and after placement changes to help assess which displays earn attention.'
      ],
      scope: ['Device tables', 'Display areas', 'Shopper flow'],
      camLabel: 'Device table · Engagement metrics',
      time: 'Continuous / Every day',
      hover: '#1D4ED8',
      track: '#2563EB',
      scene: `<rect x="72" y="50" width="56" height="100" rx="8" fill="none" stroke="currentColor" stroke-width="3"/><path d="M82 70 h36" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M82 85 h36 M82 100 h24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
      imgAlt: 'SpaceSight telecom analytics — shopper engagement measured at each device display table'
    },
    {
      id: 'variety-discount-convenience',
      short: 'Variety',
      name: 'Variety, Discount & Convenience',
      lines: ['Bring timely visibility', 'to loss prevention'],
      problem: "Loss-prevention teams often work backward, reviewing transactions and investigating issues after they happen. Manual review takes time, making it harder to identify recurring patterns and decide where to focus.\n\nTeams need a faster way to spot defined events and understand what is happening across their stores.",
      whyNow: "Convenience retailers are looking to AI to support loss prevention and reduce manual investigation. The challenge is choosing clear use cases and understanding their value.\n\nThat raises a practical question: Which events need immediate attention, and where should teams focus their efforts?\n\nTimely alerts and accessible reporting give teams evidence to guide their response and assess results.",
      how: "SpaceSight detects defined events on the in-store device and sends alerts as they happen. Vega lets teams ask plain-English questions about the events and metrics the platform has already calculated.",
      bullets: [
        'Respond sooner: Receive real-time alerts for configured event types.',
        'Get answers more easily: Use Vega to explore recorded events and calculated metrics through plain-English questions.',
        'Focus follow-up: Use event data to identify recurring patterns and prioritize review across stores.'
      ],
      note: 'Footage search and clip retrieval are available only through an on-premises deployment or a separately contracted configuration.',
      scope: ['Event detection', 'Real-time alerts', 'Vega search'],
      camLabel: 'Store floor · Event detection',
      time: 'Real-time / Every day',
      hover: '#1D4ED8',
      track: '#2563EB',
      scene: `<path d="M100 50 l50 20 v40 c0 35-50 50-50 50s-50-15-50-50 v-40 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="100" cy="110" r="6" fill="currentColor" stroke="none"/><path d="M100 94 v-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>`,
      imgAlt: 'SpaceSight loss-prevention view — defined events detected in real time and surfaced through Vega search'
    }
  ];

  return industries.map((ind) => ({ params: { industry: ind.id }, props: { ind } }));
}

const { ind } = Astro.props;

const canonicalUrl = `https://www.whale.sg/solutions/${ind.id}/`;
const pageDescription = `${ind.name} solution: ${ind.lines.join(' ')} SpaceSight turns in-store activity into insight.`;

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.whale.sg/solutions/' },
      { '@type': 'ListItem', position: 3, name: ind.name, item: canonicalUrl }
    ]
  }
];
---

<Layout
  title={`${ind.name} Solution | Whale AI`}
  description={pageDescription}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main class="hud" style={`--ind: ${ind.hover}; --ind-track: ${ind.track}`}>

    <section class="ind-hero">
      <div class="container ind-hero-grid">
        <div class="ind-hero-copy">
          <a class="back" href="/solutions/"><span aria-hidden="true">←</span> All industries</a>
          <p class="eyebrow">Industry Solution · {ind.short}</p>
          <h1 class="headline">
            {ind.lines.map((line, i) => (
              <span class={`line${i === ind.lines.length - 1 ? ' tail' : ''}`}>{line}</span>
            ))}
          </h1>
          <ul class="scope" aria-label="Coverage">
            <li class="capsule capsule-see"><i aria-hidden="true"></i>SpaceSight · Sees</li>
            {ind.scope.map((zone) => <li class="zone">{zone}</li>)}
          </ul>
        </div>

        <div class="frame-wrap">
          <figure class="console">
            <div class="console-bar">
              <span class="rec"><i aria-hidden="true"></i>REC</span>
              <span class="console-cam">{ind.camLabel}</span>
              <span class="console-time">{ind.time}</span>
            </div>
            <div class="console-view console-view-svg">
              <svg viewBox="0 0 200 200" role="img" aria-label={ind.imgAlt}>
                <g class="scene-ring" set:html={RING} />
                <g set:html={ind.scene} />
              </svg>
              <span class="vc vc-tl" aria-hidden="true"></span>
              <span class="vc vc-tr" aria-hidden="true"></span>
              <span class="vc vc-bl" aria-hidden="true"></span>
              <span class="vc vc-br" aria-hidden="true"></span>
              <span class="scanline" aria-hidden="true"></span>
            </div>
            <dl class="telemetry">
              <div>
                <dt>Coverage</dt>
                <dd>{ind.time}</dd>
              </div>
              <div>
                <dt>Insight</dt>
                <dd>By store & hour</dd>
              </div>
              <div>
                <dt>Zones</dt>
                <dd>{ind.scope.join(' · ')}</dd>
              </div>
            </dl>
          </figure>
          <p class="figcap"><span class="figcap-id">Fig. 01</span><span class="figcap-alt">{ind.imgAlt}</span></p>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="sec-problem">
      <div class="container">
        <header class="ruler">
          <span class="ruler-id">SEC.01</span>
          <span class="ruler-line" aria-hidden="true"></span>
          <h2 class="ruler-name" id="sec-problem">The problem</h2>
        </header>
        <div class="story-body" set:html={toParas(ind.problem)} />
      </div>
    </section>

    <section class="sec" aria-labelledby="sec-whynow">
      <div class="container">
        <header class="ruler">
          <span class="ruler-id">SEC.02</span>
          <span class="ruler-line" aria-hidden="true"></span>
          <h2 class="ruler-name" id="sec-whynow">Why now</h2>
        </header>
        <div class="story-body" set:html={toParas(ind.whyNow)} />
      </div>
    </section>

    <section class="sec sec-units" aria-labelledby="sec-how">
      <div class="container">
        <header class="ruler">
          <span class="ruler-id">SEC.03</span>
          <span class="ruler-line" aria-hidden="true"></span>
          <h2 class="ruler-name" id="sec-how">How SpaceSight helps</h2>
        </header>
        <div class="units">
          <article class="unit unit-see">
            <span class="uc uc-tl" aria-hidden="true"></span>
            <span class="uc uc-tr" aria-hidden="true"></span>
            <span class="uc uc-bl" aria-hidden="true"></span>
            <span class="uc uc-br" aria-hidden="true"></span>
            <header class="unit-head">
              <span class="unit-id">Unit.01</span>
              <h3 class="unit-name">SpaceSight</h3>
              <span class="unit-tag">Sees</span>
              <span class="unit-status"><i aria-hidden="true"></i>Active</span>
            </header>
            <p class="unit-body">{ind.how}</p>
            <footer class="unit-foot">{ind.camLabel} · <a href="/spacesight/" class="unit-link">Explore SpaceSight →</a></footer>
          </article>
        </div>

        {ind.bullets?.length > 0 && (
          <div class="result result-detail">
            <div class="result-head"><i aria-hidden="true"></i>What you can do</div>
            <ul>
              {ind.bullets.map((b) => (
                <li>
                  <span class="check" aria-hidden="true">
                    <svg viewBox="0 0 12 12" fill="none"><path d="M2.2 6.3 4.8 8.8 9.8 3.4" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <p set:html={bulletParts(b)} />
                </li>
              ))}
            </ul>
          </div>
        )}

        {ind.funnel && (
          <p class="funnel-strip">{ind.funnel}</p>
        )}

        {ind.note && (
          <aside class="note-box">
            <strong>Note:</strong> {ind.note}
          </aside>
        )}
      </div>
    </section>

    <section class="sec">
      <div class="container">
        <a class="others" href="/solutions/">
          See how it works for other industries <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <CTASection
      headline={`See it. Fix it —<br>for ${ind.name}.`}
      lead="Book a demo and we will walk through your floor, your shifts, and your standards — and show you what continuous visibility looks like."
      primaryLabel="Book a Demo"
    />
  </main>
  <Footer />
</Layout>

<style>
  .hud {
    --ok: #16A34A;
    --warn: #B45309;
    --alert: #B91C1C;
    --hairline: rgba(15, 23, 42, 0.14);
    --hairline-soft: rgba(15, 23, 42, 0.08);
    padding-top: calc(var(--header-height) + 22px);
  }

  .hud .ruler-name,
  .hud .unit-name {
    font-family: var(--font-display);
  }

  /* ---------------- Hero ---------------- */
  .ind-hero {
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .ind-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    gap: clamp(var(--space-md), 4vw, var(--space-xl));
    align-items: center;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--ind);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ind);
    border: 1px solid color-mix(in srgb, var(--ind) 40%, transparent);
    background: color-mix(in srgb, var(--ind-track) 9%, transparent);
    border-radius: 3px;
    padding: 0.4rem 0.7rem;
    margin-bottom: var(--space-md);
  }

  .eyebrow::before {
    content: '';
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--ind);
    box-shadow: 0 0 8px color-mix(in srgb, var(--ind-track) 80%, transparent);
  }

  .headline {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    max-width: none;
    margin-bottom: var(--space-md);
    text-wrap: balance;
  }

  .headline .line {
    display: block;
  }

  .headline .tail {
    color: var(--ind);
  }

  .headline .tail::after {
    content: '';
    display: inline-block;
    width: 0.42em;
    height: 0.82em;
    margin-left: 0.16em;
    transform: translateY(0.09em);
    background: var(--ind-track);
    animation: hud-blink 1.15s steps(1) infinite;
  }

  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scope li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 3px;
    padding: 0.35rem 0.65rem;
  }

  .capsule {
    color: var(--text);
    border: 1px solid var(--hairline);
    background: var(--bg-elevated);
  }

  .capsule i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .capsule-see i {
    background: #2563EB;
    box-shadow: 0 0 8px rgba(37, 99, 235, 0.9);
  }

  .zone {
    color: var(--text-secondary);
    border: 1px dashed var(--hairline);
  }

  /* ---------------- Monitored frame ---------------- */
  .frame-wrap {
    margin: 0;
  }

  .console {
    margin: 0;
    background: var(--bg-dark);
    border: 1px solid rgba(11, 16, 32, 0.7);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 32px 72px rgba(11, 16, 32, 0.3);
  }

  .console-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.62);
  }

  .rec {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #FF7070;
    white-space: nowrap;
  }

  .rec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FF4B4B;
    box-shadow: 0 0 10px rgba(255, 75, 75, 0.9);
    animation: hud-pulse 1.6s ease-in-out infinite;
  }

  .console-time {
    color: var(--ind-track);
    white-space: nowrap;
  }

  .console-view {
    position: relative;
    overflow: hidden;
  }

  .console-view img {
    display: block;
    width: 100%;
    height: auto;
  }

  .console-view-svg {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
  }

  .console-view-svg svg {
    width: 58%;
    height: auto;
    display: block;
    color: #60A5FA;
  }

  .scene-ring {
    transform-origin: 100px 112px;
    animation: scene-spin 28s linear infinite;
  }

  @keyframes scene-spin {
    to { transform: rotate(360deg); }
  }

