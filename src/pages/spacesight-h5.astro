(function () {
  'use strict';
  var toggle = document.querySelector('.nav-toggle');
  var drawer = document.getElementById('mobile-nav-drawer');
  var backdrop = document.querySelector('.nav-drawer-backdrop');
  if (!toggle || !drawer || !backdrop) return;

  var lastFocused = null;
  var lockedScrollY = 0;

  function focusables() {
    return drawer.querySelectorAll('a[href], button:not([disabled])');
  }
  function lockScroll() {
    lockedScrollY = window.scrollY;
    document.body.style.overflow = 'hidden';   /* mirrors leads.js openModal */
    document.body.style.position = 'fixed';    /* iOS Safari body-lock */
    document.body.style.top = '-' + lockedScrollY + 'px';
    document.body.style.left = '0';
    document.body.style.right = '0';
  }
  function unlockScroll() {
    document.body.style.overflow = '';
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    window.scrollTo(0, lockedScrollY);
  }
  function openDrawer() {
    lastFocused = document.activeElement;
    drawer.classList.add('is-open');
    backdrop.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    lockScroll();
    var first = focusables()[0];
    if (first) first.focus();
  }
  function closeDrawer() {
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    unlockScroll();
    if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
  }
  function isOpen() { return drawer.classList.contains('is-open'); }

  toggle.addEventListener('click', function () { isOpen() ? closeDrawer() : openDrawer(); });
  backdrop.addEventListener('click', closeDrawer);
  drawer.querySelectorAll('[data-nav-close]').forEach(function (el) {
    el.addEventListener('click', closeDrawer);
  });
  /* close on link click and on drawer CTA (leads.js opens modal after this handler) */
  drawer.querySelectorAll('a, [data-open-modal]').forEach(function (el) {
    el.addEventListener('click', closeDrawer);
  });

  document.addEventListener('keydown', function (e) {
    if (!isOpen()) return;
    if (e.key === 'Escape') { closeDrawer(); return; }
    if (e.key === 'Tab') {  /* minimal focus trap */
      var items = Array.prototype.slice.call(focusables());
      if (!items.length) return;
      var first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  /* safety: never leave the drawer open across the breakpoint */
  window.matchMedia('(min-width: 721px)').addEventListener('change', function (e) {
    if (e.matches && isOpen()) closeDrawer();
  });
})();
