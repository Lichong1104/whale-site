---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonicalUrl = `https://www.whale.sg/blog/${post.id}/`;
const pageTitle = post.data.seo?.title ?? post.data.title;
const pageDescription = post.data.seo?.description ?? post.data.description;
const categoryLabel = post.data.section === 'news-companies' ? 'Updates' : 'Products & Solutions';
const dateLabel = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const authorName = post.data.author;
const authorUrl = post.data.authorUrl;
const authorTitle = post.data.authorTitle;
const authorBio = post.data.authorBio;
const authorInitials = authorName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');

const extraSchema = [
  {
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: pageDescription,
    image: post.data.coverImage,
    datePublished: post.data.publishDate.toISOString(),
    ...(post.data.modifiedDate && { dateModified: post.data.modifiedDate.toISOString() }),
    author: post.data.authorUrl
      ? { '@type': 'Person', name: post.data.author, url: post.data.authorUrl }
      : { '@type': 'Organization', name: post.data.author },
    mainEntityOfPage: canonicalUrl,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.whale.sg/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },
    ],
  },
];
---

<Layout
  title={`${pageTitle} | Whale Blog`}
  description={pageDescription}
  ogImage={post.data.coverImage}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main>
    <article class="section pr">
      <div class="container pr-container">
        <a class="pr-back" href="/blog/"><span aria-hidden="true">←</span> Back to Blog</a>

        <header class="pr-head">
          <p class="pr-meta">
            <span class="pr-tag">{categoryLabel}</span>
            <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>{dateLabel}</time>
          </p>
          <h1 class="pr-title">{post.data.title}</h1>
          <div class="pr-author">
            <span class="pr-author-avatar" aria-hidden="true">{authorInitials}</span>
            <span class="pr-author-meta">
              <span class="pr-author-name">
                By {authorUrl ? (
                  <a href={authorUrl} target="_blank" rel="noopener noreferrer">{authorName}</a>
                ) : authorName}
              </span>
              {authorTitle && <span class="pr-author-role">{authorTitle}</span>}
            </span>
            {authorUrl && (
              <a
                class="pr-author-linkedin"
                href={authorUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${authorName} on LinkedIn`}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z" />
                </svg>
                <span>LinkedIn</span>
              </a>
            )}
          </div>
          <figure class="pr-cover">
            <img src={post.data.coverImage} alt={post.data.title} loading="eager" decoding="async" width="1200" height="675" />
          </figure>
        </header>

        <div class="pr-body">
          <Content />
        </div>

        {authorUrl && (
          <aside class="pr-author-card" aria-label="About the author">
            <span class="pr-author-avatar pr-author-avatar--lg" aria-hidden="true">{authorInitials}</span>
            <div class="pr-author-card-body">
              <p class="pr-author-card-label">About the author</p>
              <p class="pr-author-card-name">{authorName}</p>
              {authorTitle && <p class="pr-author-card-role">{authorTitle}</p>}
              {authorBio && <p class="pr-author-card-bio">{authorBio}</p>}
              <a
                class="pr-author-card-link"
                href={authorUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z" />
                </svg>
                Connect on LinkedIn
              </a>
            </div>
          </aside>
        )}

        {post.data.externalUrl && (
          <p class="pr-source">
            Originally published at
            <a href={post.data.externalUrl} target="_blank" rel="noopener noreferrer">whale.sg</a>.
          </p>
        )}
      </div>
    </article>

    <CTASection
      headline="Never miss what matters,<br>or wonder what it means."
      lead="Find out how space intelligence can power your operations forward."
      primaryLabel="Book a Demo"
    />
  </main>
  <Footer />
</Layout>

<style>
  .pr {
    padding-top: calc(var(--header-height) + var(--space-lg));
  }

  .pr-container {
    max-width: 760px;
  }

  .pr-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-md);
    transition: color 0.2s ease;
  }

  .pr-back:hover {
    color: var(--text);
  }

  .pr-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0 0 var(--space-sm);
  }

  .pr-tag {
    background: #EFF4FF;
    color: #1D4ED8;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }

  .pr-title {
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.25;
    margin: 0 0 var(--space-md);
  }

  .pr-author {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    margin: calc(var(--space-xs) * -1) 0 var(--space-md);
    background: var(--bg-elevated);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: var(--radius-sm);
  }

  .pr-author-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563EB 0%, #06B6D4 100%);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .pr-author-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .pr-author-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }

  .pr-author-name a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid rgba(37, 99, 235, 0.35);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .pr-author-name a:hover {
    color: #1D4ED8;
    border-color: #1D4ED8;
  }

  .pr-author-role {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .pr-author-linkedin {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0A66C2;
    background: #EAF3FB;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .pr-author-linkedin svg {
    width: 15px;
    height: 15px;
  }

  .pr-author-linkedin:hover {
    background: #0A66C2;
    color: #fff;
  }

  .pr-author-card {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--bg-tint);
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: var(--radius);
  }

  .pr-author-avatar--lg {
    width: 56px;
    height: 56px;
    font-size: 1.05rem;
  }

  .pr-author-card-body p {
    margin: 0;
  }

  .pr-author-card-body .pr-author-card-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
  }

  .pr-author-card-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .pr-author-card-role {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .pr-author-card-body .pr-author-card-bio {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 0.4rem;
  }

  .pr-author-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0A66C2;
    text-decoration: none;
  }

  .pr-author-card-link svg {
    width: 15px;
    height: 15px;
  }

  .pr-author-card-link:hover {
    text-decoration: underline;
  }

  .pr-cover {
    margin: 0 0 var(--space-lg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .pr-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .pr-body :global(p) {
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0 0 var(--space-sm);
  }

  .pr-body :global(p strong) {
    color: var(--text);
  }

  .pr-body :global(p:first-of-type) {
    font-size: 1.08rem;
  }

  .pr-body :global(h2),
  .pr-body :global(h3) {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    margin: var(--space-lg) 0 var(--space-sm);
    color: var(--text);
  }

  .pr-body :global(h3) {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
  }

  .pr-body :global(ul),
  .pr-body :global(ol) {
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0 0 var(--space-sm);
    padding-left: 1.4rem;
  }

  .pr-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .pr-body :global(blockquote) {
    margin: var(--space-md) 0;
    padding: var(--space-sm) var(--space-md);
    border-left: 3px solid #2563EB;
    background: #EFF4FF;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .pr-body :global(blockquote p) {
    font-size: 1.02rem;
    font-style: italic;
    color: var(--text);
    margin: 0 0 0.75rem;
  }

  .pr-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin: var(--space-sm) 0;
  }

  .pr-body :global(video) {
    width: 100%;
    border-radius: var(--radius-sm);
    margin: var(--space-sm) 0 var(--space-md);
    display: block;
    background: #000;
  }

  .pr-body :global(a) {
    color: #1D4ED8;
  }

  .pr-source {
    margin-top: var(--space-lg);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .pr-source a {
    color: #1D4ED8;
  }
</style>
