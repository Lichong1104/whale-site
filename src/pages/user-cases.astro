  /* reveal on scroll — static by default so no-JS stays readable */
  [data-reveal] {
    --reveal-d: calc(var(--i, 0) * 90ms);
  }

  [data-reveal].is-in {
    animation: uc-reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: var(--reveal-d);
