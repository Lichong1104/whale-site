</style>

<script is:inline>
  (function () {
    'use strict';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* Hero entrance */
    const head = document.querySelector('[data-co-head]');
    if (head) {
      requestAnimationFrame(() => head.classList.add('is-live'));
    }

    /* Reveal on scroll */
    const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
    const timeline = document.querySelector('[data-timeline]');
    if ('IntersectionObserver' in window && !reduceMotion.matches) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
      revealEls.forEach((el) => io.observe(el));
      if (timeline) io.observe(timeline);
    } else {
      revealEls.forEach((el) => el.classList.add('is-in'));
      if (timeline) timeline.classList.add('is-in');
    }

    /* Team bio expanders — content stays fully visible without JS */
    const teamGrid = document.querySelector('[data-team]');
    if (teamGrid) {
      teamGrid.setAttribute('data-armed', '');
      teamGrid.querySelectorAll('[data-bio-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest('[data-bio-card]');
          const open = card.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
    }

    /* Chapter scrollspy */
    const chapterLinks = Array.from(document.querySelectorAll('[data-chapter-link]'));
    const chapterSections = chapterLinks
      .map((a) => document.getElementById(a.getAttribute('data-chapter-link')))
      .filter(Boolean);
    if ('IntersectionObserver' in window && chapterSections.length) {
      let active = null;
      const setActive = (id) => {
        if (id === active) return;
        active = id;
        chapterLinks.forEach((a) => {
          const on = a.getAttribute('data-chapter-link') === id;
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      };
      const spy = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      }, { rootMargin: '-30% 0px -55% 0px', threshold: 0 });
      chapterSections.forEach((s) => spy.observe(s));
      setActive('about');
    }
  })();
</script>
