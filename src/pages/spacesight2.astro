---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.whale.sg/spacesight2/';
const pageDescription = 'SpaceSight turns existing cameras into real-time operational intelligence, helping teams improve compliance, customer flow, and store performance across every location.';

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'SpaceSight', item: canonicalUrl }
    ]
  }
];

const headlineBase = 'Physical Operations Intelligence for'.split(' ');
const headlineTail = 'Better Compliance, Customer Flow, and Store Performance'.split(' ');

const heroProof = [
  { n: '1,600+', label: 'Enterprise clients' },
  { n: '45+', label: 'Countries deployed' },
  { n: '600,000+', label: 'Edge AI nodes globally' }
];

const procedures = [
  {
    id: 'proc-a',
    ref: 'A',
    name: 'Audit Every Site Consistently',
    tags: 'AI Audit Platform · Automated Compliance Audit',
    paras: [
      'Replace manual checks with consistent, visual compliance workflows. SpaceSight continuously reviews site conditions, flags exceptions, and gives teams the evidence they need to act.',
      'Monitor standards such as queue conditions, cleanliness, display execution, safety procedures, merchandising, and SOP compliance across every site, every day.'
    ],
    impact: 'Faster audits · Fewer missed exceptions · Clearer accountability'
  },
  {
    id: 'proc-b',
    ref: 'B',
    name: 'Understand Customer Movement',
    tags: 'Retail Video Analytics · Customer Flow Analytics',
    paras: [
      'See how customers move, stop, queue, and convert across stores and spaces. SpaceSight measures footfall, passerby rate, entry rate, dwell time, conversion, queueing, and traffic patterns by store, zone, or campaign.',
      'Privacy-conscious video analysis uses non-biometric signals such as body shape, gait, and clothing, not facial recognition. These insights help teams improve staffing, layouts, campaign evaluation, store optimization, and space optimization with real behavioral data.'
    ],
    impact: 'Better staffing decisions · Smarter layouts · More measurable campaigns'
  },
  {
    id: 'proc-c',
    ref: 'C',
    name: 'Turn Insights Into Action',
    tags: 'Enterprise AIOS · Agent Orchestration · SpaceClaw',
    paras: [
      'SpaceClaw connects analytics with action. Teams can ask operational questions such as “Why did conversion drop yesterday?” or “Which stores showed abnormal dwell time?”',
      'SpaceSight retrieves relevant footage, identifies possible root causes, creates work orders, dispatches follow-up tasks, and generates operational reports automatically. Agent orchestration creates a closed operational loop from detection to resolution.'
    ],
    impact: 'Faster root-cause analysis · Less manual reporting · Quicker issue resolution'
  }
];

const hardware = [
  { name: 'Existing cameras', desc: 'Reuse current CCTV, NVR, and VMS infrastructure as the signal source.' },
  { name: 'Video Hub', desc: 'Aggregates and routes video streams where coverage needs to expand.' },
  { name: 'AI Hub', desc: 'On-premises edge AI processing for video analytics at the site.' },
  { name: 'Edge AI Camera', desc: 'Cameras with onboard AI processing for new or upgraded zones.' },
  { name: 'Hybrid deployment', desc: 'A mix assessed per site — coverage, network, and use cases decide.' }
];

const deploySteps = [
  { n: '1', name: 'Assess', body: 'Review site layout, camera placement, network conditions, priority use cases, and success metrics, from footfall and dwell time to loss prevention and AI inspection.' },
  { n: '2', name: 'Connect', body: 'Reuse existing CCTV, NVR, and VMS infrastructure where possible. Add Edge AI Cameras, AI Hub, or Video Hub where coverage or local processing needs to expand.' },
  { n: '3', name: 'Configure', body: 'Set up camera channels, AI models, zones of interest, thresholds, and business rules for workflows such as customer flow analytics, queue detection, table-cleaning inspection, and compliance audit.' },
  { n: '4', name: 'Optimize', body: 'Validate with real site footage, monitor device and stream health, then fine-tune camera angles, zones, thresholds, and AI configurations as operations evolve.' }
];

const certs = [
  { src: '/cert-logos/soc2.png', alt: 'SOC 2 Type II', label: 'SOC 2 Type II' },
  { src: '/cert-logos/gdpr.png', alt: 'GDPR Compliant', label: 'GDPR Compliant' },
  { src: '/cert-logos/iso27001.jpg', alt: 'ISO 27001', label: 'ISO 27001' },
  { src: '/cert-logos/iso9001.jpg', alt: 'ISO 9001', label: 'ISO 9001' },
  { src: '/cert-logos/cmmi.jpg', alt: 'CMMI Level 5', label: 'CMMI Level 5' }
];

const tabs = [
  { id: 'cover', label: 'COVER' },
  { id: 'proc-a', label: 'A·AUDIT' },
  { id: 'proc-b', label: 'B·FLOW' },
  { id: 'proc-c', label: 'C·ACT' },
  { id: 'visibility', label: 'VISION' },
  { id: 'deployment', label: 'DEPLOY' },
  { id: 'security', label: 'TRUST' },
  { id: 'faq', label: 'FAQ' }
];
---

<Layout
  title="SpaceSight | Physical Operations Intelligence Platform"
  description={pageDescription}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main class="ss2">
    <!--
      DIRECTION CONTRACT — /spacesight2/
      THESIS: the page is SpaceSight's own field manual — the product audits SOP
        compliance and operational procedure, so the surface takes the form of the
        procedure document its buyer lives inside. Refuses the standard
        hero-plus-alternating-features landing grid.
      OWN-WORLD: company blue #2563EB on vacuum white, Poppins display / Manrope
        body / Space Mono for doc-control, figure captions, and spec data. Figure
        plates with mono caption strips, ledger hairlines, stamp-style result
        lines, fore-edge tab rail.
      STORY: an operations leader reads cover (offer + proof) → three procedures
        (audit, flow, act) → why footage is not intelligence → deployment hardware
        → four-step rollout → trust and compliance → FAQ → book a demo.
      FIRST VIEWPORT: doc-control strip across the top (DOC SS-OPS-01 · REV
        2026.09 · FIELD MANUAL), title block left with blue-highlighted key
        phrases, FIG.00 plate right (AI Audit capture), proof ledger below,
        Book a Demo primary + See Use Cases ghost.
      FORM: field manual / spec-sheet — candidate 4 of the grounded list, seed
        key 77fc822f; acetate-tab challenger fused as the fore-edge tab rail.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
        finish review, the verdict, and DESIGN.md.
    -->

    <!-- ================= COVER ================= -->
    <section class="section ss2-cover" id="cover" data-tab="cover">
      <div class="container">
        <div class="ss2-doc" data-reveal>
          <span>SpaceSight · Field Manual</span>
          <span>DOC SS-OPS-01 · REV 2026.09</span>
        </div>

        <div class="ss2-cover-grid">
          <div class="ss2-cover-copy">
            <h1 class="ss2-h1" data-ss2-head>
              {headlineBase.map((word, i) => (
                <Fragment><span class="wm"><span class="w" style={`--i:${i}`}>{word}</span></span>{' '}</Fragment>
              ))}
              <span class="ss2-tail">
                {headlineTail.map((word, i) => (
                  <Fragment><span class="wm"><span class="w" style={`--i:${i + 4}`}>{word}</span></span>{' '}</Fragment>
                ))}
              </span>
            </h1>
            <p class="ss2-sub" data-reveal style="--i:8">
              SpaceSight turns existing cameras into <em class="ss2-hl">real-time operational intelligence</em>,
              helping teams improve <em class="ss2-hl">compliance, customer flow, and store performance</em> across every location.
            </p>
            <div class="ss2-cover-cta" data-reveal style="--i:9">
              <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="spacesight2页-Hero留资">Book a Demo</button>
              <a href="/user-cases/" class="btn btn-ghost btn-large">See Use Cases</a>
            </div>
          </div>

          <figure class="ss2-plate" data-reveal style="--i:5">
            <div class="ss2-plate-media">
              <picture>
                <source srcset="/products/ss2-ai-audit.webp" type="image/webp" />
                <img src="/products/ss2-ai-audit.png" alt="SpaceSight AI audit interface reviewing store compliance on live camera footage" width="1376" height="768" loading="eager" decoding="async" />
              </picture>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. 00</span><span>AI audit pass — exception flagged, evidence attached</span></figcaption>
          </figure>
        </div>

        <dl class="ss2-proof" data-reveal style="--i:10">
          {heroProof.map((p) => (
            <div class="ss2-proof-cell">
              <dt>{p.label}</dt>
              <dd>{p.n}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ================= PART 01 · OPERATING PROCEDURES ================= -->
    <section class="section section-tint ss2-part" aria-labelledby="ss2-part1">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 01 — Operating Procedures</span>
          <h2 class="ss2-h2" id="ss2-part1">One Platform for Insight and Action</h2>
        </header>

        <!-- PROC A -->
        <article class="ss2-proc" id="proc-a" data-tab="proc-a">
          <div class="ss2-proc-copy" data-reveal>
            <header class="ss2-proc-head">
              <span class="ss2-proc-ref">Procedure {procedures[0].ref}</span>
              <h3 class="ss2-h3">{procedures[0].name}</h3>
              <p class="ss2-tags">{procedures[0].tags}</p>
            </header>
            {procedures[0].paras.map((t) => <p class="ss2-body">{t}</p>)}
            <p class="ss2-stamp"><span>Result</span>{procedures[0].impact}</p>
          </div>
          <figure class="ss2-plate ss2-fig" data-reveal>
            <div class="ss2-plate-media ss2-fig-media">
              <svg viewBox="0 0 560 380" role="img" aria-label="Schematic of an automated compliance audit: camera frame with checklist rows marked pass and exception">
                <rect x="18" y="18" width="300" height="210" fill="none" stroke="currentColor" stroke-width="1.5" class="ss2-svg-ink"/>
                <path d="M18 48 h300" stroke="currentColor" stroke-width="1" class="ss2-svg-ink" opacity=".4"/>
                <text x="30" y="39" class="ss2-svg-mono">CAM 04 · AISLE VIEW</text>
                <rect x="42" y="82" width="120" height="86" fill="none" stroke="#2563EB" stroke-width="2"/>
                <text x="42" y="76" class="ss2-svg-mono ss2-svg-blue">QUEUE · 6</text>
                <rect x="196" y="112" width="90" height="60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4" class="ss2-svg-ink"/>
                <text x="196" y="106" class="ss2-svg-mono">DISPLAY</text>
                <g class="ss2-svg-ink">
                  <text x="340" y="60" class="ss2-svg-mono ss2-svg-head">AUDIT CHECKS</text>
                  <g transform="translate(340,84)">
                    <rect width="14" height="14" fill="none" stroke="#2563EB" stroke-width="2"/>
                    <path d="M3 7.5 l3 3.5 l5.5 -7" fill="none" stroke="#2563EB" stroke-width="2"/>
                    <text x="24" y="12" class="ss2-svg-mono">Queue length ≤ 8</text>
                  </g>
                  <g transform="translate(340,116)">
                    <rect width="14" height="14" fill="none" stroke="#2563EB" stroke-width="2"/>
                    <path d="M3 7.5 l3 3.5 l5.5 -7" fill="none" stroke="#2563EB" stroke-width="2"/>
                    <text x="24" y="12" class="ss2-svg-mono">Aisle clearance</text>
                  </g>
                  <g transform="translate(340,148)">
                    <rect width="14" height="14" fill="none" stroke="#2563EB" stroke-width="2"/>
                    <path d="M3 7.5 l3 3.5 l5.5 -7" fill="none" stroke="#2563EB" stroke-width="2"/>
                    <text x="24" y="12" class="ss2-svg-mono">Display execution</text>
                  </g>
                  <g transform="translate(340,180)">
                    <rect width="14" height="14" fill="none" stroke="#DC2626" stroke-width="2"/>
                    <path d="M3 3 l8 8 M11 3 l-8 8" stroke="#DC2626" stroke-width="2"/>
                    <text x="24" y="12" class="ss2-svg-mono">Safety exit blocked</text>
                  </g>
                </g>
                <path d="M318 228 h224 v120 h-224 z" fill="none" stroke="currentColor" stroke-width="1" class="ss2-svg-ink" opacity=".35"/>
                <text x="330" y="252" class="ss2-svg-mono ss2-svg-head">EVIDENCE</text>
                <text x="330" y="276" class="ss2-svg-mono">Clip 14:02:33–14:02:49</text>
                <text x="330" y="298" class="ss2-svg-mono">Snapshot attached</text>
                <text x="330" y="320" class="ss2-svg-mono">Owner: Store #118</text>
                <path d="M18 262 h300" stroke="currentColor" stroke-width="1" class="ss2-svg-ink" opacity=".25"/>
                <text x="18" y="284" class="ss2-svg-mono">SOP COMPLIANCE — STORE #118</text>
                <text x="18" y="310" class="ss2-svg-data">94.2%</text>
                <text x="18" y="334" class="ss2-svg-mono">LAST 24H · 41 CHECKS · 1 EXCEPTION</text>
              </svg>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. A</span><span>Automated compliance audit — schematic, synthetic data</span></figcaption>
          </figure>
        </article>

        <!-- PROC B -->
        <article class="ss2-proc ss2-proc-flip" id="proc-b" data-tab="proc-b">
          <div class="ss2-proc-copy" data-reveal>
            <header class="ss2-proc-head">
              <span class="ss2-proc-ref">Procedure {procedures[1].ref}</span>
              <h3 class="ss2-h3">{procedures[1].name}</h3>
              <p class="ss2-tags">{procedures[1].tags}</p>
            </header>
            {procedures[1].paras.map((t) => <p class="ss2-body">{t}</p>)}
            <p class="ss2-stamp"><span>Result</span>{procedures[1].impact}</p>
          </div>
          <figure class="ss2-plate ss2-fig" data-reveal>
            <div class="ss2-plate-media ss2-fig-media">
              <svg viewBox="0 0 560 380" role="img" aria-label="Schematic store plan with a customer path traced from entrance through zones to checkout, with dwell markers">
                <g class="ss2-svg-ink" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="20" y="20" width="360" height="300"/>
                  <path d="M20 320 h360" stroke-width="1" opacity=".4"/>
                  <rect x="52" y="60" width="88" height="60"/>
                  <rect x="52" y="150" width="88" height="60"/>
                  <rect x="180" y="60" width="88" height="60"/>
                  <rect x="180" y="150" width="88" height="60"/>
                  <rect x="300" y="60" width="60" height="150"/>
                  <path d="M20 250 h60" stroke-width="1"/>
                  <path d="M20 290 h60" stroke-width="1"/>
                </g>
                <g class="ss2-svg-mono">
                  <text x="52" y="52">ZONE A</text>
                  <text x="52" y="142">ZONE B</text>
                  <text x="180" y="52">ZONE C</text>
                  <text x="180" y="142">ZONE D</text>
                  <text x="300" y="52">CHECKOUT</text>
                  <text x="24" y="344">ENTRANCE</text>
                </g>
                <path d="M50 336 C 90 300, 70 240, 96 210 S 150 130, 190 100 S 260 110, 300 130 L 330 135" fill="none" stroke="#2563EB" stroke-width="2.5"/>
                <g fill="#2563EB">
                  <circle cx="50" cy="336" r="4.5"/>
                  <circle cx="330" cy="135" r="4.5"/>
                </g>
                <g fill="none" stroke="#2563EB" stroke-width="1.5">
                  <circle cx="96" cy="210" r="9"/>
                  <circle cx="190" cy="100" r="9"/>
                </g>
                <g class="ss2-svg-mono ss2-svg-blue">
                  <text x="110" y="234">DWELL 4.1m</text>
                  <text x="200" y="132">DWELL 6.8m</text>
                </g>
                <g class="ss2-svg-ink">
                  <text x="410" y="52" class="ss2-svg-mono ss2-svg-head">FLOW — TODAY</text>
                  <text x="410" y="88" class="ss2-svg-mono">Footfall</text>
                  <text x="410" y="114" class="ss2-svg-data">2,314</text>
                  <text x="410" y="150" class="ss2-svg-mono">Entry rate</text>
                  <text x="410" y="176" class="ss2-svg-data">38.4%</text>
                  <text x="410" y="212" class="ss2-svg-mono">Avg dwell</text>
                  <text x="410" y="238" class="ss2-svg-data">5.6 min</text>
                  <text x="410" y="274" class="ss2-svg-mono">Conversion</text>
                  <text x="410" y="300" class="ss2-svg-data">21.7%</text>
                  <text x="410" y="332" class="ss2-svg-mono">Non-biometric ReID —</text>
                  <text x="410" y="350" class="ss2-svg-mono">no facial recognition</text>
                </g>
              </svg>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. B</span><span>Customer flow trace — schematic, synthetic data</span></figcaption>
          </figure>
        </article>

        <!-- PROC C -->
        <article class="ss2-proc" id="proc-c" data-tab="proc-c">
          <div class="ss2-proc-copy" data-reveal>
            <header class="ss2-proc-head">
              <span class="ss2-proc-ref">Procedure {procedures[2].ref}</span>
              <h3 class="ss2-h3">{procedures[2].name}</h3>
              <p class="ss2-tags">{procedures[2].tags}</p>
            </header>
            {procedures[2].paras.map((t) => <p class="ss2-body">{t}</p>)}
            <p class="ss2-stamp"><span>Result</span>{procedures[2].impact}</p>
          </div>
          <figure class="ss2-plate ss2-plate-phone" data-reveal>
            <div class="ss2-plate-media">
              <video src="/products/ss2-spaceclaw-app.mp4" poster="/products/ss2-spaceclaw-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="SpaceSight mobile app — SpaceClaw operational assistant in use" style="aspect-ratio: 720/1558"></video>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. C</span><span>SpaceClaw on mobile — ask, retrieve, dispatch</span></figcaption>
          </figure>
        </article>
      </div>
    </section>

    <!-- ================= PART 02 · VISIBILITY ================= -->
    <section class="section ss2-part" id="visibility" data-tab="visibility" aria-labelledby="ss2-vis-h">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 02 — Visibility</span>
          <h2 class="ss2-h2" id="ss2-vis-h">From Passive Cameras to Actionable Operations</h2>
        </header>

        <div class="ss2-vis-grid">
          <figure class="ss2-plate" data-reveal>
            <div class="ss2-plate-media">
              <video src="/products/ss2-visibility.mp4" poster="/products/ss2-visibility-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="SpaceSight platform demo — natural-language video search across cameras" style="aspect-ratio: 1920/1324"></video>
            </div>
            <figcaption class="ss2-plate-cap"><span>FIG. 02</span><span>Video search — ask in plain language, get footage back</span></figcaption>
          </figure>
          <div class="ss2-vis-copy" data-reveal>
            <p class="ss2-lede">Most monitoring systems only record what happened. SpaceSight helps teams understand <strong>what is happening, why it matters, and what to do next.</strong></p>
            <p class="ss2-body">Built for physical operations intelligence, SpaceSight connects with existing CCTV, AI cameras, sensors, and edge AI devices to turn video and sensor data into real-time insights for store operations, loss prevention, compliance, and customer experience.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PART 03 · DEPLOYMENT ================= -->
    <section class="section section-tint ss2-part" id="deployment" data-tab="deployment" aria-labelledby="ss2-dep-h">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 03 — Deployment</span>
          <h2 class="ss2-h2" id="ss2-dep-h">Built for Real-World Deployment</h2>
          <p class="ss2-body ss2-part-lede">SpaceSight works with existing CCTV, NVR/VMS systems, AI Hub, Video Hub, Edge AI Cameras, or hybrid deployments. Our team assesses camera coverage, network readiness, target use cases, and rollout priorities before recommending the right setup.</p>
        </header>

        <div class="ss2-ledger" data-reveal>
          <p class="ss2-ledger-head"><span>HW</span><span>Option</span><span>Role in deployment</span></p>
          {hardware.map((h, i) => (
            <div class="ss2-ledger-row">
              <span class="ss2-ledger-no">HW-{i + 1}</span>
              <span class="ss2-ledger-name">{h.name}</span>
              <span class="ss2-ledger-desc">{h.desc}</span>
            </div>
          ))}
        </div>

        <h3 class="ss2-h3 ss2-steps-h" data-reveal>Deployment and Continuous Optimization</h3>
        <ol class="ss2-steps" data-reveal>
          {deploySteps.map((s) => (
            <li class="ss2-step">
              <span class="ss2-step-no">Step {s.n}</span>
              <span class="ss2-step-name">{s.name}</span>
              <p class="ss2-step-body">{s.body}</p>
            </li>
          ))}
        </ol>
        <aside class="ss2-note" data-reveal aria-label="Deployment guidance">
          <span class="ss2-note-tag">Note — Deployment Guidance</span>
          <div class="ss2-note-text">
            <p class="ss2-note-q">Not sure what your site needs?</p>
            <p class="ss2-note-a">Book a demo and we will help assess your deployment path.</p>
          </div>
          <button type="button" class="btn btn-primary ss2-note-btn" data-open-modal data-source-type="spacesight2页-部署咨询留资">Book a demo</button>
        </aside>
      </div>
    </section>

    <!-- ================= PART 04 · TRUST ================= -->
    <section class="section ss2-part" id="security" data-tab="security" aria-labelledby="ss2-sec-h">
      <div class="container">
        <header class="ss2-part-head" data-reveal>
          <span class="ss2-part-no">Part 04 — Trust</span>
          <h2 class="ss2-h2" id="ss2-sec-h">Security, Privacy, and Compliance by Design</h2>
        </header>

        <div class="ss2-ledger" data-reveal>
          <p class="ss2-ledger-head"><span>REF</span><span>Provision</span><span>What it means</span></p>
          <div class="ss2-ledger-row">
            <span class="ss2-ledger-no">T-1</span>
            <span class="ss2-ledger-name">No Facial Recognition</span>
            <span class="ss2-ledger-desc">People tracking uses non-biometric re-identification signals, not facial recognition.</span>
          </div>
          <div class="ss2-ledger-row">
            <span class="ss2-ledger-no">T-2</span>
            <span class="ss2-ledger-name">Edge AI Processing</span>
            <span class="ss2-ledger-desc">Video can be processed locally on AI Hub or Edge AI Camera. Only metadata, analytics, and anomaly events need to be sent to the cloud, reducing bandwidth use by up to 80%.</span>
          </div>
          <div class="ss2-ledger-row">
            <span class="ss2-ledger-no">T-3</span>
            <span class="ss2-ledger-name">Enterprise-Grade Standards</span>
            <span class="ss2-ledger-desc">Certified and audited against the standards enterprise IT and legal teams ask for.</span>
          </div>
        </div>

        <ul class="ss2-certs" data-reveal>
          {certs.map((c) => (
            <li class="ss2-cert">
              <img src={c.src} alt={c.alt} width="120" height="60" loading="lazy" decoding="async" />
              <span>{c.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <div data-tab="faq">
      <FAQSection />
    </div>

    <!-- ================= CLOSING ================= -->
    <CTASection
      headline="Physical Operations Intelligence for Better Compliance, Customer Flow, and Store Performance."
      lead="See what your existing cameras can tell you."
      primaryLabel="Book a Demo"
      sourceType="spacesight2页-底部留资"
      secondaryLabel="See Use Cases"
      secondaryHref="/user-cases/"
    />

    <!-- fore-edge tab rail (inside .ss2 for token scope) -->
    <nav class="ss2-tabs" aria-label="Manual sections">
      {tabs.map((t) => (
        <a href={`#${t.id}`} class="ss2-tab" data-tab-link={t.id}>{t.label}</a>
      ))}
    </nav>
  </main>
  <Footer />
</Layout>

