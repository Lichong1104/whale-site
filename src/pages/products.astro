---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HardwareSection from '../components/HardwareSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import IntegratedPlatformSection from '../components/IntegratedPlatformSection.astro';
import CasesSection from '../components/CasesSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.whale.sg/products/';
const pageDescription = 'Whale products: SpaceSight turns cameras into real-time space intelligence; Echo captures and analyzes frontline voice. One operational intelligence loop.';

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: canonicalUrl }
    ]
  }
];
---

<Layout
  title="Products | Whale AI"
  description={pageDescription}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main>
    <section class="section products-intro">
      <div class="container">
        <div class="section-head center">
          <h1>Products</h1>
          <p>SpaceSight sees. Echo hears. One operational intelligence loop.</p>
        </div>
      </div>
    </section>

    <section class="section section-tint loop" id="loop" aria-label="The operational intelligence loop">
      <div class="container">
        <ol class="loop-steps">
          <li class="loop-step" style="--loop-color: #FFD23F">
            <span class="loop-step-label">See</span>
            <p>SpaceSight turns cameras into continuous space intelligence.</p>
          </li>
          <li class="loop-step" style="--loop-color: #00E5FF">
            <span class="loop-step-label">Hear</span>
            <p>Echo turns frontline conversations into structured voice intelligence.</p>
          </li>
          <li class="loop-step" style="--loop-color: #FF4D8D">
            <span class="loop-step-label">Understand</span>
            <p>One AI platform fuses both streams into decision-ready insight.</p>
          </li>
          <li class="loop-step" style="--loop-color: #8B5CF6">
            <span class="loop-step-label">Act</span>
            <p>Reports, alerts, and tasks reach the right person automatically.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="section pd" id="spacesight">
      <div class="container">
        <div class="pd-head">
          <span class="pd-chip pd-chip-spacesight">SpaceSight · Sees</span>
          <h2 class="pd-headline">See what's actually happening — before it becomes a problem.</h2>
          <p class="pd-subhead">SpaceSight turns raw physical-space data into real-time intelligence — built for teams who can't afford blind spots.</p>
        </div>

        <div class="pd-media">
          <video src="/products/spacesight-demo-eng.mp4" poster="/products/spacesight-demo-poster.jpg" autoplay muted loop controls preload="metadata" playsinline aria-label="SpaceSight product demo"></video>
        </div>

        <div class="pd-caps">
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-spacesight">Automated Detection &amp; Audit</span>
            <h3 class="pd-cap-slogan">"Catch everything, without watching everything."</h3>
            <p>SpaceSight audits your space continuously, using zero-shot AI detection that works the moment it's deployed — no training data, no setup lag. Just describe what to check in plain English ("check aisle 3 shelves every 90 minutes") and let it run.</p>
            <p>The same detection engine that flags a compliance gap also catches loitering, unauthorized access, or checkout anomalies in real time — so whether you're auditing operations or preventing loss, nothing slips through unnoticed.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-spacesight">SpaceClaw: Ask &amp; Find</span>
            <h3 class="pd-cap-slogan">"Find any moment in seconds, just by asking."</h3>
            <p>Describe what you're looking for in plain language, and SpaceClaw pulls the exact clip — no scrubbing through hours of footage. Investigating an incident, resolving a dispute, or just confirming what happened at a specific time: what used to take an afternoon now takes seconds.</p>
            <p>And SpaceClaw doesn't just search on command — when it spots something on its own, it can dispatch a task straight to the right person's phone.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-spacesight">Intelligent Reporting</span>
            <h3 class="pd-cap-slogan">"Your daily report, ready before you are."</h3>
            <p>SpaceSight turns what it sees into a clear, structured report — compliance rates, foot traffic, stock levels — delivered automatically, on schedule. No manual compilation, no waiting.</p>
            <p>Beyond the numbers, it recommends what to do next: restock alerts, staffing adjustments, loss-prevention flags — so reports drive action instead of sitting unread in an inbox.</p>
          </article>
        </div>

        <div class="pd-cta">
          <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="products页Book a demo留资">Book a demo</button>
        </div>
      </div>
    </section>

    <section class="section section-tint pd" id="echo">
      <div class="container">
        <div class="pd-head">
          <span class="pd-chip pd-chip-echo">Echo · Hears</span>
          <h2 class="pd-headline">Hear what matters — and never lose it in the noise.</h2>
          <p class="pd-subhead">Echo captures and understands the communication behind your operations, feeding straight into our AI for instant, decision-ready insight.</p>
        </div>

        <div class="pd-media">
          <video src="/products/echo-demo-eng.mp4" poster="/products/echo-demo-poster.jpg" autoplay muted loop controls preload="metadata" playsinline aria-label="Echo product demo"></video>
        </div>

        <div class="pd-caps">
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-echo">Always-On Capture</span>
            <h3 class="pd-cap-slogan">"Every conversation, captured without lifting a finger."</h3>
            <p>Echo wearables (Pin or Buds) capture conversations hands-free, with directional audio that stays clear even in noisy environments. Every interaction is automatically recorded and structured in real time — no manual note-taking, nothing lost.</p>
            <p>With support for 30+ languages and real-time translation, your team can capture and understand conversations wherever business happens, in whatever language it happens in.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-echo">Custom Analytics Engine</span>
            <h3 class="pd-cap-slogan">"Insight tuned to how your industry actually works."</h3>
            <p>Echo doesn't apply a generic transcript template to every conversation — it analyzes against your industry's own knowledge graph, extracting what matters for healthcare, legal, finance, retail, and 100+ other specialized verticals.</p>
            <p>Configure your own analysis dimensions, or set a persona — like "Senior Sales Coach" — to review every conversation with specialized judgment.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-echo">EchoClaw: Hands-Free Execution</span>
            <h3 class="pd-cap-slogan">"Say it once. Consider it done."</h3>
            <p>Echo doesn't stop at understanding — it acts. A single voice command ("send the meeting summary to the client") triggers Echo to handle it automatically, connecting directly to your CRM, ERP, and other tools without manual data entry.</p>
            <p>This is where conversation becomes action — the same execution layer that powers the rest of the AI story across the platform.</p>
          </article>
        </div>

        <div class="pd-cta">
          <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="products页Echo Book a demo留资">Book a demo</button>
        </div>
      </div>
    </section>

    <IntegratedPlatformSection />
    <CapabilitiesSection showFeatures={false} />
    <HardwareSection />
    <CasesSection />

    <CTASection />
  </main>
  <Footer />
</Layout>

<style>
  .products-intro {
    padding-top: calc(var(--space-xxl, 8rem) + var(--header-height, 60px));
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .products-intro h1 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 var(--space-sm);
    text-wrap: balance;
  }

  .products-intro .section-head p {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.5;
    margin-inline: auto;
  }

  @media (max-width: 720px) {
    .products-intro {
      padding-top: calc(var(--space-xl) + var(--header-height, 60px));
    }
  }

  /* Loop connector: four beats of the operational intelligence loop */
  .loop-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(var(--space-md), 3vw, var(--space-lg));
  }

  .loop-step {
    position: relative;
    border-top: 1px solid rgba(15, 23, 42, 0.14);
    padding-top: var(--space-md);
  }

  .loop-step::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--loop-color);
  }

  .loop-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: -4px;
    right: 0;
    width: 7px;
    height: 7px;
    border-top: 1px solid rgba(15, 23, 42, 0.35);
    border-right: 1px solid rgba(15, 23, 42, 0.35);
    transform: rotate(45deg);
  }

  .loop-step-label {
    display: block;
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .loop-step p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .loop-steps {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      max-width: 34rem;
      margin-inline: auto;
    }

    .loop-step {
      border-top: none;
      border-left: 1px solid rgba(15, 23, 42, 0.14);
      padding-top: 0;
      padding-left: var(--space-md);
    }

    .loop-step::before {
      top: 0.3rem;
      left: -5px;
    }

    .loop-step:not(:last-child)::after {
      top: auto;
      bottom: -12px;
      right: auto;
      left: -4px;
      transform: rotate(135deg);
    }
  }

  /* Product detail block */
  .pd-head {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }

  .pd-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .pd-chip::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
  }

  .pd-chip-spacesight::before { background: #FFD23F; }
  .pd-chip-echo::before { background: #00E5FF; }

  .pd-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 var(--space-sm);
    text-wrap: balance;
  }

  .pd-subhead {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
    max-width: 60ch;
    margin-inline: auto;
  }

  .pd-media {
    position: relative;
    max-width: 960px;
    margin: var(--space-lg) auto 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-dark);
    aspect-ratio: 16 / 9;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.12), inset 0 0 0 1px rgba(248, 247, 244, 0.07);
  }

  .pd-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Capabilities: typographic triplet, no imagery */
  .pd-caps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(var(--space-md), 3vw, var(--space-lg));
    margin-top: var(--space-xl);
  }

  .pd-cap {
    position: relative;
    overflow: hidden;
    background: var(--elevated-white, #FFFFFF);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: var(--radius);
    padding: calc(var(--space-md) + 0.25rem) var(--space-md) var(--space-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  /* Orbital detector ring, cropped top-right — signal-colored per product */
  .pd-cap::before {
    content: '';
    position: absolute;
    top: -70px;
    right: -70px;
    width: 170px;
    height: 170px;
    border-radius: 999px;
    border: 1.5px solid var(--cap-ring);
    pointer-events: none;
  }

  .pd-cap::after {
    content: '';
    position: absolute;
    top: -34px;
    right: -34px;
    width: 98px;
    height: 98px;
    border-radius: 999px;
    border: 1px solid var(--cap-ring);
    opacity: 0.55;
    pointer-events: none;
  }

  #spacesight .pd-cap { --cap-ring: rgba(255, 210, 63, 0.5); }
  #echo .pd-cap { --cap-ring: rgba(0, 229, 255, 0.55); }

  .pd-cap:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
    border-color: var(--cap-ring);
  }

  .pd-cap-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .pd-cap-label::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--cap-dot);
  }

  #spacesight .pd-cap-label { --cap-dot: #FFD23F; }
  #echo .pd-cap-label { --cap-dot: #00E5FF; }

  .pd-label-spacesight { color: #8A6D00; }
  .pd-label-echo { color: #0E7490; }

  .pd-cap-slogan {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
    text-wrap: balance;
  }

  .pd-cap p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }

  .pd-cap p:last-child {
    margin-bottom: 0;
  }

  .pd-cta {
    margin-top: var(--space-lg);
    text-align: center;
  }

  @media (max-width: 860px) {
    .pd-caps {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
