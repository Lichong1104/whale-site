---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HardwareSection from '../components/HardwareSection.astro';
import TrustBand from '../components/TrustBand.astro';
import IntegratedPlatformSection from '../components/IntegratedPlatformSection.astro';
import CasesSection from '../components/CasesSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.whale.sg/products/';
const pageDescription = 'Whale products: SpaceSight turns cameras into real-time space intelligence; Echo captures and analyzes frontline voice. One operational intelligence loop.';

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: canonicalUrl }
    ]
  }
];
---

<Layout
  title="Products | Whale AI"
  description={pageDescription}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main>
    <section class="section pd" id="spacesight">
      <div class="container">
        <div class="pd-head">
          <span class="pd-chip pd-chip-spacesight">SpaceSight · Sees</span>
          <h2 class="pd-headline"><span class="wm"><span class="w" style="--i:0">See</span></span> <span class="wm"><span class="w" style="--i:1">what's</span></span> <span class="wm"><span class="w" style="--i:2">actually</span></span> <span class="wm"><span class="w" style="--i:3">happening</span></span> <span class="wm"><span class="w" style="--i:4">—</span></span> <span class="pd-ready"><span class="wm"><span class="w" style="--i:5">before</span></span> <span class="wm"><span class="w" style="--i:6">it</span></span> <span class="wm"><span class="w" style="--i:7">becomes</span></span> <span class="wm"><span class="w" style="--i:8">a</span></span> <span class="wm"><span class="w" style="--i:9">problem.</span></span></span></h2>
          <p class="pd-subhead">SpaceSight turns raw physical-space data into real-time intelligence — built for teams who can't afford blind spots.</p>
        </div>

        <div class="pd-showcase">
          <div class="pd-media">
            <video src="/products/spacesight-demo-eng.mp4" poster="/products/spacesight-demo-poster.jpg" autoplay muted loop controls preload="metadata" playsinline aria-label="SpaceSight product demo"></video>
          </div>

          <div class="pd-carousel" data-carousel>
            <div class="pd-track">
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-spacesight">Automated Detection &amp; Audit</span>
            <h3 class="pd-cap-slogan"><span class="w" style="--i:0">"Catch</span> <span class="w" style="--i:1">everything,</span> <span class="pd-ready"><span class="w" style="--i:2">without</span> <span class="w" style="--i:3">watching</span> <span class="w" style="--i:4">everything."</span></span></h3>
            <p>SpaceSight audits your space continuously, using zero-shot AI detection that works the moment it's deployed — no training data, no setup lag. Just describe what to check in plain English ("check aisle 3 shelves every 90 minutes") and let it run.</p>
            <p>The same detection engine that flags a compliance gap also catches loitering, unauthorized access, or checkout anomalies in real time — so whether you're auditing operations or preventing loss, nothing slips through unnoticed.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-spacesight">SpaceClaw: Ask &amp; Find</span>
            <h3 class="pd-cap-slogan"><span class="w" style="--i:0">"Find</span> <span class="w" style="--i:1">any</span> <span class="w" style="--i:2">moment</span> <span class="pd-ready"><span class="w" style="--i:3">in</span> <span class="w" style="--i:4">seconds,</span></span> <span class="w" style="--i:5">just</span> <span class="w" style="--i:6">by</span> <span class="w" style="--i:7">asking."</span></h3>
            <p>Describe what you're looking for in plain language, and SpaceClaw pulls the exact clip — no scrubbing through hours of footage. Investigating an incident, resolving a dispute, or just confirming what happened at a specific time: what used to take an afternoon now takes seconds.</p>
            <p>And SpaceClaw doesn't just search on command — when it spots something on its own, it can dispatch a task straight to the right person's phone.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-spacesight">Intelligent Reporting</span>
            <h3 class="pd-cap-slogan"><span class="w" style="--i:0">"Your</span> <span class="w" style="--i:1">daily</span> <span class="w" style="--i:2">report,</span> <span class="pd-ready"><span class="w" style="--i:3">ready</span> <span class="w" style="--i:4">before</span> <span class="w" style="--i:5">you</span> <span class="w" style="--i:6">are."</span></span></h3>
            <p>SpaceSight turns what it sees into a clear, structured report — compliance rates, foot traffic, stock levels — delivered automatically, on schedule. No manual compilation, no waiting.</p>
            <p>Beyond the numbers, it recommends what to do next: restock alerts, staffing adjustments, loss-prevention flags — so reports drive action instead of sitting unread in an inbox.</p>
          </article>
            </div>
            <div class="pd-carousel-nav">
              <button type="button" class="pd-arrow" data-prev aria-label="Previous capability">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M10.5 2.5 5 8l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="pd-dots"></div>
              <button type="button" class="pd-arrow" data-next aria-label="Next capability">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5.5 2.5 11 8l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="pd-cta">
          <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="products页Book a demo留资">Book a demo</button>
        </div>
      </div>
    </section>

    <section class="section section-tint pd" id="echo">
      <div class="container">
        <div class="pd-head">
          <span class="pd-chip pd-chip-echo">Echo · Hears</span>
          <h2 class="pd-headline"><span class="wm"><span class="w" style="--i:0">Hear</span></span> <span class="wm"><span class="w" style="--i:1">what</span></span> <span class="wm"><span class="w" style="--i:2">matters</span></span> <span class="wm"><span class="w" style="--i:3">—</span></span> <span class="wm"><span class="w" style="--i:4">and</span></span> <span class="pd-ready"><span class="wm"><span class="w" style="--i:5">never</span></span> <span class="wm"><span class="w" style="--i:6">lose</span></span> <span class="wm"><span class="w" style="--i:7">it</span></span> <span class="wm"><span class="w" style="--i:8">in</span></span> <span class="wm"><span class="w" style="--i:9">the</span></span> <span class="wm"><span class="w" style="--i:10">noise.</span></span></span></h2>
          <p class="pd-subhead">Echo captures and understands the communication behind your operations, feeding straight into our AI for instant, decision-ready insight.</p>
        </div>

        <div class="pd-showcase">
          <div class="pd-media">
            <video src="/products/echo-demo-eng.mp4" poster="/products/echo-demo-poster.jpg" autoplay muted loop controls preload="metadata" playsinline aria-label="Echo product demo"></video>
          </div>

          <div class="pd-carousel" data-carousel>
            <div class="pd-track">
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-echo">Always-On Capture</span>
            <h3 class="pd-cap-slogan"><span class="w" style="--i:0">"Every</span> <span class="w" style="--i:1">conversation,</span> <span class="w" style="--i:2">captured</span> <span class="pd-ready"><span class="w" style="--i:3">without</span> <span class="w" style="--i:4">lifting</span> <span class="w" style="--i:5">a</span> <span class="w" style="--i:6">finger."</span></span></h3>
            <p>Echo wearables (Pin or Buds) capture conversations hands-free, with directional audio that stays clear even in noisy environments. Every interaction is automatically recorded and structured in real time — no manual note-taking, nothing lost.</p>
            <p>With support for 30+ languages and real-time translation, your team can capture and understand conversations wherever business happens, in whatever language it happens in.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-echo">Custom Analytics Engine</span>
            <h3 class="pd-cap-slogan"><span class="w" style="--i:0">"Insight</span> <span class="w" style="--i:1">tuned</span> <span class="w" style="--i:2">to</span> <span class="pd-ready"><span class="w" style="--i:3">how</span> <span class="w" style="--i:4">your</span> <span class="w" style="--i:5">industry</span> <span class="w" style="--i:6">actually</span> <span class="w" style="--i:7">works."</span></span></h3>
            <p>Echo doesn't apply a generic transcript template to every conversation — it analyzes against your industry's own knowledge graph, extracting what matters for healthcare, legal, finance, retail, and 100+ other specialized verticals.</p>
            <p>Configure your own analysis dimensions, or set a persona — like "Senior Sales Coach" — to review every conversation with specialized judgment.</p>
          </article>
          <article class="pd-cap">
            <span class="pd-cap-label pd-label-echo">EchoClaw: Hands-Free Execution</span>
            <h3 class="pd-cap-slogan"><span class="w" style="--i:0">"Say</span> <span class="w" style="--i:1">it</span> <span class="w" style="--i:2">once."</span> <span class="pd-ready"><span class="w" style="--i:3">Consider</span> <span class="w" style="--i:4">it</span> <span class="w" style="--i:5">done."</span></span></h3>
            <p>Echo doesn't stop at understanding — it acts. A single voice command ("send the meeting summary to the client") triggers Echo to handle it automatically, connecting directly to your CRM, ERP, and other tools without manual data entry.</p>
            <p>This is where conversation becomes action — the same execution layer that powers the rest of the AI story across the platform.</p>
          </article>
            </div>
            <div class="pd-carousel-nav">
              <button type="button" class="pd-arrow" data-prev aria-label="Previous capability">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M10.5 2.5 5 8l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="pd-dots"></div>
              <button type="button" class="pd-arrow" data-next aria-label="Next capability">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5.5 2.5 11 8l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="pd-cta">
          <button type="button" class="btn btn-primary btn-large" data-open-modal data-source-type="products页Echo Book a demo留资">Book a demo</button>
        </div>
      </div>
    </section>

    <IntegratedPlatformSection />
    <HardwareSection />
    <TrustBand />
    <CasesSection />

    <CTASection />
  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const track = root.querySelector('.pd-track');
    const slides = track.children.length;
    const dotsWrap = root.querySelector('.pd-dots');
    let index = 0;
    let timer;

    for (let n = 0; n < slides; n++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'pd-dot';
      dot.setAttribute('aria-label', `Go to capability ${n + 1}`);
      dot.addEventListener('click', () => go(n, true));
      dotsWrap.appendChild(dot);
    }
    const dots = [...dotsWrap.children];

    function go(n, manual) {
      index = (n + slides) % slides;
      track.style.transform = `translateX(-${index * 100}%)`;
      [...track.children].forEach((c, k) => c.classList.toggle('is-live', k === index));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === index));
      if (manual) restart();
    }

    function restart() {
      clearInterval(timer);
      timer = setInterval(() => go(index + 1), 6000);
    }

    root.querySelector('[data-prev]').addEventListener('click', () => go(index - 1, true));
    root.querySelector('[data-next]').addEventListener('click', () => go(index + 1, true));
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', restart);

    go(0);
    restart();
  });

  /* Section heads: play the scan-in once when the headline enters view */
  const headObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-live');
        headObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.35 });

  document.querySelectorAll('.pd-head').forEach((head) => headObserver.observe(head));
</script>

<style>
  /* First section now carries the fixed-header offset */
  main > .pd:first-child {
    padding-top: calc(var(--space-xl, 5rem) + var(--header-height, 60px));
  }

  @media (max-width: 720px) {
    main > .pd:first-child {
      padding-top: calc(var(--space-lg, 3rem) + var(--header-height, 60px));
    }
  }

  /* Headline scan-in: words rise out of per-word masks, then a marker sweep
     underlines the payoff clause. Triggered once by IntersectionObserver (.is-live
     on .pd-head); default state fully visible. */
  .pd-head .wm {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em; /* descender room during the rise */
    margin-bottom: -0.12em;
  }

  .pd-head .w {
    display: inline-block;
  }

  .pd-head .pd-ready {
    color: var(--ready-ink, #8A6D00); /* signal hue darkened for ≥3:1 on the marker wash */
    background-image: linear-gradient(to top, var(--ready-mark, rgba(255, 210, 63, 0.4)) 36%, transparent 36%);
    background-repeat: no-repeat;
    background-size: 0% 100%;
  }

  #echo .pd-head .pd-ready {
    --ready-mark: rgba(0, 229, 255, 0.35);
    --ready-ink: #0E7490;
  }

  /* Echo voice: words resolve out of blur — signal settling out of noise */
  #echo .pd-head.is-live .w {
    animation-name: pd-rise-voice;
  }

  @keyframes pd-rise-voice {
    from {
      transform: translateY(110%);
      filter: blur(5px);
    }
  }

  .pd-head.is-live .w {
    animation: pd-rise 0.65s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--i, 0) * 80ms + 60ms);
  }

  .pd-head.is-live .pd-ready {
    transition: background-size 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.95s;
    background-size: 100% 100%;
  }

  .pd-head.is-live .pd-chip {
    animation: pd-word-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .pd-head.is-live .pd-subhead {
    animation: pd-word-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.55s backwards;
  }

  @keyframes pd-rise {
    from {
      transform: translateY(110%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pd-head.is-live .w,
    .pd-head.is-live .pd-chip,
    .pd-head.is-live .pd-subhead {
      animation: none;
    }

    .pd-head.is-live .pd-ready {
      transition: none;
      background-size: 100% 100%;
    }
  }

  /* Product detail block */
  .pd-head {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }

  .pd-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .pd-chip::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
  }

  .pd-chip-spacesight::before { background: #FFD23F; }
  .pd-chip-echo::before { background: #00E5FF; }

  .pd-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 var(--space-sm);
    text-wrap: balance;
  }

  .pd-subhead {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
    max-width: 60ch;
    margin-inline: auto;
  }

  .pd-media {
    position: relative;
    max-width: 960px;
    margin: var(--space-lg) auto 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-dark);
    aspect-ratio: 16 / 9;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.12), inset 0 0 0 1px rgba(248, 247, 244, 0.07);
  }

  .pd-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Showcase: video left, capability carousel right, one row */
  .pd-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(var(--space-md), 3vw, var(--space-lg));
    align-items: stretch;
    margin-top: var(--space-lg);
  }

  .pd-showcase .pd-media {
    margin: 0;
    max-width: none;
    min-width: 0;
    aspect-ratio: auto; /* ratio off in row layout — both axes stretch, video object-fit cover fills */
  }

  .pd-carousel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    padding-top: 4px; /* room for card hover lift */
  }

  .pd-track {
    display: flex;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pd-track .pd-cap {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .pd-carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-top: var(--space-sm);
  }

  .pd-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.16);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .pd-arrow:hover {
    border-color: var(--cap-accent, rgba(15, 23, 42, 0.4));
    background: rgba(15, 23, 42, 0.04);
  }

  .pd-dots {
    display: flex;
    gap: 0.5rem;
  }

  :global(.pd-dot) {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    border: none;
    padding: 0;
    background: rgba(15, 23, 42, 0.18);
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  :global(.pd-dot.is-active) {
    background: var(--cap-accent, var(--text));
    transform: scale(1.35);
  }

  #spacesight .pd-carousel { --cap-dot: #FFD23F; --cap-accent: #B8860B; }
  #echo .pd-carousel { --cap-dot: #00E5FF; --cap-accent: #0E7490; }

  /* Echo: carousel left, video right (desktop); mobile keeps video on top */
  @media (min-width: 861px) {
    #echo .pd-showcase .pd-media { order: 2; }
    #echo .pd-showcase .pd-carousel { order: 1; }
  }

  .pd-cap {
    position: relative;
    overflow: hidden;
    background: var(--elevated-white, #FFFFFF);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: var(--radius);
    padding: calc(var(--space-md) + 0.25rem) var(--space-md) var(--space-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  /* Orbital detector ring, cropped top-right — signal-colored per product */
  .pd-cap::before {
    content: '';
    position: absolute;
    top: -70px;
    right: -70px;
    width: 170px;
    height: 170px;
    border-radius: 999px;
    border: 1.5px solid var(--cap-ring);
    pointer-events: none;
  }

  .pd-cap::after {
    content: '';
    position: absolute;
    top: -34px;
    right: -34px;
    width: 98px;
    height: 98px;
    border-radius: 999px;
    border: 1px solid var(--cap-ring);
    opacity: 0.55;
    pointer-events: none;
  }

  #spacesight .pd-cap { --cap-ring: rgba(255, 210, 63, 0.5); }
  #echo .pd-cap { --cap-ring: rgba(0, 229, 255, 0.55); }

  .pd-cap:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
    border-color: var(--cap-ring);
  }

  .pd-cap-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .pd-cap-label::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--cap-dot);
  }

  #spacesight .pd-cap-label { --cap-dot: #FFD23F; }
  #echo .pd-cap-label { --cap-dot: #00E5FF; }

  .pd-label-spacesight { color: #8A6D00; }
  .pd-label-echo { color: #0E7490; }

  .pd-cap-slogan {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
    text-wrap: balance;
  }

  .pd-cap p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }

  .pd-cap p:last-child {
    margin-bottom: 0;
  }

  /* Slogan compile: words arrive one by one, then a marker sweep underlines the takeaway.
     Triggered by .is-live (set on the active carousel slide); default state fully visible. */
  .pd-cap .w {
    display: inline-block;
  }

  .pd-cap .pd-ready {
    background-image: linear-gradient(to top, var(--ready-mark, rgba(255, 210, 63, 0.45)) 42%, transparent 42%);
    background-repeat: no-repeat;
    background-size: 0% 100%;
  }

  #spacesight .pd-cap { --ready-mark: rgba(255, 210, 63, 0.45); }
  #echo .pd-cap { --ready-mark: rgba(0, 229, 255, 0.32); }

