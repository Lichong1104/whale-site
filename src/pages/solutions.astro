---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.whale.sg/solutions/';
const pageDescription = 'Whale industry solutions: SpaceSight helps fashion, beauty, grocery, restaurants, telecom, and convenience retailers turn in-store activity into actionable insight.';

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.whale.sg/' },
      { '@type': 'ListItem', position: 2, name: 'Solutions', item: canonicalUrl }
    ]
  }
];

const RING = `<circle cx="100" cy="112" r="88" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.22" stroke-dasharray="2 8"/><circle cx="100" cy="112" r="64" fill="none" stroke="currentColor" stroke-width="1" opacity="0.12"/><circle cx="100" cy="24" r="4" fill="currentColor" stroke="none"/>`;

const bulletParts = (b) => {
  const i = b.indexOf(':');
  if (i < 0) return b;
  return `<strong>${b.slice(0, i)}:</strong>${b.slice(i + 1)}`;
};

const industries = [
  {
    id: 'fashion-footwear-offprice',
    short: 'Fashion',
    name: 'Fashion, Footwear, Off-price',
    subtitle: 'The line at the exit registers: wait, walk-aways and registers staffed, by hour',
    summary: 'Checkout queues are where off-price sales are won or lost — but daily totals hide wait times, walk-aways, and register coverage. SpaceSight tracks queue length, wait time, and cashier presence so staffing decisions connect to real checkout flow.',
    bullets: [
      'Respond to growing lines: Get near-real-time alerts when queues exceed a defined threshold.',
      'Review checkout performance: Access hourly wait-time and walk-away reports the next morning.',
      'Connect staffing with results: Compare queue performance, register coverage, and POS transactions by store and hour to assess whether staffing changes improve checkout flow.'
    ],
    accent: 'vision',
    hover: '#1D4ED8',
    track: '#2563EB',
    scene: `<path d="M70 80 h60 v80 h-60 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M85 80 v-20 a15 15 0 0 1 30 0 v20" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="100" cy="125" r="8" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M55 160 h90" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>`,
    imgAlt: 'SpaceSight view of a fashion checkout area — queue length and register coverage tracked over the camera feed'
  },
  {
    id: 'beauty-personal-care',
    short: 'Beauty',
    name: 'Beauty & Personal Care',
    subtitle: 'See which brands and displays draw shoppers in',
    summary: 'Sales data cannot tell you whether a display earns attention or simply benefits from existing brand demand. SpaceSight measures traffic, dwell time, and front-facing engagement so merchants can prove which brand areas and placements actually perform.',
    bullets: [
      'Compare brand areas: See which bays attract passing traffic and encourage shoppers to stop.',
      'Understand time spent: Measure how long shoppers stay near each display and whether they face it.',
      'Evaluate placement changes: Compare engagement before and after layout or display updates to understand what changed.'
    ],
    funnel: 'Passed by → Stopped → Faced the display',
    accent: 'vision',
    hover: '#1D4ED8',
    track: '#2563EB',
    scene: `<rect x="78" y="70" width="44" height="70" rx="8" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="100" cy="92" r="10" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M88 70 v-12 h24 v12" fill="none" stroke="currentColor" stroke-width="3"/>`,
    imgAlt: 'SpaceSight beauty analytics — shopper attention measured at fragrance and skincare displays'
  },
  {
    id: 'grocery-pharmacy',
    short: 'Grocery',
    name: 'Grocery & Pharmacy',
    subtitle: 'Make pharmacy waits visible while protecting customer privacy',
    summary: 'Prescription systems miss the walk-up experience: people waiting at the counter and in seating areas. SpaceSight measures pharmacy queues and wait-area activity with built-in privacy, giving teams evidence to align staffing with real customer demand.',
    bullets: [
      'Respond to growing lines: Receive platform alerts when a queue exceeds an agreed headcount.',
      'Review demand by hour: Access queue-time reports, threshold breaches, and the number of people affected the next morning.',
      'Protect customer privacy: With face blurring enabled and verified for each pharmacy camera, high-clarity faces are blurred on the in-store device before traffic images leave.'
    ],
    note: 'Video stays in the store, and SpaceSight does not connect this analysis to pharmacy systems, prescription records, or loyalty data.',
    accent: 'vision',
    hover: '#1D4ED8',
    track: '#2563EB',
    scene: `<rect x="60" y="90" width="80" height="60" rx="6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M90 105 h20 v15 h15 v20 h-15 v15 h-20 v-15 h-15 v-20 h15 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>`,
    imgAlt: 'SpaceSight pharmacy view — pickup queue and waiting-area activity measured without identifying individuals'
  },
  {
    id: 'restaurants-cafes',
    short: 'Restaurants',
    name: 'Restaurants & Cafés',
    subtitle: 'Keep kitchen standards in view across every location',
    summary: 'Kitchen standards drift between periodic inspections, and everyday issues are easy to miss across multiple locations. SpaceSight runs scheduled visual checks on existing cameras, flagging conditions and routing them to managers before they become routines.',
    bullets: [
      'Check everyday kitchen conditions: Identify visible floor spills or objects, unclean prep counters, open trash bin lids, and back doors left open.',
      'Review staff-area phone use: Flag visible phone use in designated staff-only areas.',
      'Maintain visibility across locations: Review scheduled results in one dashboard to focus follow-up and support consistent routines.'
    ],
    note: 'Hair-covering checks require training on images from your restaurant. Mask-wearing observations are available for information only; handwashing checks require custom development. These visual checks support daily oversight but do not establish food safety or replace inspections.',
    accent: 'vision',
    hover: '#1D4ED8',
    track: '#2563EB',
    scene: `<path d="M70 110 c0-20 60-20 60 0 v40 h-60 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M75 110 c0-15 50-15 50 0" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="115" cy="135" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/>`,
    imgAlt: 'SpaceSight kitchen monitoring — scheduled visual checks flag spills, open bins, and propped doors'
  },
  {
    id: 'telecom-consumer-electronics',
    short: 'Telecom',
    name: 'Telecom & Consumer Electronics',
    subtitle: 'Understand which device displays draw shoppers in',
    summary: 'A strong sell-through number does not separate product demand from prime placement. SpaceSight measures shopper approach, dwell, and attention at each device table so carriers and retailers can value floor space with evidence.',
    bullets: [
      'Compare device tables: See which display areas attract shoppers and encourage them to spend time.',
      'Count shoppers more accurately: Deduplicate repeat approaches so one person returning to a table does not inflate the shopper count.',
      'Inform merchandising decisions: Compare engagement across locations and after placement changes to help assess which displays earn attention.'
    ],
    accent: 'vision',
    hover: '#1D4ED8',
    track: '#2563EB',
    scene: `<rect x="72" y="50" width="56" height="100" rx="8" fill="none" stroke="currentColor" stroke-width="3"/><path d="M82 70 h36" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M82 85 h36 M82 100 h24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
    imgAlt: 'SpaceSight telecom analytics — shopper engagement measured at each device display table'
  },
  {
    id: 'variety-discount-convenience',
    short: 'Variety',
    name: 'Variety, Discount & Convenience',
    subtitle: 'Bring timely visibility to loss prevention',
    summary: 'Loss-prevention teams often review incidents after the fact, making pattern detection slow. SpaceSight detects configured events in real time and lets teams explore them through Vega plain-English search.',
    bullets: [
      'Respond sooner: Receive real-time alerts for configured event types.',
      'Get answers more easily: Use Vega to explore recorded events and calculated metrics through plain-English questions.',
      'Focus follow-up: Use event data to identify recurring patterns and prioritize review across stores.'
    ],
    note: 'Footage search and clip retrieval are available only through an on-premises deployment or a separately contracted configuration.',
    accent: 'vision',
    hover: '#1D4ED8',
    track: '#2563EB',
    scene: `<path d="M100 50 l50 20 v40 c0 35-50 50-50 50s-50-15-50-50 v-40 z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="100" cy="110" r="6" fill="currentColor" stroke="none"/><path d="M100 94 v-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>`,
    imgAlt: 'SpaceSight loss-prevention view — defined events detected in real time and surfaced through Vega search'
  }
];

const headlineWords = [
  { t: 'See', c: 'vision' }, { t: 'it.', c: 'vision' },
  { t: 'Fix', c: 'fusion' }, { t: 'it', c: 'fusion' },
  { t: '—' }, { t: 'before' }, { t: 'it' }, { t: 'becomes' }, { t: 'a' }, { t: 'pattern.' }
];
---

<Layout
  title="Solutions by Industry | Whale AI"
  description={pageDescription}
  canonical={canonicalUrl}
  extraSchema={extraSchema}
>
  <Header />
  <main>
    <section class="section sol-hero" id="solutions">
      <div class="container">
        <h1 class="sol-headline" data-sol-head>
          {headlineWords.slice(0, 2).map((word, i) => (
            <Fragment><span class="wm"><span class={`w${word.c ? ` w-${word.c}` : ''}`} style={`--i:${i}`}>{word.t}</span></span>{' '}</Fragment>
          ))}
          <span class="w-fix">
            {headlineWords.slice(2, 4).map((word, k) => (
              <Fragment><span class="wm"><span class={`w w-${word.c}`} style={`--i:${2 + k}`}>{word.t}</span></span>{' '}</Fragment>
            ))}
            <span class="w-lock-ring" aria-hidden="true"></span>
          </span>
          {headlineWords.slice(4).map((word, i) => (
            <Fragment><span class="wm"><span class={`w${word.c ? ` w-${word.c}` : ''}`} style={`--i:${4 + i}`}>{word.t}</span></span>{' '}</Fragment>
          ))}
        </h1>
        <p class="sol-subhead">Built for how your industry actually runs — Whale adapts to what matters most, from checkout lines to kitchen standards. Here is how.</p>
        <nav class="sol-index" aria-label="Jump to industry">
          {industries.map((ind) => (
            <a href={`#${ind.id}`} class="sol-index-link" style={`--hover: ${ind.hover}; --track: ${ind.track}`}>{ind.short}<span class="sol-index-track" aria-hidden="true" /></a>
          ))}
        </nav>
      </div>
    </section>

    <section class="section sol-reel-section" aria-label="Industry solutions">
      <div class="container">
        <div class="sol-reel" data-reel tabindex="0" role="region" aria-roledescription="carousel" aria-label="Industry solutions — swipe, drag, or use arrow keys">
          {industries.map((ind, i) => (
            <article class="reel-slide" id={ind.id} data-slide={i} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${industries.length}: ${ind.name}`}>
              <div class={`reel-stage scene-${ind.accent}`}>
                <span class="ind-hud ind-hud-name">{ind.name}</span>
                <svg viewBox="0 0 200 200" role="img" aria-label={`${ind.name} illustration`}>
                  <g class="scene-ring" set:html={RING} />
                  <g set:html={ind.scene} />
                </svg>
                <span class="ind-hud ind-hud-prods">SpaceSight</span>
              </div>
              <div class="reel-copy">
                <div class="ind-copy-header">
                  <h2 class="ind-name">{ind.name}</h2>
                  <p class="ind-tagline">{ind.subtitle}</p>
                </div>
                <p class="ind-summary">{ind.summary}</p>
                {ind.bullets?.length > 0 && (
                  <ul class="ind-bullets" aria-label="Key capabilities">
                    {ind.bullets.map((b) => (
                      <li>
                        <span class="ind-bullet-dot" aria-hidden="true">
                          <svg viewBox="0 0 12 12" fill="none"><path d="M2.2 6.3 4.8 8.8 9.8 3.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                        <span class="ind-bullet-text" set:html={bulletParts(b)} />
                      </li>
                    ))}
                  </ul>
                )}
                {ind.funnel && <p class="ind-funnel" aria-label="Engagement funnel">{ind.funnel}</p>}
                {ind.note && <p class="ind-note">{ind.note}</p>}
                <a class="ind-link" href={`/solutions/${ind.id}/`} aria-label={`See how it works for ${ind.name} — industry solution detail`}>
                  See how it works for {ind.name}<span class="ind-link-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="reel-controls">
          <div class="reel-arrows">
            <button type="button" class="reel-arrow" data-prev aria-label="Previous industry">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 L5 8 l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="reel-arrow" data-next aria-label="Next industry">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3 l5 5 -5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <div class="reel-ticks">
            {industries.map((ind, i) => (
              <button type="button" class={`reel-tick${i === 0 ? ' is-active' : ''}`} data-tick={i} aria-label={`Go to ${ind.name}`} aria-current={i === 0 ? 'true' : undefined}>
                <span class="reel-tick-dot" aria-hidden="true"></span>
                <span class="reel-tick-label">{ind.short}</span>
              </button>
            ))}
          </div>
          <span class="reel-counter" data-counter aria-live="polite">01 / {String(industries.length).padStart(2, '0')}</span>
        </div>
      </div>
    </section>

    <CTASection
      headline="Don't see your industry?<br>We probably still do this."
      lead="SpaceSight is built to adapt — if your business runs on physical locations, there is a good chance we already know your pain points."
      primaryLabel="Book a Demo"
    />
  </main>
  <Footer />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .sol-hero {
    padding: calc(var(--header-height) + var(--space-xl)) 0 var(--space-xl);
  }

  .sol-headline {
    max-width: 20ch;
    margin-bottom: var(--space-md);
  }

  .sol-headline .wm {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .sol-headline .w {
    display: inline-block;
  }

  .sol-headline.is-live .w {
    animation: sol-rise 0.65s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--i, 0) * 70ms + 80ms);
  }

  @keyframes sol-rise {
    from { transform: translateY(110%); }
  }

  .sol-headline.is-live .w-vision {
    animation:
      sol-rise 0.65s cubic-bezier(0.16, 1, 0.3, 1) backwards,
      sol-deposit 0.7s ease-out backwards;
    animation-delay:
      calc(var(--i, 0) * 70ms + 80ms),
      calc(var(--i, 0) * 70ms + 430ms);
  }

  @keyframes sol-deposit {
    from {
      color: var(--flash);
      text-shadow: 0 0 16px var(--flash);
    }
    to {
      color: var(--ink);
      text-shadow: 0 0 0 transparent;
    }
  }

  .w-fix {
    position: relative;
    display: inline-block;
  }

  .w-lock-ring {
    position: absolute;
    inset: -0.1em -0.14em -0.1em -0.28em;
    border: 2px solid var(--co-blue);
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
  }

  .sol-headline.is-live .w-lock-ring {
    animation: sol-lockon 1s cubic-bezier(0.16, 1, 0.3, 1) 0.95s backwards;
  }

  @keyframes sol-lockon {
    0%   { transform: scale(1.55); opacity: 0; }
    12%  { opacity: 1; }
    55%  { transform: scale(1); opacity: 1; }
    78%  { transform: scale(1); opacity: 1; }
    100% { transform: scale(0.985); opacity: 0; }
  }

  .w-vision { --ink: var(--co-blue-ink); --flash: #3B82F6; color: var(--ink); }
  .w-fusion { --ink: var(--co-blue-ink); --flash: #2563EB; color: var(--ink); }

  .sol-subhead {
    max-width: 56ch;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* ---------- Industry index ---------- */
  .sol-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: var(--space-md);
  }

  .sol-index-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 0.3rem 0;
    transition: color 0.25s ease;
  }

  .sol-index-link:hover,
  .sol-index-link.is-active {
    color: var(--hover, var(--text));
  }

  .sol-index-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 4px;
    pointer-events: none;
  }

  .sol-index-track::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1px;
    background: var(--track, currentColor);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease-in;
  }

  .sol-index-track::before {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--track, currentColor);
    transform: translateY(-50%) scale(0.3);
    opacity: 0;
    transition:
      opacity 0.1s ease-out,
      transform 0.15s ease-in;
  }

  .sol-index-link:hover .sol-index-track::after,
  .sol-index-link:focus-visible .sol-index-track::after,
  .sol-index-link.is-active .sol-index-track::after {
    transform: scaleX(1);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sol-index-link:hover .sol-index-track::before,
  .sol-index-link:focus-visible .sol-index-track::before {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    transition:
      opacity 0.12s ease-out 0.32s,
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1) 0.32s;
  }

  .sol-index-link.is-active .sol-index-track::before {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .sol-index-link:focus-visible {
    outline: 2px solid var(--track, var(--hover, currentColor));
    outline-offset: 3px;
    border-radius: 1px;
    color: var(--hover, var(--text));
  }

  @media (min-width: 720px) {
    .sol-index {
      gap: 0.35rem 0;
    }

    .sol-index-link + .sol-index-link::before {
      content: '·';
      margin: 0 0.75rem;
      color: rgba(15, 23, 42, 0.3);
    }
  }

  /* ---------- Stage HUD ---------- */
  .ind-hud {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.6);
    pointer-events: none;
  }

  .ind-hud-name {
    top: 0.85rem;
    left: var(--space-sm);
  }

  .ind-hud-prods {
    bottom: 0.85rem;
    right: var(--space-sm);
  }

  .reel-stage svg {
    width: 62%;
    height: auto;
    display: block;
  }

  /* ---------- Horizontal snap reel ---------- */
  .sol-reel-section {
    padding-top: 0;
  }

  .sol-reel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    border-radius: var(--radius);
  }

  .sol-reel::-webkit-scrollbar {
    display: none;
  }

  .sol-reel:focus-visible {
    outline: 3px solid var(--co-blue);
    outline-offset: 3px;
  }

  .reel-copy {
    cursor: text;
  }

  .sol-reel.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .reel-slide {
    min-width: 100%;
    scroll-snap-align: center;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(var(--space-lg), 5vw, var(--space-xxl));
    align-items: start;
    padding: var(--space-sm) 0.25rem;
  }

  .reel-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: 62vh;
    background: var(--bg-dark);
    border: 1px solid rgba(248, 247, 244, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .scene-vision { color: #60A5FA; }

  .scene-ring {
    transform-origin: 100px 112px;
    animation: scene-spin 28s linear infinite;
  }

  @keyframes scene-spin {
    to { transform: rotate(360deg); }
  }

  .reel-copy {
    max-width: 54ch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ind-copy-header {
    margin-bottom: var(--space-sm);
  }

  .ind-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: none;
    margin-bottom: 0.45rem;
  }

  .ind-tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.45;
    color: var(--text-secondary);
    margin: 0;
    text-wrap: balance;
  }

  .ind-summary {
    font-size: clamp(0.95rem, 1.25vw, 1.05rem);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 var(--space-sm);
    max-width: 52ch;
  }

  .ind-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-sm);
    display: grid;
    gap: 0.55rem;
    width: 100%;
  }

  .ind-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .ind-bullet-dot {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 0.12rem;
    border-radius: 50%;
    background: var(--co-blue);
    color: var(--bg);
    display: inline-grid;
    place-items: center;
  }

  .ind-bullet-dot svg {
    width: 10px;
    height: 10px;
  }

  .ind-bullet-text {
    font-size: clamp(0.9rem, 1.15vw, 0.98rem);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .ind-bullet-text :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .ind-funnel {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--co-blue);
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .ind-note {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
    max-width: 54ch;
  }

  .ind-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin-top: 0.25rem;
  }

  .ind-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.22);
  }

  .ind-link-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .ind-link:hover .ind-link-arrow {
    transform: translateX(4px);
  }

  /* ---------- Reel rail ---------- */
  .reel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .reel-arrows {
    display: flex;
    gap: 0.5rem;
  }

  .reel-arrow {
    width: 40px;
    height: 40px;
    display: inline-grid;
    place-items: center;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    box-shadow: inset 0 0 0 2px var(--text);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .reel-arrow svg {
    width: 16px;
    height: 16px;
  }

  .reel-arrow:hover:not(:disabled) {
    background: var(--text);
    color: var(--bg);
  }

  .reel-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .reel-ticks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem;
  }

  .reel-tick {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: none;
    background: transparent;
    padding: 0.55rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .reel-tick-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 2px solid currentColor;
    transition: background 0.2s ease;
  }

  .reel-tick:hover {
    color: var(--text);
  }

  .reel-tick.is-active {
    color: var(--text);
    background: var(--bg-elevated);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.1);
  }

  .reel-tick.is-active .reel-tick-dot {
    background: currentColor;
  }

  .reel-counter {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    min-width: 5.5ch;
    text-align: right;
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 980px) {
    .reel-slide {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      align-items: start;
    }

    .reel-stage {
      aspect-ratio: 16 / 10;
      max-height: none;
    }

    .reel-stage svg {
      width: 52%;
    }

    .ind-link {
      padding: 0.65rem 1.2rem;
    }

    .sol-index-link {
      padding: 1rem 0;
    }

    .reel-arrow {
      width: 44px;
      height: 44px;
    }

    .reel-tick {
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
      padding: 0.55rem;
    }

    .ind-link {
      display: inline-block;
      padding: 0.6rem 0;
    }

    .reel-tick-label {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .reel-controls {
      flex-wrap: wrap;
    }

    .reel-ticks {
      order: 3;
      flex-basis: 100%;
      margin-top: 0.25rem;
    }

    .ind-hud-prods {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sol-headline.is-live .w {
      animation: none;
    }

    .scene-ring {
      animation: none;
    }

    .reel-arrow,
    .reel-tick,
    .reel-tick-dot,
    .ind-link,
    .ind-link-arrow,
    .sol-index-link,
    .sol-index-track::before,
    .sol-index-track::after {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    const head = document.querySelector('[data-sol-head]');
    if (head) {
      requestAnimationFrame(() => head.classList.add('is-live'));
    }

    const reel = document.querySelector('[data-reel]');
    if (!reel) return;

    const slides = Array.from(reel.querySelectorAll('.reel-slide'));
    const ticks = Array.from(document.querySelectorAll('[data-tick]'));
    const indexLinks = Array.from(document.querySelectorAll('.sol-index-link'));
    const prev = document.querySelector('[data-prev]');
    const next = document.querySelector('[data-next]');
    const counter = document.querySelector('[data-counter]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;

    const slideWidth = () => slides[0].getBoundingClientRect().width;

    const update = () => {
      slides.forEach((s, i) => s.toggleAttribute('inert', i !== index));
      ticks.forEach((t, i) => {
        t.classList.toggle('is-active', i === index);
        if (i === index) {
          t.setAttribute('aria-current', 'true');
        } else {
          t.removeAttribute('aria-current');
        }
      });
      indexLinks.forEach((a, i) => {
        a.classList.toggle('is-active', i === index);
        if (i === index) {
          a.setAttribute('aria-current', 'true');
        } else {
          a.removeAttribute('aria-current');
        }
      });
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      if (counter) counter.textContent = String(index + 1).padStart(2, '0') + ' / ' + String(slides.length).padStart(2, '0');
    };

    const go = (i, smooth = true) => {
      index = Math.max(0, Math.min(slides.length - 1, i));
      reel.scrollTo({
        left: index * slideWidth(),
        behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto'
      });
      update();
    };

    let scrollRaf = 0;
    reel.addEventListener('scroll', () => {
      cancelAnimationFrame(scrollRaf);
      scrollRaf = requestAnimationFrame(() => {
        const i = Math.round(reel.scrollLeft / slideWidth());
        if (i !== index) {
          index = Math.max(0, Math.min(slides.length - 1, i));
          update();
        }
      });
    }, { passive: true });

    if (prev) prev.addEventListener('click', () => go(index - 1));
    if (next) next.addEventListener('click', () => go(index + 1));
    ticks.forEach((t, i) => t.addEventListener('click', () => go(i)));

    reel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
      if (e.key === 'Home') { e.preventDefault(); go(0); }
      if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    });

    let dragging = false, dragStartX = 0, dragStartLeft = 0, dragMoved = 0;
    reel.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      if (e.target.closest('.reel-copy')) return;
      dragging = true;
      dragMoved = 0;
      dragStartX = e.clientX;
      dragStartLeft = reel.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - dragStartX;
      dragMoved = Math.max(dragMoved, Math.abs(dx));
      if (dragMoved > 6) reel.classList.add('is-dragging');
      else if (!reel.classList.contains('is-dragging')) return;
      reel.scrollLeft = dragStartLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      const wasDragging = reel.classList.contains('is-dragging');
      reel.classList.remove('is-dragging');
      if (wasDragging) {
        go(Math.round(reel.scrollLeft / slideWidth()));
        reel.addEventListener('click', (ev) => {
          ev.stopPropagation();
          ev.preventDefault();
        }, { capture: true, once: true });
      }
    });

    document.querySelectorAll('.sol-index-link').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href').slice(1);
        const i = slides.findIndex((s) => s.id === id);
        if (i < 0) return;
        e.preventDefault();
        go(i);
        reel.focus({ preventScroll: true });
      });
    });

    update();
  })();
</script>
